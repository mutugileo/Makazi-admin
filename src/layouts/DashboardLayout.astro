---
import '../styles/global.css';
import Sidebar from '../components/dashboard/Sidebar.astro';
import Header from '../components/dashboard/Header.astro';
import OnboardTenantModal from '../components/dashboard/OnboardTenantModal.astro';
import SendRemindersModal from '../components/dashboard/SendRemindersModal.astro';
import ReceiptModal from '../components/dashboard/ReceiptModal.astro';
import CommandPaletteModal from '../components/dashboard/CommandPaletteModal.astro';
import TenantAppModal from '../components/dashboard/TenantAppModal.astro';
import Toast from '../components/dashboard/Toast.astro';
import { getPortfolio } from '../data/portfolio';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  currentPath?: string;
}

// The company's name as stored (live in Supabase mode), not the session's copy.
const user = Astro.locals.user;
const companyName = user ? (await getPortfolio(user.companyId, Astro.cookies)).company.name : 'Makazi';
const {
  title = `Makazi — ${companyName}`,
  currentPath = "/"
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Nunito+Sans:opsz,wght@6..12,300..800&display=swap" 
      rel="stylesheet" 
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={`Makazi property management for ${companyName}`} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <ClientRouter />
    <!-- Restore sidebar collapsed state immediately before paint to prevent layout flash -->
    <script is:inline>
      try {
        if (localStorage.getItem('makazi_sidebar_collapsed') === 'true') {
          document.documentElement.classList.add('sidebar-is-collapsed');
        }
      } catch (e) {}
    </script>
    <!-- Opt in to bar animations only when JS runs and motion is allowed, so
         bars are never left at zero width. -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('bars-ready');
      }
    </script>
  </head>
  <body class="bg-[#F3F4F0] text-[#17231E] min-h-screen antialiased flex">
    <!-- Top Progress Bar for Seamless Route Transitions -->
    <div 
      id="nav-progress-bar" 
      class="fixed top-0 left-0 h-[2.5px] bg-[#C6EE58] z-50 transition-all duration-200 ease-out pointer-events-none opacity-0 w-0 shadow-[0_0_8px_rgba(198,238,88,0.8)]" 
      aria-hidden="true"
    ></div>

    <!-- Desktop & Mobile Sidebar Navigation -->
    <Sidebar currentPath={currentPath} />

    <!-- Main Content Canvas (collapsible desktop padding, zero layout shift) -->
    <div id="dashboard-main-canvas" class="flex-1 flex flex-col min-w-0">
      <!-- Top Sticky Header -->
      <Header />

      <!-- Page View Slot with smooth native crossfade -->
      <main id="main-content" class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto" transition:animate="fade">
        <slot />
      </main>

      <!-- Minimal Dashboard Footer -->
      <footer class="px-6 py-6 border-t border-[#E7EAE4] text-xs text-[#73827C] flex flex-col sm:flex-row items-center justify-between gap-3 max-w-7xl w-full mx-auto">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#134637]"></span>
          <span>Makazi · {companyName}</span>
        </div>
        <div>
          <span>Nairobi, Kenya · East Africa Time (EAT)</span>
        </div>
      </footer>
    </div>

    <!-- Modals & Feedback Elements (persisted across page transitions) -->
    <div id="dashboard-modals-root" transition:persist="modals">
      <OnboardTenantModal />
      <SendRemindersModal />
      <ReceiptModal />
      <CommandPaletteModal />
      <TenantAppModal />
      <Toast />
    </div>

    <!-- Vanilla Interactivity Scripts -->
    <script>
      // Helper function to show/hide modals with animations
      function showModal(modalId: string) {
        const modal = document.getElementById(modalId);
        if (!modal) return;
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100');
        const modalBox = modal.firstElementChild as HTMLElement;
        if (modalBox) {
          modalBox.classList.remove('scale-95');
          modalBox.classList.add('scale-100');
        }
        document.body.style.overflow = 'hidden';
      }

      function hideModal(modalId: string) {
        const modal = document.getElementById(modalId);
        if (!modal) return;
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0', 'pointer-events-none');
        const modalBox = modal.firstElementChild as HTMLElement;
        if (modalBox) {
          modalBox.classList.remove('scale-100');
          modalBox.classList.add('scale-95');
        }
        document.body.style.overflow = '';
      }

      function hideAllModals() {
        ['onboard-tenant-modal', 'send-reminders-modal', 'receipt-modal', 'command-palette-modal', 'tenant-app-modal', 'move-out-modal', 'readings-modal', 'reset-password-modal', 'add-property-modal', 'edit-rates-modal'].forEach(id => {
          hideModal(id);
        });
      }

      // Toast notification trigger
      function showToast(title: string, message: string) {
        const toast = document.getElementById('dashboard-toast');
        const titleEl = document.getElementById('toast-title');
        const msgEl = document.getElementById('toast-message');
        if (!toast || !titleEl || !msgEl) return;

        titleEl.textContent = title;
        msgEl.textContent = message;
        toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
        toast.classList.add('opacity-100', 'translate-y-0');

        setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
        }, 3500);
      }

      window.makaziUi = { showModal, hideModal, showToast };

      // Top navigation progress bar and modal cleanup
      let navProgressTimer: any;
      document.addEventListener('astro:before-preparation', () => {
        hideAllModals();
        const bar = document.getElementById('nav-progress-bar');
        if (bar) {
          bar.style.opacity = '1';
          bar.style.width = '35%';
          clearTimeout(navProgressTimer);
          navProgressTimer = setTimeout(() => {
            bar.style.width = '75%';
          }, 150);
        }
      });

      function initBarsAnimation() {
        const barGroups = document.querySelectorAll<HTMLElement>('[data-animate-bars]');
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('in-view');
                observer.unobserve(entry.target);
              });
            },
            { threshold: 0.25 },
          );
          barGroups.forEach((el) => observer.observe(el));
        } else {
          barGroups.forEach((el) => el.classList.add('in-view'));
        }
      }

      function updateActiveSidebar() {
        const currentPath = window.location.pathname;
        document.querySelectorAll<HTMLAnchorElement>('#app-sidebar a[data-nav-href]').forEach((link) => {
          const href = link.getAttribute('data-nav-href');
          const isActive = (href === '/' && currentPath === '/') || (href !== '/' && currentPath.startsWith(href!));
          const icon = link.querySelector('svg');
          const indicator = link.querySelector('.sidebar-active-indicator');
          if (isActive) {
            link.classList.remove('text-[#93AEA2]', 'hover:bg-[#10342A]/80');
            link.classList.add('bg-gradient-to-r', 'from-[#174639]', 'via-[#143E33]', 'to-[#10352B]', 'text-white', 'shadow-sm', 'border', 'border-[#26634F]/70');
            if (indicator) {
              indicator.classList.remove('opacity-0');
              indicator.classList.add('opacity-100');
            }
            if (icon) {
              icon.classList.remove('text-[#6C8E80]');
              icon.classList.add('text-[#C6EE58]');
            }
          } else {
            link.classList.remove('bg-gradient-to-r', 'from-[#174639]', 'via-[#143E33]', 'to-[#10352B]', 'text-white', 'shadow-sm', 'border', 'border-[#26634F]/70');
            link.classList.add('text-[#93AEA2]', 'hover:bg-[#10342A]/80');
            if (indicator) {
              indicator.classList.remove('opacity-100');
              indicator.classList.add('opacity-0');
            }
            if (icon) {
              icon.classList.remove('text-[#C6EE58]');
              icon.classList.add('text-[#6C8E80]');
            }
          }
        });
      }

      function updateCollapseButtonIcon(isCollapsed: boolean) {
        const openIcon = document.getElementById('collapse-icon-open');
        const closeIcon = document.getElementById('collapse-icon-close');
        if (openIcon && closeIcon) {
          openIcon.classList.toggle('hidden', !isCollapsed);
          closeIcon.classList.toggle('hidden', isCollapsed);
        }
      }

      function toggleSidebarCollapse() {
        const isCollapsed = document.documentElement.classList.toggle('sidebar-is-collapsed');
        try {
          localStorage.setItem('makazi_sidebar_collapsed', isCollapsed ? 'true' : 'false');
        } catch (e) {}
        updateCollapseButtonIcon(isCollapsed);
      }

      function setupPageListeners() {
        const sidebar = document.getElementById('app-sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');

        // Collapsible sidebar toggle (Desktop)
        const collapseBtn = document.getElementById('sidebar-collapse-toggle');
        if (collapseBtn) {
          collapseBtn.onclick = toggleSidebarCollapse;
        }
        updateCollapseButtonIcon(document.documentElement.classList.contains('sidebar-is-collapsed'));

        // Close mobile drawer on route load
        if (sidebar && backdrop && !backdrop.classList.contains('hidden')) {
          sidebar.classList.add('-translate-x-full');
          backdrop.classList.add('hidden');
        }

        // Mobile sidebar toggle
        const mobileToggle = document.getElementById('mobile-sidebar-toggle');
        if (mobileToggle && sidebar && backdrop) {
          mobileToggle.onclick = () => {
            sidebar.classList.remove('-translate-x-full');
            backdrop.classList.remove('hidden');
          };

          backdrop.onclick = () => {
            sidebar.classList.add('-translate-x-full');
            backdrop.classList.add('hidden');
          };
        }

        // Auto-close mobile sidebar when clicking any navigation link
        document.querySelectorAll('#app-sidebar a').forEach((a) => {
          (a as HTMLElement).onclick = () => {
            if (sidebar && backdrop && window.innerWidth < 1024) {
              sidebar.classList.add('-translate-x-full');
              backdrop.classList.add('hidden');
            }
          };
        });

        // Onboard Tenant Modal triggers
        document.querySelectorAll('#onboard-tenant-btn, #new-lease-btn').forEach((btn) => {
          (btn as HTMLElement).onclick = () => showModal('onboard-tenant-modal');
        });
        const closeOnboardBtn = document.getElementById('close-onboard-modal-btn');
        const cancelOnboardBtn = document.getElementById('cancel-onboard-btn');
        if (closeOnboardBtn) closeOnboardBtn.onclick = () => hideModal('onboard-tenant-modal');
        if (cancelOnboardBtn) cancelOnboardBtn.onclick = () => hideModal('onboard-tenant-modal');

        // Send Reminders Modal triggers
        document.querySelectorAll('#send-reminders-header-btn, #send-reminders-action-btn').forEach((btn) => {
          (btn as HTMLElement).onclick = () => showModal('send-reminders-modal');
        });
        const closeRemindersBtn = document.getElementById('close-reminders-modal-btn');
        const cancelRemindersBtn = document.getElementById('cancel-reminders-btn');
        const confirmRemindersBtn = document.getElementById('confirm-send-reminders-btn');
        if (closeRemindersBtn) closeRemindersBtn.onclick = () => hideModal('send-reminders-modal');
        if (cancelRemindersBtn) cancelRemindersBtn.onclick = () => hideModal('send-reminders-modal');
        if (confirmRemindersBtn) {
          confirmRemindersBtn.onclick = () => {
            hideModal('send-reminders-modal');
            showToast('Prototype: reminders not sent', 'SMS and email sending is connected in Phase 2.');
          };
        }

        // Select all arrears checkboxes
        const selectAllArrears = document.getElementById('select-all-arrears') as HTMLInputElement | null;
        const arrearCheckboxes = document.querySelectorAll('.arrear-checkbox') as NodeListOf<HTMLInputElement>;
        if (selectAllArrears && arrearCheckboxes.length > 0) {
          selectAllArrears.onchange = () => {
            arrearCheckboxes.forEach((cb) => { cb.checked = selectAllArrears.checked; });
          };
        }

        // Receipt Modal triggers
        const closeReceiptBtn = document.getElementById('close-receipt-modal-btn');
        const downloadReceiptBtn = document.getElementById('download-receipt-btn');
        const paymentRows = document.querySelectorAll('.payment-row');

        paymentRows.forEach((row) => {
          (row as HTMLElement).onclick = () => {
            const id = row.getAttribute('data-id') || 'RCT-2610-0000';
            const tenant = row.getAttribute('data-tenant') || '';
            const unit = row.getAttribute('data-unit') || '';
            const prop = row.getAttribute('data-property') || '';
            const method = row.getAttribute('data-method') || 'M-Pesa';
            const amount = Number(row.getAttribute('data-amount') || 0);
            const date = row.getAttribute('data-date') || '';
            const time = row.getAttribute('data-time') || '';
            const ref = row.getAttribute('data-ref') || '';
            const forText = row.getAttribute('data-for') || '';

            const idEl = document.getElementById('receipt-modal-id');
            const numberEl = document.getElementById('receipt-modal-number');
            const amtEl = document.getElementById('receipt-modal-amount');
            const tenantEl = document.getElementById('receipt-modal-tenant');
            const unitPropEl = document.getElementById('receipt-modal-unit-prop');
            const methodEl = document.getElementById('receipt-modal-method');
            const refEl = document.getElementById('receipt-modal-ref');
            const dateEl = document.getElementById('receipt-modal-date');
            const forEl = document.getElementById('receipt-modal-for');

            if (idEl) idEl.textContent = id;
            if (numberEl) numberEl.textContent = id;
            if (amtEl) amtEl.textContent = 'KES ' + amount.toLocaleString('en-KE');
            if (tenantEl) tenantEl.textContent = tenant;
            if (unitPropEl) unitPropEl.textContent = `${unit} · ${prop}`;
            if (methodEl) methodEl.textContent = method;
            if (refEl) refEl.textContent = ref;
            if (dateEl) dateEl.textContent = `${date}, ${time}`;
            if (forEl) forEl.textContent = forText;

            showModal('receipt-modal');
          };
        });

        if (closeReceiptBtn) closeReceiptBtn.onclick = () => hideModal('receipt-modal');
        if (downloadReceiptBtn) {
          downloadReceiptBtn.onclick = () => {
            showToast('PDF receipts not available yet', 'Use Print to save a copy for now. PDF download arrives with the database.');
          };
        }

        // Tenant App Preview modal
        const tenantAppBtn = document.getElementById('tenant-app-btn');
        const closeTenantAppBtn = document.getElementById('close-tenant-app-btn');
        const dismissTenantAppBtn = document.getElementById('dismiss-tenant-app-btn');

        if (tenantAppBtn) tenantAppBtn.onclick = () => showModal('tenant-app-modal');
        if (closeTenantAppBtn) closeTenantAppBtn.onclick = () => hideModal('tenant-app-modal');
        if (dismissTenantAppBtn) dismissTenantAppBtn.onclick = () => hideModal('tenant-app-modal');

        // Command Palette ⌘K modal triggers
        const searchTriggerBtn = document.getElementById('search-trigger-btn');
        const closeCommandBtn = document.getElementById('close-command-modal-btn');
        const commandInput = document.getElementById('command-search-input') as HTMLInputElement | null;

        function openCommandPalette() {
          showModal('command-palette-modal');
          setTimeout(() => commandInput?.focus(), 50);
        }

        if (searchTriggerBtn) searchTriggerBtn.onclick = openCommandPalette;
        if (closeCommandBtn) closeCommandBtn.onclick = () => hideModal('command-palette-modal');
      }

      // Page-load handler for initial render and client-side view transitions
      function onPageReady() {
        const bar = document.getElementById('nav-progress-bar');
        if (bar) {
          bar.style.width = '100%';
          setTimeout(() => {
            bar.style.opacity = '0';
            setTimeout(() => {
              bar.style.width = '0%';
            }, 200);
          }, 150);
        }

        initBarsAnimation();
        updateActiveSidebar();
        setupPageListeners();
      }

      document.addEventListener('astro:page-load', onPageReady);
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        onPageReady();
      } else {
        document.addEventListener('DOMContentLoaded', onPageReady);
      }

      // Global Keyboard Shortcuts: ⌘K (Search), ⌘B (Toggle Sidebar), ESC (Close Modals)
      if (!(window as any).__makaziKeydownAttached) {
        (window as any).__makaziKeydownAttached = true;
        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            showModal('command-palette-modal');
            const commandInput = document.getElementById('command-search-input') as HTMLInputElement | null;
            setTimeout(() => commandInput?.focus(), 50);
          }
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'b') {
            e.preventDefault();
            toggleSidebarCollapse();
          }
          if (e.key === 'Escape') {
            hideAllModals();
          }
        });
      }
    </script>
  </body>
</html>
