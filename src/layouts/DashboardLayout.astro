---
import '../styles/global.css';
import Sidebar from '../components/dashboard/Sidebar.astro';
import Header from '../components/dashboard/Header.astro';
import OnboardTenantModal from '../components/dashboard/OnboardTenantModal.astro';
import SendRemindersModal from '../components/dashboard/SendRemindersModal.astro';
import ReceiptModal from '../components/dashboard/ReceiptModal.astro';
import CommandPaletteModal from '../components/dashboard/CommandPaletteModal.astro';
import TenantAppModal from '../components/dashboard/TenantAppModal.astro';
import MakaziAssistantModal from '../components/dashboard/MakaziAssistantModal.astro';
import Toast from '../components/dashboard/Toast.astro';
import { Sparkles } from '@lucide/astro';
import { getPortfolio } from '../data/portfolio';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  currentPath?: string;
}

// The company's name and theme as stored (live in Supabase mode), not the session's copy.
const user = Astro.locals.user;
const portfolio = user ? await getPortfolio(user.companyId, Astro.cookies) : null;
const companyName = portfolio ? portfolio.company.name : 'Makazi';
const companyTheme = portfolio?.company.settings.theme;
function darkenColor(hexColor: string, factor = 0.2): string {
  const cleanHex = hexColor.replace('#', '');
  const r = Math.round((parseInt(cleanHex.substring(0, 2), 16) || 0) * factor);
  const g = Math.round((parseInt(cleanHex.substring(2, 4), 16) || 0) * factor);
  const b = Math.round((parseInt(cleanHex.substring(4, 6), 16) || 0) * factor);
  return '#' + [r, g, b].map(x => Math.min(255, Math.max(0, x)).toString(16).padStart(2, '0')).join('');
}

function isLightColor(hexColor: string): boolean {
  const cleanHex = hexColor.replace('#', '');
  const r = parseInt(cleanHex.substring(0, 2), 16) || 0;
  const g = parseInt(cleanHex.substring(2, 4), 16) || 0;
  const b = parseInt(cleanHex.substring(4, 6), 16) || 0;
  const yiq = (r * 299 + g * 587 + b * 114) / 1000;
  return yiq >= 120;
}

const rawPrimary = companyTheme?.primary ?? '#0D382B';
const rawSidebarBg = companyTheme?.navBg ?? '#0A261F';
const brandAccent = companyTheme?.accent ?? '#C6EE58';
const brandPrimary = isLightColor(rawPrimary) ? darkenColor(rawPrimary, 0.26) : rawPrimary;
const sidebarBg = isLightColor(rawSidebarBg) ? darkenColor(rawSidebarBg, 0.16) : rawSidebarBg;
const onPrimaryColor = '#FFFFFF';
const onAccentColor = '#081B2E';

const {
  title = `Makazi — ${companyName}`,
  currentPath = "/"
} = Astro.props;

// The next page slides in from the side it was reached from (back goes the other way).
const fadeOut = { name: 'makaziFadeOut', duration: '120ms', easing: 'ease-in', fillMode: 'both' };
const slideIn = (name: string) => ({ name, duration: '220ms', easing: 'cubic-bezier(0.2, 0, 0, 1)', fillMode: 'both' });
const pageSlide = {
  forwards: { old: fadeOut, new: slideIn('makaziSlideInFromRight') },
  backwards: { old: fadeOut, new: slideIn('makaziSlideInFromLeft') },
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400..800&display=swap" 
      rel="stylesheet" 
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={`Makazi property management for ${companyName}`} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <ClientRouter />
    <!-- Restore sidebar collapsed state immediately before paint to prevent layout flash -->
    <script is:inline>
      try {
        if (localStorage.getItem('makazi_sidebar_collapsed') === 'true') {
          document.documentElement.classList.add('sidebar-is-collapsed');
        }
      } catch (e) {}
    </script>
    <!-- Opt in to bar animations only when JS runs and motion is allowed, so
         bars are never left at zero width. -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('bars-ready');
      }
    </script>
  </head>
  <body 
    style={`--color-brand-primary: ${brandPrimary}; --color-sidebar-bg: ${sidebarBg}; --color-brand-accent: ${brandAccent};`}
    class="bg-[#F3F4F0] text-[#17231E] min-h-screen antialiased flex"
  >
    <!-- Top Progress Bar & Shimmer for Seamless Route Transitions -->
    <div 
      id="nav-progress-bar" 
      style={`background-color: ${companyTheme?.accent ?? '#C6EE58'}; box-shadow: 0 0 10px ${companyTheme?.accent ?? '#C6EE58'};`}
      class="fixed top-0 left-0 h-[2.5px] z-50 transition-all duration-200 ease-out pointer-events-none opacity-0 w-0" 
      aria-hidden="true"
    ></div>
    <div 
      id="nav-shimmer-bar"
      class="fixed top-0 left-0 right-0 h-[2.5px] z-49 pointer-events-none opacity-0 transition-opacity duration-150 overflow-hidden"
      aria-hidden="true"
    >
      <div class="h-full w-full shimmer"></div>
    </div>

    <!-- Desktop & Mobile Sidebar Navigation -->
    <Sidebar currentPath={currentPath} />

    <!-- Main Content Canvas (collapsible desktop padding, zero layout shift) -->
    <div id="dashboard-main-canvas" class="flex-1 flex flex-col min-w-0">
      <!-- Top Sticky Header -->
      <Header />

      <!-- Page view: slides out the moment a link is clicked, the next page slides in -->
      <main id="main-content" class="flex-1 p-3 sm:p-5 lg:p-6 xl:p-8 max-w-7xl w-full mx-auto" transition:animate={pageSlide}>
        <slot />
      </main>

      <!-- Minimal Dashboard Footer -->
      <footer class="px-6 py-6 border-t border-[#E7EAE4] text-xs text-[#73827C] flex flex-col sm:flex-row items-center justify-between gap-3 max-w-7xl w-full mx-auto">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#134637]"></span>
          <span>Makazi · {companyName}</span>
        </div>
        <div>
          <span>Nairobi, Kenya · East Africa Time (EAT)</span>
        </div>
      </footer>
      <!-- Floating Ask Makazi Quick Trigger Button -->
      <button
        type="button"
        id="floating-assistant-btn"
        aria-label="Ask Makazi Assistant"
        style={`background-color: ${brandPrimary}; color: ${onPrimaryColor}; border-color: ${brandAccent}4D;`}
        class="fixed bottom-6 right-6 z-30 flex items-center gap-2.5 px-4 py-3 rounded-full shadow-xl hover:shadow-2xl border transition-all hover:scale-105 group cursor-pointer"
      >
        <div 
          style={`background-color: ${brandAccent}; color: ${onAccentColor};`}
          class="h-6 w-6 rounded-full flex items-center justify-center font-bold text-xs shadow-xs"
        >
          <Sparkles class="w-3.5 h-3.5 stroke-[2.5]" />
        </div>
        <span class="text-xs font-semibold tracking-wide pr-1" style={`color: ${onPrimaryColor};`}>Ask Makazi</span>
      </button>
    </div>

    <!-- Page modals sit outside <main>: its slide animation's transform would trap
         them in its stacking context, under the sidebar. -->
    <div id="page-modals-root">
      <slot name="modals" />
    </div>

    <!-- Modals & Feedback Elements (persisted across page transitions) -->
    <div id="dashboard-modals-root" transition:persist="modals">
      <OnboardTenantModal />
      <SendRemindersModal />
      <ReceiptModal />
      <CommandPaletteModal />
      <TenantAppModal />
      <MakaziAssistantModal />
      <Toast />
    </div>

    <!-- Vanilla Interactivity Scripts -->
    <script>
      import { setBusy } from '../lib/busy';
      // Modals: every dialog root is `[role="dialog"][aria-modal="true"]` with an id,
      // hidden by `opacity-0 pointer-events-none` (or `hidden`). Opening remembers
      // the opener so focus goes back to it on close.
      const openers = new Map<string, HTMLElement>();
      const FOCUSABLE =
        'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

      function isOpen(el: HTMLElement) {
        return !el.classList.contains('pointer-events-none') && !el.classList.contains('hidden');
      }

      function openDialogs(): HTMLElement[] {
        return [...document.querySelectorAll<HTMLElement>('[role="dialog"][aria-modal="true"]')].filter(isOpen);
      }

      function focusablesIn(el: HTMLElement): HTMLElement[] {
        return [...el.querySelectorAll<HTMLElement>(FOCUSABLE)].filter((f) => f.getClientRects().length > 0);
      }

      function closeMobileDrawer() {
        const sidebar = document.getElementById('app-sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        if (sidebar && backdrop && !backdrop.classList.contains('hidden')) {
          sidebar.classList.add('-translate-x-full');
          backdrop.classList.add('hidden');
        }
      }

      function showModal(modalId: string) {
        const modal = document.getElementById(modalId);
        if (!modal) return;
        closeMobileDrawer();
        const active = document.activeElement as HTMLElement | null;
        if (active && active !== document.body && !modal.contains(active)) openers.set(modalId, active);
        modal.classList.remove('opacity-0', 'pointer-events-none', 'hidden');
        modal.classList.add('opacity-100');
        const modalBox = modal.firstElementChild as HTMLElement;
        if (modalBox) {
          modalBox.classList.remove('scale-95');
          modalBox.classList.add('scale-100');
        }
        document.body.style.overflow = 'hidden';
        // Move focus into the dialog (its card) unless a script already focused a field.
        requestAnimationFrame(() => {
          if (modal.contains(document.activeElement)) return;
          if (modalBox) {
            if (!modalBox.hasAttribute('tabindex')) modalBox.setAttribute('tabindex', '-1');
            modalBox.classList.add('outline-none');
            modalBox.focus({ preventScroll: true });
          }
        });
      }

      function hideModal(modalId: string) {
        const modal = document.getElementById(modalId);
        if (!modal) return;
        const wasOpen = isOpen(modal);
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0', 'pointer-events-none');
        const modalBox = modal.firstElementChild as HTMLElement;
        if (modalBox) {
          modalBox.classList.remove('scale-100');
          modalBox.classList.add('scale-95');
        }
        if (openDialogs().length === 0) document.body.style.overflow = '';
        const opener = openers.get(modalId);
        openers.delete(modalId);
        const focusLost = modal.contains(document.activeElement) || document.activeElement === document.body;
        const openerDialog = opener?.closest<HTMLElement>('[role="dialog"]');
        const openerVisible = !openerDialog || isOpen(openerDialog);
        if (wasOpen && opener?.isConnected && focusLost && openerVisible) opener.focus({ preventScroll: true });
      }

      function hideAllModals() {
        openDialogs().forEach((el) => {
          if (el.id) hideModal(el.id);
        });
      }

      // Toast: tone 'success' (default), 'error' (stays longer) or 'progress'
      // (stays until the next toast replaces it).
      type ToastTone = 'success' | 'error' | 'progress';
      let toastTimer: ReturnType<typeof setTimeout> | undefined;
      function showToast(title: string, message: string, tone: ToastTone = 'success') {
        const toast = document.getElementById('dashboard-toast');
        const titleEl = document.getElementById('toast-title');
        const msgEl = document.getElementById('toast-message');
        if (!toast || !titleEl || !msgEl) return;

        toast.dataset.tone = tone;
        toast.setAttribute('role', tone === 'error' ? 'alert' : 'status');
        toast.setAttribute('aria-live', tone === 'error' ? 'assertive' : 'polite');
        titleEl.textContent = title;
        msgEl.textContent = message;
        toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
        toast.classList.add('opacity-100', 'translate-y-0');

        clearTimeout(toastTimer);
        const hide = () => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
        };
        if (tone === 'progress') {
          // Safety net: never leave a spinner up forever if the caller never follows up.
          toastTimer = setTimeout(hide, 60000);
        } else {
          toastTimer = setTimeout(hide, tone === 'error' ? 6000 : 3500);
        }
      }

      window.makaziUi = { showModal, hideModal, showToast };

      // Top navigation progress bar and modal cleanup
      let navProgressTimer: any;
      document.addEventListener('astro:before-preparation', (event) => {
        hideAllModals();
        // Respond on click, not when the server answers: slide the page away now.
        const main = document.getElementById('main-content');
        if (main) {
          main.dataset.navDirection = (event as Event & { direction?: string }).direction === 'back' ? 'back' : 'forward';
          main.classList.add('is-leaving');
        }
        const bar = document.getElementById('nav-progress-bar');
        if (bar) {
          bar.style.opacity = '1';
          bar.style.width = '35%';
          clearTimeout(navProgressTimer);
          navProgressTimer = setTimeout(() => {
            bar.style.width = '75%';
          }, 150);
        }
      });

      function initBarsAnimation() {
        const barGroups = document.querySelectorAll<HTMLElement>('[data-animate-bars]');
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('in-view');
                observer.unobserve(entry.target);
              });
            },
            { threshold: 0.25 },
          );
          barGroups.forEach((el) => observer.observe(el));
        } else {
          barGroups.forEach((el) => el.classList.add('in-view'));
        }
      }

      function updateActiveSidebar() {
        const currentPath = window.location.pathname;
        document.querySelectorAll<HTMLAnchorElement>('#app-sidebar a[data-nav-href]').forEach((link) => {
          const href = link.getAttribute('data-nav-href');
          const isActive = (href === '/' && currentPath === '/') || (href !== '/' && currentPath.startsWith(href!));
          const icon = link.querySelector('svg');
          const indicator = link.querySelector('.sidebar-active-indicator');
          if (isActive) {
            link.classList.remove('text-[#93AEA2]', 'hover:bg-[#10342A]/80');
            link.classList.add('bg-gradient-to-r', 'from-[#174639]', 'via-[#143E33]', 'to-[#10352B]', 'text-white', 'shadow-sm', 'border', 'border-[#26634F]/70');
            if (indicator) {
              indicator.classList.remove('opacity-0');
              indicator.classList.add('opacity-100');
            }
            if (icon) {
              icon.classList.remove('text-[#6C8E80]');
              icon.classList.add('text-[#C6EE58]');
            }
          } else {
            link.classList.remove('bg-gradient-to-r', 'from-[#174639]', 'via-[#143E33]', 'to-[#10352B]', 'text-white', 'shadow-sm', 'border', 'border-[#26634F]/70');
            link.classList.add('text-[#93AEA2]', 'hover:bg-[#10342A]/80');
            if (indicator) {
              indicator.classList.remove('opacity-100');
              indicator.classList.add('opacity-0');
            }
            if (icon) {
              icon.classList.remove('text-[#C6EE58]');
              icon.classList.add('text-[#6C8E80]');
            }
          }
        });
      }

      function updateCollapseButtonIcon(isCollapsed: boolean) {
        const openIcon = document.getElementById('collapse-icon-open');
        const closeIcon = document.getElementById('collapse-icon-close');
        if (openIcon && closeIcon) {
          openIcon.classList.toggle('hidden', !isCollapsed);
          closeIcon.classList.toggle('hidden', isCollapsed);
        }
      }

      function toggleSidebarCollapse() {
        const isCollapsed = document.documentElement.classList.toggle('sidebar-is-collapsed');
        try {
          localStorage.setItem('makazi_sidebar_collapsed', isCollapsed ? 'true' : 'false');
        } catch (e) {}
        updateCollapseButtonIcon(isCollapsed);
      }

      function setupPageListeners() {
        const sidebar = document.getElementById('app-sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');

        // Collapsible sidebar toggle (Desktop)
        const collapseBtn = document.getElementById('sidebar-collapse-toggle');
        if (collapseBtn) {
          collapseBtn.onclick = toggleSidebarCollapse;
        }
        updateCollapseButtonIcon(document.documentElement.classList.contains('sidebar-is-collapsed'));

        // Close mobile drawer on route load
        if (sidebar && backdrop && !backdrop.classList.contains('hidden')) {
          sidebar.classList.add('-translate-x-full');
          backdrop.classList.add('hidden');
        }

        // Mobile sidebar toggle
        const mobileToggle = document.getElementById('mobile-sidebar-toggle');
        if (mobileToggle && sidebar && backdrop) {
          mobileToggle.onclick = () => {
            sidebar.classList.remove('-translate-x-full');
            backdrop.classList.remove('hidden');
          };

          backdrop.onclick = () => {
            sidebar.classList.add('-translate-x-full');
            backdrop.classList.add('hidden');
          };
        }

        // Auto-close mobile sidebar when clicking any navigation link
        document.querySelectorAll('#app-sidebar a').forEach((a) => {
          (a as HTMLElement).onclick = () => {
            if (sidebar && backdrop && window.innerWidth < 1024) {
              sidebar.classList.add('-translate-x-full');
              backdrop.classList.add('hidden');
            }
          };
        });

        // Onboard Tenant Modal triggers
        document.querySelectorAll('#onboard-tenant-btn, #new-lease-btn').forEach((btn) => {
          (btn as HTMLElement).onclick = () => showModal('onboard-tenant-modal');
        });
        const closeOnboardBtn = document.getElementById('close-onboard-modal-btn');
        const cancelOnboardBtn = document.getElementById('cancel-onboard-btn');
        if (closeOnboardBtn) closeOnboardBtn.onclick = () => hideModal('onboard-tenant-modal');
        if (cancelOnboardBtn) cancelOnboardBtn.onclick = () => hideModal('onboard-tenant-modal');

        // Send Reminders Modal triggers. On the arrears page, ticked rows narrow
        // the send to those tenancies; with none ticked it goes to everyone owing.
        const selectedTenancyIds = () =>
          [...document.querySelectorAll<HTMLInputElement>('.arrear-checkbox:checked')]
            .map((cb) => cb.dataset.tenancy ?? '')
            .filter(Boolean);
        const syncRemindersModal = () => {
          const ids = new Set(selectedTenancyIds());
          const rows = document.querySelectorAll<HTMLElement>('#send-reminders-modal [data-reminder-tenancy]');
          let shown = 0;
          rows.forEach((row) => {
            const on = ids.size === 0 || ids.has(row.dataset.reminderTenancy ?? '');
            row.classList.toggle('hidden', !on);
            if (on) shown++;
          });
          const n = ids.size > 0 ? ids.size : rows.length;
          const label = ids.size > 0 ? `Send reminders to ${n} selected` : `Send reminders to all ${n}`;
          const countEl = document.getElementById('reminders-recipient-count');
          if (countEl) countEl.textContent = String(ids.size > 0 ? shown : rows.length);
          const confirmLabel = document.getElementById('confirm-send-reminders-label');
          if (confirmLabel) confirmLabel.textContent = label;
        };
        document.querySelectorAll('#send-reminders-header-btn, #send-reminders-action-btn').forEach((btn) => {
          (btn as HTMLElement).onclick = () => {
            syncRemindersModal();
            showModal('send-reminders-modal');
          };
        });
        const closeRemindersBtn = document.getElementById('close-reminders-modal-btn');
        const cancelRemindersBtn = document.getElementById('cancel-reminders-btn');
        const confirmRemindersBtn = document.getElementById('confirm-send-reminders-btn');
        if (closeRemindersBtn) closeRemindersBtn.onclick = () => hideModal('send-reminders-modal');
        if (cancelRemindersBtn) cancelRemindersBtn.onclick = () => hideModal('send-reminders-modal');
        if (confirmRemindersBtn) {
          confirmRemindersBtn.onclick = async () => {
            const btn = confirmRemindersBtn as HTMLButtonElement;
            const tenancyIds = selectedTenancyIds();
            const restoreReminders = setBusy(btn, 'Sending…');
            try {
              // Success only once the server has saved the notifications.
              const res = await fetch('/api/send-reminders', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(tenancyIds.length > 0 ? { tenancyIds } : {}),
              });
              const data = await res.json().catch(() => ({}));
              if (!res.ok || data.error) throw new Error(data.error || 'Reminders were not sent. Try again.');
              hideModal('send-reminders-modal');
              const skipped = data.skipped ? ` ${data.skipped} already reminded in the last 24 hours.` : '';
              showToast(
                data.sent ? 'Reminders sent' : 'No reminders sent',
                `${data.sent} tenant${data.sent === 1 ? '' : 's'} notified in the Makazi app.${skipped}`,
              );
            } catch (err: unknown) {
              showToast('Reminders not sent', err instanceof Error ? err.message : String(err), 'error');
            } finally {
              restoreReminders();
            }
          };
        }

        // Receipt Modal triggers
        const closeReceiptBtn = document.getElementById('close-receipt-modal-btn');
        const downloadReceiptBtn = document.getElementById('download-receipt-btn');
        const paymentRows = document.querySelectorAll('.payment-row');

        paymentRows.forEach((row) => {
          (row as HTMLElement).onclick = () => {
            const id = row.getAttribute('data-id') || 'RCT-2610-0000';
            const tenant = row.getAttribute('data-tenant') || '';
            const unit = row.getAttribute('data-unit') || '';
            const prop = row.getAttribute('data-property') || '';
            const method = row.getAttribute('data-method') || 'M-Pesa';
            const amount = Number(row.getAttribute('data-amount') || 0);
            const date = row.getAttribute('data-date') || '';
            const time = row.getAttribute('data-time') || '';
            const ref = row.getAttribute('data-ref') || '';
            const forText = row.getAttribute('data-for') || '';

            const idEl = document.getElementById('receipt-modal-id');
            const numberEl = document.getElementById('receipt-modal-number');
            const amtEl = document.getElementById('receipt-modal-amount');
            const tenantEl = document.getElementById('receipt-modal-tenant');
            const unitPropEl = document.getElementById('receipt-modal-unit-prop');
            const methodEl = document.getElementById('receipt-modal-method');
            const refEl = document.getElementById('receipt-modal-ref');
            const dateEl = document.getElementById('receipt-modal-date');
            const forEl = document.getElementById('receipt-modal-for');

            if (idEl) idEl.textContent = id;
            if (numberEl) numberEl.textContent = id;
            if (amtEl) amtEl.textContent = 'KES ' + amount.toLocaleString('en-KE');
            if (tenantEl) tenantEl.textContent = tenant;
            if (unitPropEl) unitPropEl.textContent = `${unit} · ${prop}`;
            if (methodEl) methodEl.textContent = method;
            if (refEl) refEl.textContent = ref;
            if (dateEl) dateEl.textContent = `${date}, ${time}`;
            if (forEl) forEl.textContent = forText;

            showModal('receipt-modal');
          };
        });

        if (closeReceiptBtn) closeReceiptBtn.onclick = () => hideModal('receipt-modal');
        if (downloadReceiptBtn) {
          downloadReceiptBtn.onclick = () => {
            showToast('PDF receipts not available yet', 'Use Print to save a copy for now. PDF download arrives with the database.');
          };
        }

        // Tenant App Preview modal
        const tenantAppBtn = document.getElementById('tenant-app-btn');
        const closeTenantAppBtn = document.getElementById('close-tenant-app-btn');
        const dismissTenantAppBtn = document.getElementById('dismiss-tenant-app-btn');

        if (tenantAppBtn) tenantAppBtn.onclick = () => showModal('tenant-app-modal');
        if (closeTenantAppBtn) closeTenantAppBtn.onclick = () => hideModal('tenant-app-modal');
        if (dismissTenantAppBtn) dismissTenantAppBtn.onclick = () => hideModal('tenant-app-modal');

        // Command Palette ⌘K modal triggers
        const searchTriggerBtn = document.getElementById('search-trigger-btn');
        const closeCommandBtn = document.getElementById('close-command-modal-btn');
        const commandInput = document.getElementById('command-search-input') as HTMLInputElement | null;

        function openCommandPalette() {
          showModal('command-palette-modal');
          setTimeout(() => commandInput?.focus(), 50);
        }

        if (searchTriggerBtn) searchTriggerBtn.onclick = openCommandPalette;
        if (closeCommandBtn) closeCommandBtn.onclick = () => hideModal('command-palette-modal');

        // Ask Makazi Assistant triggers
        const openAssistantBtn = document.getElementById('open-assistant-btn');
        const floatingAssistantBtn = document.getElementById('floating-assistant-btn');
        const assistantInput = document.getElementById('assistant-chat-input') as HTMLInputElement | null;

        function openAssistant() {
          showModal('makazi-assistant-modal');
          setTimeout(() => assistantInput?.focus(), 50);
        }

        if (openAssistantBtn) openAssistantBtn.onclick = openAssistant;
        if (floatingAssistantBtn) floatingAssistantBtn.onclick = openAssistant;
        const sidebarAssistantBtn = document.getElementById('sidebar-assistant-btn');
        if (sidebarAssistantBtn) sidebarAssistantBtn.onclick = openAssistant;
      }

      // Route Navigation Shimmer Listeners
      document.addEventListener('astro:before-preparation', () => {
        const bar = document.getElementById('nav-progress-bar');
        const shimmer = document.getElementById('nav-shimmer-bar');
        if (bar) {
          bar.style.opacity = '1';
          bar.style.width = '70%';
        }
        if (shimmer) {
          shimmer.style.opacity = '1';
        }
      });

      // The swapped-in page starts clean; also covers a cancelled navigation.
      const clearLeaving = () => document.getElementById('main-content')?.classList.remove('is-leaving');
      document.addEventListener('astro:after-swap', clearLeaving);
      document.addEventListener('astro:page-load', clearLeaving);

      document.addEventListener('astro:after-preparation', () => {
        const bar = document.getElementById('nav-progress-bar');
        if (bar) bar.style.width = '92%';
      });

      // Page-load handler for initial render and client-side view transitions
      function onPageReady() {
        const bar = document.getElementById('nav-progress-bar');
        const shimmer = document.getElementById('nav-shimmer-bar');
        if (bar) {
          bar.style.width = '100%';
          setTimeout(() => {
            bar.style.opacity = '0';
            setTimeout(() => {
              bar.style.width = '0%';
            }, 200);
          }, 150);
        }
        if (shimmer) {
          setTimeout(() => {
            shimmer.style.opacity = '0';
          }, 180);
        }

        initBarsAnimation();
        updateActiveSidebar();
        setupPageListeners();
      }

      document.addEventListener('astro:page-load', onPageReady);
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        onPageReady();
      } else {
        document.addEventListener('DOMContentLoaded', onPageReady);
      }

      // Global Keyboard Shortcuts: ⌘K (Search), ⌘B (Toggle Sidebar), ESC (Close Modals)
      if (!(window as any).__makaziKeydownAttached) {
        (window as any).__makaziKeydownAttached = true;
        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            showModal('command-palette-modal');
            const commandInput = document.getElementById('command-search-input') as HTMLInputElement | null;
            setTimeout(() => commandInput?.focus(), 50);
          }
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'b') {
            e.preventDefault();
            toggleSidebarCollapse();
          }
          if (e.key === 'Escape') {
            // Close only the topmost open dialog.
            const top = openDialogs().pop();
            // A dialog mid-save (aria-busy) stays open until its request ends.
            if (top?.id && top.getAttribute('aria-busy') !== 'true') {
              e.preventDefault();
              hideModal(top.id);
            }
          }
          if (e.key === 'Tab') {
            // Keep keyboard focus inside the open dialog.
            const top = openDialogs().pop();
            if (!top) return;
            const items = focusablesIn(top);
            if (items.length === 0) {
              e.preventDefault();
              return;
            }
            const first = items[0];
            const last = items[items.length - 1];
            const active = document.activeElement as HTMLElement | null;
            if (!active || !top.contains(active)) {
              e.preventDefault();
              (e.shiftKey ? last : first).focus();
            } else if (e.shiftKey && (active === first || active === top.firstElementChild)) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && active === last) {
              e.preventDefault();
              first.focus();
            }
          }
        });
      }
    </script>
  </body>
</html>
