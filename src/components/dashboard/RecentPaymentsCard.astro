---
import { getPortfolio, viewMonthFrom, formatKes } from '../../data/portfolio';
import { paymentMethodLabel } from '../../lib/billing';

// This company's data only (the signed-in user's).
const { payments } = await getPortfolio(Astro.locals.user!.companyId, Astro.cookies, viewMonthFrom(Astro.url));

const recentPayments = payments.slice(0, 5);
---

<div id="payments-section" class="bg-white rounded-3xl p-6 sm:p-7 border border-[#E7EAE4] shadow-sm hover:shadow-md transition-shadow">
  <!-- Card Header -->
  <div class="flex items-center justify-between mb-5 pb-2 border-b border-[#F0F2EE]">
    <h3 class="font-editorial text-2xl sm:text-3xl font-normal text-[#17231E] tracking-tight">
      Recent payments
    </h3>
    <a 
      href="/payments"
      id="view-all-payments-btn" 
      class="text-xs sm:text-sm font-semibold text-[#0D382B] hover:text-[#185340] hover:underline transition-colors cursor-pointer"
    >
      View all
    </a>
  </div>

  <!-- Payments List -->
  {recentPayments.length === 0 && (
    <p class="py-6 text-center text-xs font-medium text-[#73827C]">No payments yet. They appear here as tenants pay.</p>
  )}
  <div class="divide-y divide-[#F2F4EF]">
    {recentPayments.map(({ payment, view, forDescription, dateLabel }) => (
      <div 
        class="payment-row py-3.5 first:pt-1 last:pb-1 flex items-center justify-between group hover:bg-[#F9FAF8] px-2 -mx-2 rounded-xl transition-all cursor-pointer"
        data-id={payment.receiptNumber}
        data-tenant={view.tenant.name}
        data-unit={view.unit.label}
        data-property={view.property.name}
        data-method={paymentMethodLabel(payment)}
        data-amount={payment.amount}
        data-date={dateLabel}
        data-time={payment.time}
        data-ref={payment.reference}
        data-for={forDescription}
      >
        <div class="min-w-0 pr-4">
          <h4 class="text-sm font-semibold text-[#182621] group-hover:text-[#0D382B] transition-colors truncate">
            {view.tenant.name}
          </h4>
          <p class="text-xs text-[#73827C] mt-0.5 truncate">
            {view.unit.label} · {view.property.name} · {paymentMethodLabel(payment)} · {dateLabel}
          </p>
        </div>
        <div class="text-right flex-shrink-0">
          <span class="text-sm sm:text-base font-semibold text-[#17231E] tracking-tight tabular-nums">
            {formatKes(payment.amount)}
          </span>
        </div>
      </div>
    ))}
  </div>
</div>
