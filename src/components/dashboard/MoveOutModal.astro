---
import { X, DoorOpen } from '@lucide/astro';
import { getPortfolio } from '../../data/portfolio';

// This company's data only (the signed-in user's).
const { seed, asOf } = await getPortfolio(Astro.locals.user!.companyId, Astro.cookies);

const retentionMonths = seed.companies[0].settings.recordRetentionMonths;

// Default move-out date: last day of the current month.
const [y, m] = asOf.split('-').map(Number);
const endOfMonth = new Date(Date.UTC(y, m, 0)).toISOString().slice(0, 10);
---

<div
  id="move-out-modal"
  data-retention-months={retentionMonths}
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="move-out-title"
>
  <div class="relative w-full max-w-lg bg-white rounded-3xl shadow-2xl border border-[#E7EAE4] overflow-hidden transform scale-95 transition-transform duration-200">
    <div class="flex items-center justify-between p-6 border-b border-[#F0F2EE]">
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-xl bg-[#FFF1EC] text-[#C04A26] flex items-center justify-center">
          <DoorOpen class="w-5 h-5" />
        </div>
        <div>
          <h3 id="move-out-title" class="font-editorial text-2xl font-normal text-[#17231E]">
            Move out <span data-field="name"></span>
          </h3>
          <p class="text-xs text-[#73827C]" data-field="unit"></p>
        </div>
      </div>
      <button type="button" data-close class="h-8 w-8 rounded-full bg-[#F4F5F1] text-[#73827C] hover:text-[#17231E] flex items-center justify-center transition-colors cursor-pointer" aria-label="Close">
        <X class="w-4 h-4" />
      </button>
    </div>

    <form id="move-out-form" class="p-6 space-y-5 max-h-[75vh] overflow-y-auto" novalidate>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="move-out-date" class="block text-xs font-semibold uppercase tracking-wider text-[#5A6862] mb-1.5">Move-out date</label>
          <input type="date" id="move-out-date" required value={endOfMonth}
            class="w-full px-4 py-2.5 rounded-xl border border-[#DCE0D7] focus:border-[#0D382B] focus:ring-2 focus:ring-[#0D382B]/10 outline-none text-sm text-[#17231E] bg-white" />
        </div>
        <div>
          <label for="move-out-reading" class="block text-xs font-semibold uppercase tracking-wider text-[#5A6862] mb-1.5">Final meter reading</label>
          <input type="number" id="move-out-reading" required inputmode="numeric" min="0" step="1"
            class="w-full px-4 py-2.5 rounded-xl border border-[#DCE0D7] focus:border-[#0D382B] focus:ring-2 focus:ring-[#0D382B]/10 outline-none text-sm text-[#17231E] tabular-nums" />
          <p class="text-[11px] text-[#73827C] mt-1">Last reading <span data-field="last-reading" class="tabular-nums"></span></p>
          <p class="text-[11px] text-[#C04A26] mt-1 hidden" data-field="reading-error">Must be at least the last reading.</p>
        </div>
      </div>

      <!-- Settlement preview, recalculated as the reading changes -->
      <div class="rounded-2xl bg-[#F8F9F7] border border-[#E7EAE4] p-4 text-sm tabular-nums">
        <p class="text-xs font-semibold uppercase tracking-wider text-[#5A6862] mb-3">Final bill preview</p>
        <div class="space-y-2">
          <div class="flex justify-between"><span class="text-[#73827C]">Balance now</span><span data-field="balance" class="font-medium text-[#17231E]"></span></div>
          <div class="flex justify-between"><span class="text-[#73827C]">Final water <span data-field="water-detail" class="text-[11px]"></span></span><span data-field="water" class="font-medium text-[#17231E]"></span></div>
          <div class="flex justify-between"><span class="text-[#73827C]">Deposit applied</span><span data-field="deposit" class="font-medium text-[#17231E]"></span></div>
          <div class="flex justify-between pt-2 border-t border-[#E7EAE4]">
            <span data-field="result-label" class="font-semibold text-[#17231E]"></span>
            <span data-field="result" class="font-bold"></span>
          </div>
        </div>
      </div>

      <div>
        <label for="move-out-note" class="block text-xs font-semibold uppercase tracking-wider text-[#5A6862] mb-1.5">
          Note <span class="normal-case font-normal">(optional, internal)</span>
        </label>
        <textarea id="move-out-note" rows="2" placeholder="e.g. Keys returned, unit in good condition"
          class="w-full px-4 py-2.5 rounded-xl border border-[#DCE0D7] focus:border-[#0D382B] focus:ring-2 focus:ring-[#0D382B]/10 outline-none text-sm text-[#17231E]"></textarea>
      </div>

      <p class="text-xs text-[#73827C] leading-relaxed">
        The unit is marked <strong class="text-[#17231E]">Vacant</strong> and <span data-field="name"></span> moves to Former tenants.
        Their bills and receipts are kept until <strong class="text-[#17231E]" data-field="kept-until"></strong>
        ({retentionMonths} months after move-out) so you can issue a payment statement, then archived.
      </p>

      <div class="pt-4 flex items-center justify-end gap-3 border-t border-[#F0F2EE]">
        <button type="button" data-close class="px-5 py-2.5 rounded-xl text-sm font-medium text-[#5A6862] hover:bg-[#F4F5F1] transition-colors cursor-pointer">Cancel</button>
        <button type="submit" class="px-6 py-2.5 rounded-xl text-sm font-semibold bg-[#C04A26] text-white hover:bg-[#A93C1C] transition-all shadow-md cursor-pointer">Confirm move-out</button>
      </div>
    </form>
  </div>
</div>

<script>
  function initMoveOutModal() {
    const modal = document.getElementById('move-out-modal');
    if (!modal) return;
    const form = document.getElementById('move-out-form') as HTMLFormElement | null;
    const readingInput = document.getElementById('move-out-reading') as HTMLInputElement | null;
    const dateInput = document.getElementById('move-out-date') as HTMLInputElement | null;
    if (!form || !readingInput || !dateInput) return;

    const kes = (n: number) => `${n < 0 ? '−' : ''}KES ${Math.abs(n).toLocaleString('en-KE')}`;
    const setText = (field: string, text: string) =>
      modal.querySelectorAll(`[data-field="${field}"]`).forEach((el) => (el.textContent = text));

    let current = { tenancyId: '', name: '', balance: 0, deposit: 0, rate: 0, lastReading: 0 };
    const retentionMonths = Number(modal.dataset.retentionMonths) || 0;
    const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

    function keptUntil(iso: string): string {
      if (!iso) return '—';
      const [y, m, d] = iso.split('-').map(Number);
      const index = y * 12 + (m - 1) + retentionMonths;
      const year = Math.floor(index / 12);
      const month = index % 12;
      const last = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
      return `${String(Math.min(d, last)).padStart(2, '0')} ${MONTHS[month]} ${year}`;
    }

    function recalc() {
      setText('kept-until', keptUntil(dateInput.value));
      const reading = Number(readingInput.value);
      const valid = readingInput.value !== '' && Number.isInteger(reading) && reading >= current.lastReading;
      modal.querySelector('[data-field="reading-error"]')?.classList.toggle('hidden', valid || readingInput.value === '');
      const units = valid ? reading - current.lastReading : 0;
      const water = units * current.rate;
      const result = current.balance + water - current.deposit;
      setText('balance', kes(current.balance));
      setText('water', kes(water));
      setText('water-detail', valid ? `(${units} units × KES ${current.rate})` : '');
      setText('deposit', kes(-current.deposit));
      setText('result-label', result > 0 ? 'Tenant still owes' : 'Refund to tenant');
      setText('result', kes(Math.abs(result)));
      const resultEl = modal.querySelector('[data-field="result"]');
      if (resultEl) {
        resultEl.classList.toggle('text-[#C04A26]', result > 0);
        resultEl.classList.toggle('text-[#2E7D32]', result <= 0);
      }
      return valid;
    }

    document.querySelectorAll<HTMLButtonElement>('.move-out-btn').forEach((btn) => {
      btn.onclick = () => {
        const d = btn.dataset;
        current = {
          tenancyId: d.tenancy ?? '',
          name: d.name ?? '',
          balance: Number(d.balance),
          deposit: Number(d.deposit),
          rate: Number(d.waterRate),
          lastReading: Number(d.lastReading),
        };
        form.reset();
        readingInput.min = String(current.lastReading);
        readingInput.placeholder = String(current.lastReading);
        setText('name', current.name);
        setText('unit', d.unit ?? '');
        setText('last-reading', current.lastReading.toLocaleString('en-KE'));
        recalc();
        window.makaziUi?.showModal('move-out-modal');
      };
    });

    readingInput.oninput = recalc;
    dateInput.oninput = recalc;
    modal.querySelectorAll('[data-close]').forEach((el) => {
      (el as HTMLElement).onclick = () => window.makaziUi?.hideModal('move-out-modal');
    });

    form.onsubmit = async (e) => {
      e.preventDefault();
      if (!recalc()) {
        modal.querySelector('[data-field="reading-error"]')?.classList.remove('hidden');
        readingInput.focus();
        return;
      }

      const moveOutDate = dateInput.value;
      const finalReading = Number(readingInput.value);
      const note = (modal.querySelector('[data-field="note"]') as HTMLInputElement | null)?.value ?? '';

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving...';
      }

      try {
        const res = await fetch('/api/move-out', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            tenancyId: current.tenancyId,
            moveOutDate,
            finalReading,
            note,
          }),
        });
        const data = await res.json();
        if (!res.ok || data.error) throw new Error(data.error || 'Failed to record move-out');

        window.makaziUi?.hideModal('move-out-modal');
        window.makaziUi?.showToast('Move-out recorded', `${current.name} has been moved out.`);
        setTimeout(() => window.location.reload(), 1000);
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : String(err);
        window.makaziUi?.showToast('Error', msg);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Confirm move-out';
        }
      }
    };
  }

  document.addEventListener('astro:page-load', initMoveOutModal);
</script>
