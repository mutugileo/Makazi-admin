---
import { getPortfolio, viewMonthFrom, formatKes } from '../../data/portfolio';

// This company's data only (the signed-in user's).
const { company, stats, sixMonthsHistory, isPastMonth, currentMonth } = await getPortfolio(Astro.locals.user!.companyId, Astro.cookies, viewMonthFrom(Astro.url));

const theme = company.settings?.theme;

function darkenColor(hexColor: string, factor = 0.2): string {
  const cleanHex = hexColor.replace('#', '');
  const r = Math.round((parseInt(cleanHex.substring(0, 2), 16) || 0) * factor);
  const g = Math.round((parseInt(cleanHex.substring(2, 4), 16) || 0) * factor);
  const b = Math.round((parseInt(cleanHex.substring(4, 6), 16) || 0) * factor);
  return '#' + [r, g, b].map(x => Math.min(255, Math.max(0, x)).toString(16).padStart(2, '0')).join('');
}

function isLightColor(hexColor: string): boolean {
  const cleanHex = hexColor.replace('#', '');
  const r = parseInt(cleanHex.substring(0, 2), 16) || 0;
  const g = parseInt(cleanHex.substring(2, 4), 16) || 0;
  const b = parseInt(cleanHex.substring(4, 6), 16) || 0;
  const yiq = (r * 299 + g * 587 + b * 114) / 1000;
  return yiq >= 120;
}

const rawPrimary = theme?.primary || '#0D382B';
const rawSidebarBg = theme?.navBg || '#0A261F';
const brandAccent = theme?.accent || '#C6EE58';
const brandPrimary = isLightColor(rawPrimary) ? darkenColor(rawPrimary, 0.26) : rawPrimary;
const sidebarBg = isLightColor(rawSidebarBg) ? darkenColor(rawSidebarBg, 0.16) : rawSidebarBg;

// Bars are scaled against the largest month billed. Labels switch to
// thousands when the portfolio bills under a million a month.
const maxExpected = Math.max(1, ...sixMonthsHistory.map((m) => m.expected));
const unit = maxExpected >= 1_000_000 ? { div: 1_000_000, label: 'KES M', digits: 2 } : { div: 1_000, label: "KES '000", digits: 0 };
const maxBarValue = Math.max(1, maxExpected / unit.div);
// "this month", or "in September" when the overview is set to an earlier month.
const monthName = new Date(`${currentMonth}-01T00:00:00Z`).toLocaleString('en-GB', { month: 'long', timeZone: 'UTC' });
const inMonth = isPastMonth ? `in ${monthName}` : 'this month';
---

<div 
  data-animate-bars 
  style={`background: linear-gradient(135deg, ${brandPrimary} 0%, ${sidebarBg} 100%); border-color: rgba(255,255,255,0.12);`}
  class="relative overflow-hidden rounded-3xl text-white p-7 lg:p-8 shadow-xl border transition-all duration-300"
>
  <!-- Subtle decorative ambient wave/rings matching high-fidelity screenshot -->
  <div 
    style={`background-color: ${brandAccent}1A;`}
    class="pointer-events-none absolute -right-20 -top-20 h-96 w-96 rounded-full blur-3xl"
  ></div>
  <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-15" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
    <path d="M0,80 Q250,20 500,70 T1000,50 L1000,0 L0,0 Z" fill={brandAccent}></path>
    <path d="M0,140 Q300,70 600,120 T1200,90 L1200,0 L0,0 Z" fill="rgba(255, 255, 255, 0.05)"></path>
  </svg>

  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
    <!-- Left Hero Metrics -->
    <div class="lg:col-span-7 flex flex-col justify-between">
      <div>
        <span class="text-xs font-semibold tracking-widest uppercase opacity-95" style={`color: ${brandAccent};`}>
          COLLECTED {inMonth.toUpperCase()}
        </span>
        <h2 class="font-editorial text-4xl sm:text-5xl lg:text-6xl font-normal tracking-tight text-white mt-3 mb-2">
          {formatKes(stats.collectedThisMonth)}
        </h2>
        <p class="text-sm text-white/80 font-medium">
          {stats.expectedThisMonth === 0
            ? (isPastMonth ? `No bills issued ${inMonth}` : 'No bills issued this month yet')
            : <>of {formatKes(stats.expectedThisMonth)} billed (rent, water, garbage) · <span class="text-white font-semibold">{stats.collectionRate}%</span></>}
        </p>
        {stats.depositsThisMonth > 0 && (
          <p class="text-xs text-white/70 mt-1">
            Excludes {formatKes(stats.depositsThisMonth)} in new deposits, held separately
          </p>
        )}

        <!-- Progress Bar -->
        <div class="w-full bg-white/15 h-2 rounded-full mt-4 overflow-hidden p-0.5">
          <div 
            class="bar-x h-full rounded-full"
            style={`width: ${Math.min(stats.collectionRate, 100)}%; --bar-delay: 150ms; background-color: ${brandAccent}; box-shadow: 0 0 10px ${brandAccent}66;`}
          ></div>
        </div>
      </div>

      <!-- Payment Source Breakdown -->
      <div class="flex flex-wrap items-center gap-6 mt-7 pt-4 border-t border-white/15 text-xs sm:text-sm">
        <div class="flex items-center gap-2 group cursor-pointer transition-transform hover:translate-x-0.5">
          <span 
            style={`background-color: ${brandAccent}; box-shadow: 0 0 0 4px ${brandAccent}33;`}
            class="h-2 w-2 rounded-full"
          ></span>
          <span class="text-white/80">M-Pesa</span>
          <span class="font-semibold text-white tracking-wide">{formatKes(stats.mpesaTotal)}</span>
        </div>
        <div class="flex items-center gap-2 group cursor-pointer transition-transform hover:translate-x-0.5">
          <span class="h-2 w-2 rounded-full bg-white/70 ring-4 ring-white/20"></span>
          <span class="text-white/80">Bank</span>
          <span class="font-semibold text-white tracking-wide">{formatKes(stats.bankTotal)}</span>
        </div>
      </div>
    </div>

    <!-- Right Bar Chart -->
    <div 
      style="background-color: rgba(0, 0, 0, 0.22); border-color: rgba(255, 255, 255, 0.12);"
      class="lg:col-span-5 rounded-2xl p-5 border backdrop-blur-sm"
    >
      <div class="flex items-center justify-between text-xs text-white/80 mb-5">
        <span class="font-medium tracking-wide">Last 6 months</span>
        <span class="font-semibold tracking-wider text-white/70">{unit.label}</span>
      </div>

      <!-- Interactive Chart Columns -->
      <div class="grid grid-cols-6 gap-2 sm:gap-3 items-end h-44 pb-2 px-1">
        {sixMonthsHistory.map((item, i) => {
          const amount = item.collected / unit.div;
          const heightPercent = Math.round((amount / maxBarValue) * 100);
          return (
            <div class="group relative flex flex-col items-center justify-end h-full">
              <!-- Floating Tooltip on Hover -->
              <div 
                style={`background-color: ${sidebarBg}; border-color: ${brandAccent}40;`}
                class="absolute -top-12 opacity-0 group-hover:opacity-100 group-hover:-top-14 transition-all duration-200 pointer-events-none z-30 text-white text-[11px] font-medium py-1.5 px-2.5 rounded-lg shadow-xl border whitespace-nowrap"
              >
                <span class="font-bold" style={`color: ${brandAccent};`}>{item.label}</span>: {formatKes(item.collected)} ({item.rate}%)
                <div class="absolute left-1/2 -bottom-1 -translate-x-1/2 border-4 border-transparent border-t-black/60"></div>
              </div>

              <!-- Top Value Label -->
              <span 
                style={item.isCurrent ? `color: ${brandAccent};` : ''}
                class={`text-[11px] mb-1 transition-colors ${item.isCurrent ? 'font-bold' : 'text-white/70 group-hover:text-white font-medium'}`}
              >
                {amount.toFixed(unit.digits)}
              </span>

              <!-- Bar Pillar -->
              <div class="w-full bg-white/10 rounded-t-md overflow-hidden flex items-end h-32 p-0.5">
                <div
                  class="bar-y w-full rounded-t-sm transition-[filter,background-color] duration-200 group-hover:brightness-110 cursor-pointer"
                  style={`height: ${heightPercent}%; --bar-delay: ${250 + i * 90}ms; ${
                    item.isCurrent 
                      ? `background-color: ${brandAccent}; box-shadow: 0 0 12px ${brandAccent}60;` 
                      : 'background-color: rgba(255, 255, 255, 0.25);'
                  }`}
                ></div>
              </div>

              <!-- Bottom Month Label -->
              <span class={`text-[11px] mt-2 tracking-tight ${item.isCurrent ? 'text-white font-bold' : 'text-white/70 font-medium'}`}>
                {item.month}
              </span>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</div>
