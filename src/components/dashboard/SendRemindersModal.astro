---
import { X, Send } from '@lucide/astro';
import { getPortfolio, formatKes } from '../../data/portfolio';
import { paymentReminder } from '../../lib/reminders';

// This company's data only (the signed-in user's).
const { arrears, company, lateLabel, asOf } = await getPortfolio(Astro.locals.user!.companyId, Astro.cookies);

const totalArrears = arrears.reduce((acc, t) => acc + t.balance, 0);
const sample = arrears[0];
// Exactly what the tenant will see (the server builds the same text).
const preview = sample
  ? paymentReminder({
      tenantName: sample.tenant.name,
      balance: sample.balance,
      accountNumber: sample.accountNumber,
      companyName: company.name,
      mpesaPaybill: company.mpesaPaybill,
      graceDay: company.settings.graceDay,
      asOf,
    })
  : null;
const disabledChannel =
  'flex items-center gap-2 p-3 rounded-xl border border-[#E7EAE4] bg-[#F7F8F5] cursor-not-allowed text-xs font-medium text-[#A8B3AE]';
---

<div 
  id="send-reminders-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reminders-modal-title"
>
  <div class="relative w-full max-w-lg bg-white rounded-3xl shadow-2xl border border-[#E7EAE4] overflow-hidden transform scale-95 transition-transform duration-200">
    <!-- Header -->
    <div class="flex items-center justify-between p-6 border-b border-[#F0F2EE]">
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-xl bg-[#FFF1EC] text-[#C04A26] flex items-center justify-center">
          <Send class="w-5 h-5" />
        </div>
        <div>
          <h3 id="reminders-modal-title" class="font-editorial text-2xl font-normal text-[#17231E]">
            Send payment reminders
          </h3>
          <p class="text-xs text-[#73827C]">{arrears.length} tenant{arrears.length === 1 ? '' : 's'} with a balance · Total {formatKes(totalArrears)}</p>
        </div>
      </div>
      <button 
        type="button" 
        id="close-reminders-modal-btn"
        class="h-8 w-8 rounded-full bg-[#F4F5F1] text-[#73827C] hover:text-[#17231E] flex items-center justify-center transition-colors cursor-pointer"
        aria-label="Close modal"
      >
        <X class="w-4 h-4" />
      </button>
    </div>

    <!-- Content -->
    <div class="p-6 space-y-5 max-h-[75vh] overflow-y-auto">
      <!-- Target Tenants Summary -->
      <div class="space-y-2">
        <label class="block text-xs font-semibold uppercase tracking-wider text-[#5A6862]">
          Recipients ({arrears.length})
        </label>
        <div class="bg-[#F8F9F7] rounded-2xl p-3 border border-[#E7EAE4] divide-y divide-[#EAECE6] text-xs">
          {arrears.map(t => (
            <div class="py-2 first:pt-1 last:pb-1 flex items-center justify-between gap-3">
              <div class="min-w-0">
                <span class="font-semibold text-[#17231E]">{t.tenant.name}</span>
                <span class="text-[#73827C]"> ({t.unitLabel} · {lateLabel(t)})</span>
              </div>
              <span class="font-semibold text-[#C04A26] tabular-nums whitespace-nowrap">{formatKes(t.balance)}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Channel Selection -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-[#5A6862] mb-2">
          Dispatch Channels
        </label>
        <div class="grid grid-cols-3 gap-3">
          <label class={disabledChannel} title="Not available">
            <input type="checkbox" disabled class="rounded focus:ring-0" />
            <span>SMS Alert</span>
          </label>
          <label class={disabledChannel} title="Not available">
            <input type="checkbox" disabled class="rounded focus:ring-0" />
            <span>Email</span>
          </label>
          <label class="flex items-center gap-2 p-3 rounded-xl border border-[#0D382B] bg-[#0D382B]/5 text-xs font-semibold text-[#0D382B]">
            <input type="checkbox" checked disabled class="rounded accent-[#0D382B] focus:ring-0" />
            <span>In-App Push</span>
          </label>
        </div>
        <p class="text-[11px] text-[#73827C] mt-2">
          Shows as a notification in each tenant's Makazi app, at no cost. SMS and email aren't available.
          Anyone reminded in the last 24 hours is skipped.
        </p>
      </div>

      <!-- Message Preview -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-[#5A6862] mb-1.5">
          Notification preview{sample && ` (${sample.tenant.name})`}
        </label>
        <div class="p-3.5 bg-[#FAFBF9] rounded-xl border border-[#E2E5DF] text-xs text-[#2C3B34] leading-relaxed">
          {preview ? (
            <>
              <span class="block font-semibold text-[#17231E] mb-1">{preview.title}</span>
              {preview.body}
            </>
          ) : 'Nobody owes anything right now.'}
        </div>
      </div>

      <!-- Actions -->
      <div class="pt-3 flex items-center justify-end gap-3 border-t border-[#F0F2EE]">
        <button 
          type="button" 
          id="cancel-reminders-btn"
          class="px-5 py-2.5 rounded-xl text-sm font-medium text-[#5A6862] hover:bg-[#F4F5F1] transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button 
          type="button" 
          id="confirm-send-reminders-btn"
          disabled={arrears.length === 0}
          class="px-6 py-2.5 rounded-xl text-sm font-semibold bg-[#C04A26] text-white hover:bg-[#A93C1C] transition-all shadow-md hover:shadow-lg cursor-pointer flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span>Send {arrears.length} reminder{arrears.length === 1 ? '' : 's'}</span>
        </button>
      </div>
    </div>
  </div>
</div>
