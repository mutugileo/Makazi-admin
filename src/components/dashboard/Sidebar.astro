---
import { 
  LayoutGrid, 
  Building2, 
  Users, 
  FileText, 
  CreditCard,
  ReceiptText, 
  AlertTriangle, 
  Wrench, 
  MessageSquare, 
  BarChart2,
  Settings, 
  LogOut,
  PanelLeftClose,
  PanelLeftOpen,
  ExternalLink,
  Sparkles,
  KeyRound,
  PhoneCall
} from '@lucide/astro';
import { getPortfolio } from '../../data/portfolio';
import { FEATURES } from '../../config/features';
import { countPendingClaims } from '../../lib/payment-claims';
import { makeSupabaseClient } from '../../lib/supabase';

// This company's data only (the signed-in user's).
const { company, repairStats, stats, unreadThreadCount } = await getPortfolio(Astro.locals.user!.companyId, Astro.cookies);

// Payment messages waiting for review. A hint only: unreadable means no badge.
let pendingClaimsCount = 0;
const claimsClient = makeSupabaseClient(Astro.cookies);
if (claimsClient) {
  try {
    pendingClaimsCount = await countPendingClaims(claimsClient, Astro.locals.user!.companyId);
  } catch (err) {
    console.error('[sidebar] payment messages count not loaded:', err);
  }
}

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const user = Astro.locals.user;
const adminName = user?.name ?? 'Admin';
const adminRole = user?.role === 'owner' ? 'Owner' : 'Staff';
const adminInitials = adminName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0].toUpperCase())
  .join('');
const openRepairsCount = repairStats.openCount;
const vacantUnits = Math.max(0, stats.totalUnits - stats.occupiedUnits);

const navItems = [
  { name: 'Overview', href: '/', icon: LayoutGrid, active: currentPath === '/' },
  { name: 'Properties', href: '/properties', icon: Building2, active: currentPath === '/properties' },
  { name: 'Tenants', href: '/tenants', icon: Users, active: currentPath === '/tenants' },
  { name: 'Enquiries & leads', href: '/enquiries', icon: PhoneCall, active: currentPath === '/enquiries' },
  { name: 'Reset tenant PIN', href: '/reset-password', icon: KeyRound, active: currentPath === '/reset-password' },
  ...(FEATURES.leases ? [{ name: 'Leases', href: '/leases', icon: FileText, active: currentPath === '/leases' }] : []),
  { name: 'Monthly bills', href: '/bills', icon: ReceiptText, active: currentPath === '/bills' },
  { name: 'Payments & receipts', href: '/payments', icon: CreditCard, active: currentPath === '/payments', badge: pendingClaimsCount ? pendingClaimsCount.toString() : undefined, badgeType: 'alert' },
  { name: 'Arrears', href: '/arrears', icon: AlertTriangle, active: currentPath === '/arrears', badge: stats.tenantsOverdueCount ? stats.tenantsOverdueCount.toString() : undefined, badgeType: 'alert' },
  { name: 'Maintenance', href: '/maintenance', icon: Wrench, active: currentPath === '/maintenance', badge: openRepairsCount ? openRepairsCount.toString() : undefined, badgeType: 'neutral' },
  { name: 'Messages', href: '/messages', icon: MessageSquare, active: currentPath === '/messages', badge: unreadThreadCount ? unreadThreadCount.toString() : undefined, badgeType: 'neutral' },
  { name: 'Reports', href: '/reports', icon: BarChart2, active: currentPath === '/reports' },
  { name: 'Settings', href: '/settings', icon: Settings, active: currentPath === '/settings' },
];
function darkenColor(hexColor: string, factor = 0.2): string {
  const cleanHex = hexColor.replace('#', '');
  const r = Math.round((parseInt(cleanHex.substring(0, 2), 16) || 0) * factor);
  const g = Math.round((parseInt(cleanHex.substring(2, 4), 16) || 0) * factor);
  const b = Math.round((parseInt(cleanHex.substring(4, 6), 16) || 0) * factor);
  return '#' + [r, g, b].map(x => Math.min(255, Math.max(0, x)).toString(16).padStart(2, '0')).join('');
}

function isLightColor(hexColor: string): boolean {
  const cleanHex = hexColor.replace('#', '');
  const r = parseInt(cleanHex.substring(0, 2), 16) || 0;
  const g = parseInt(cleanHex.substring(2, 4), 16) || 0;
  const b = parseInt(cleanHex.substring(4, 6), 16) || 0;
  const yiq = (r * 299 + g * 587 + b * 114) / 1000;
  return yiq >= 120;
}

const rawSidebarBg = company.settings?.theme?.navBg || '#0A261F';
const rawPrimary = company.settings?.theme?.primary || '#0D382B';
const brandAccent = company.settings?.theme?.accent || '#C6EE58';

// Sidebar is always a rich dark luxury surface for guaranteed WCAG AAA text visibility.
const sidebarBg = isLightColor(rawSidebarBg) ? darkenColor(rawSidebarBg, 0.16) : rawSidebarBg;
const brandPrimary = isLightColor(rawPrimary) ? darkenColor(rawPrimary, 0.26) : rawPrimary;

const activeItemStyle = `background: linear-gradient(to right, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.04)); border: 1px solid rgba(255, 255, 255, 0.22); color: #FFFFFF;`;
---

<aside 
  id="app-sidebar"
  transition:persist="sidebar"
  style={`--sidebar-bg: ${sidebarBg}; --sidebar-primary: ${brandPrimary}; --sidebar-accent: ${brandAccent}; --sidebar-accent-glow: ${brandAccent}1F;`}
  class="fixed inset-y-0 left-0 z-40 text-white flex flex-col justify-between -translate-x-full lg:translate-x-0 border-r border-white/10 shadow-[4px_0_24px_rgba(0,0,0,0.35)] select-none"
>
  <div class="flex flex-col flex-1 overflow-y-auto px-3.5 py-5 scrollbar-thin">
    <!-- Brand Logo & Collapse Toggle -->
    <div class="sidebar-brand-wrapper flex items-center justify-between gap-3 px-1.5 mb-7">
      <a href="/" class="flex items-center gap-3 min-w-0 group" title={`${company.name} · Makazi HQ`}>
        <!-- Glowing Brand Emblem -->
        <div 
          style={`background: linear-gradient(135deg, ${brandAccent}, ${brandPrimary}); color: #081B2E; box-shadow: 0 0 18px ${brandAccent}40; text-shadow: 0 1px 1px rgba(255,255,255,0.4);`}
          class="h-10 w-10 rounded-2xl font-black text-xl flex items-center justify-center border border-white/20 flex-shrink-0 transition-transform duration-200 group-hover:scale-105"
        >
          {company.name.charAt(0) || 'M'}
        </div>
        <div class="sidebar-header-details min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="font-editorial text-2xl font-bold text-white tracking-wide leading-none">
              Makazi
            </span>
            <span 
              style={`background-color: ${brandAccent}26; border-color: ${brandAccent}4D; color: ${brandAccent};`}
              class="inline-flex items-center px-1.5 py-0.5 rounded-full border text-[9px] font-bold uppercase tracking-wider"
            >
              Admin
            </span>
          </div>
          <p class="text-xs text-white/70 truncate font-semibold flex items-center gap-1.5 mt-1">
            <span class="relative flex h-2 w-2 flex-shrink-0">
              <span 
                style={`background-color: ${brandAccent};`}
                class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"
              ></span>
              <span 
                style={`background-color: ${brandAccent};`}
                class="relative inline-flex rounded-full h-2 w-2"
              ></span>
            </span>
            <span class="truncate">{company.name}</span>
          </p>
        </div>
      </a>

      <!-- Collapsible Sidebar Button (Desktop) -->
      <button 
        id="sidebar-collapse-toggle"
        type="button"
        class="hidden lg:flex p-1.5 rounded-xl text-white/60 hover:text-white hover:bg-white/10 border border-transparent transition-all cursor-pointer flex-shrink-0"
        aria-label="Toggle sidebar collapse (⌘B)"
        title="Toggle sidebar collapse (⌘B)"
      >
        <span id="collapse-icon-close">
          <PanelLeftClose class="w-4 h-4" />
        </span>
        <span id="collapse-icon-open" class="hidden">
          <PanelLeftOpen class="w-4 h-4" />
        </span>
      </button>
    </div>

    <!-- Workspace Navigation -->
    <div class="space-y-6">
      <div>
        <div class="px-2 mb-2 flex items-center justify-between">
          <p class="sidebar-workspace-label text-[11px] font-black uppercase tracking-widest text-white/50">
            WORKSPACE
          </p>
        </div>
        <nav class="space-y-1.5">
          {navItems.map((item) => {
            const Icon = item.icon;
            return (
              <a
                href={item.href}
                data-nav-href={item.href}
                style={item.active ? activeItemStyle : ''}
                class={`sidebar-nav-item relative flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-sm transition-all group ${
                  item.active 
                    ? 'font-black shadow-sm' 
                    : 'text-white/80 hover:text-white font-semibold hover:bg-white/10 hover:translate-x-0.5'
                }`}
              >
                <!-- Glowing Active Neon Accent Pill -->
                <span 
                  style={item.active ? `background-color: ${brandAccent}; box-shadow: 0 0 10px ${brandAccent}; opacity: 1;` : 'opacity: 0;'}
                  class="sidebar-active-indicator absolute left-1 top-1/2 -translate-y-1/2 w-1 h-5 rounded-full transition-opacity duration-200"
                ></span>

                <div class="flex items-center gap-3 min-w-0">
                  <div class="relative flex items-center justify-center">
                    <Icon 
                      style={item.active ? `color: ${brandAccent}; filter: drop-shadow(0 0 6px ${brandAccent}99);` : ''}
                      class={`w-4 h-4 flex-shrink-0 transition-colors ${item.active ? '' : 'text-white/70 group-hover:text-white'}`} 
                    />
                    {item.badge && (
                      <span 
                        style={item.badgeType !== 'alert' ? `background-color: ${brandAccent}; box-shadow: 0 0 6px ${brandAccent};` : ''}
                        class={`sidebar-dot-badge hidden absolute -top-1 -right-1 h-2 w-2 rounded-full ring-2 ring-black/50 ${
                          item.badgeType === 'alert' ? 'bg-[#E5532E] shadow-[0_0_6px_#E5532E]' : ''
                        }`} 
                      />
                    )}
                  </div>
                  <span class={`sidebar-text-label truncate ${item.active ? 'font-bold text-white' : 'font-medium text-white/85 group-hover:text-white'}`}>{item.name}</span>
                </div>

                <!-- Full Pill Badge in Expanded Mode -->
                {item.badge && (
                  <span 
                    style={item.badgeType !== 'alert' ? `background-color: ${brandAccent}26; border-color: ${brandAccent}60; color: ${brandAccent};` : ''}
                    class={`sidebar-pill-badge text-[11px] font-bold px-2 py-0.5 rounded-full transition-all ${
                      item.badgeType === 'alert'
                        ? 'bg-[#E5532E]/30 text-[#FF8566] border border-[#E5532E]/60 shadow-[0_0_8px_rgba(229,83,46,0.35)]'
                        : 'border shadow-xs'
                    }`}
                  >
                    {item.badge}
                  </span>
                )}

                <!-- Floating Tooltip in Collapsed Mode -->
                <div class="sidebar-item-tooltip bg-[#081B2E] text-white border border-white/15 shadow-xl">
                  <span class="font-bold">{item.name}</span>
                  {item.badge && (
                    <span 
                      style={item.badgeType === 'alert' ? '' : `background-color: ${brandAccent}; color: #081B2E;`}
                      class={`text-[10px] px-1.5 py-0.2 rounded-full font-bold ${
                        item.badgeType === 'alert' ? 'bg-[#E5532E] text-white' : ''
                      }`}
                    >
                      {item.badge}
                    </span>
                  )}
                </div>
              </a>
            );
          })}
        </nav>
      </div>
    </div>

    <!-- Ask Makazi Quick AI Assistant Trigger in Sidebar -->
    <div class="px-1 pt-1 pb-2">
      <button
        type="button"
        id="sidebar-assistant-btn"
        style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12);"
        class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-white hover:bg-white/10 hover:border-white/25 shadow-xs transition-all hover:scale-[1.01] cursor-pointer group"
      >
        <div class="flex items-center gap-2.5 min-w-0">
          <div 
            style={`background-color: ${brandAccent}; color: #081B2E;`}
            class="h-6 w-6 rounded-lg flex items-center justify-center font-bold text-xs shadow-xs"
          >
            <Sparkles class="w-3.5 h-3.5 stroke-[2.5]" />
          </div>
          <span class="sidebar-text-label text-xs font-bold tracking-wide truncate text-white">Ask Makazi</span>
        </div>
        <span 
          style={`background-color: ${brandAccent}26; border-color: ${brandAccent}4D; color: ${brandAccent};`}
          class="sidebar-pill-badge text-[10px] font-bold px-1.5 py-0.5 rounded-full border"
        >AI</span>
      </button>
    </div>

    <!-- Ask Nyumbani Marketplace Promo Card -->
    <div class="sidebar-nyumbani-wrapper px-1 pt-2 pb-1">
      <a
        href="https://play.google.com/store/apps/details?id=com.codzure.ask_nyumbani&pcampaignid=web_share"
        target="_blank"
        rel="noopener noreferrer"
        style="border-color: rgba(255,255,255,0.12); background: rgba(255, 255, 255, 0.04);"
        class="group block p-3 rounded-2xl border hover:border-white/25 hover:bg-white/[0.08] shadow-sm transition-all hover:scale-[1.01]"
        title="Ask Nyumbani — Find tenants & list your vacant units on Google Play"
      >
        <div class="flex items-center justify-between mb-1.5">
          <span 
            style={`background-color: ${brandAccent}26; border-color: ${brandAccent}4D; color: ${brandAccent};`}
            class="inline-flex items-center px-1.5 py-0.5 rounded-md border text-[9px] font-bold uppercase tracking-wider"
          >
            Marketplace
          </span>
          <ExternalLink 
            style={`color: ${brandAccent};`}
            class="w-3.5 h-3.5 transition-colors opacity-80 group-hover:opacity-100" 
          />
        </div>
        <p class="text-xs font-bold text-white tracking-tight">Ask Nyumbani</p>
        {vacantUnits > 0 ? (
          <p class="text-[11px] text-white/70 line-clamp-2 mt-0.5 leading-snug">
            <span class="font-bold text-white tabular-nums">{vacantUnits} vacant {vacantUnits === 1 ? 'unit' : 'units'}</span> · list them and connect with verified tenants.
          </p>
        ) : (
          <p class="text-[11px] text-white/70 line-clamp-2 mt-0.5 leading-snug">
            List vacant units & connect with verified tenants across East Africa.
          </p>
        )}
        <div 
          style={`color: ${brandAccent};`}
          class="mt-2 text-[10px] font-bold flex items-center gap-1 group-hover:underline"
        >
          <span>Get on Google Play</span>
          <span>→</span>
        </div>
      </a>
    </div>
  </div>

  <!-- User Footer Profile Card -->
  <div 
    style="border-color: rgba(255,255,255,0.1); background-color: rgba(0,0,0,0.35);"
    class="p-3 border-t backdrop-blur-md"
  >
    <div 
      style="border-color: rgba(255,255,255,0.08); background-color: rgba(255,255,255,0.05);"
      class="sidebar-user-card flex items-center justify-between p-2 rounded-2xl border shadow-inner group"
    >
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="relative flex-shrink-0">
          <div 
            style={`background: linear-gradient(135deg, ${brandPrimary}, ${sidebarBg}); color: #FFFFFF; border: 1px solid rgba(255,255,255,0.2);`}
            class="h-9 w-9 rounded-xl font-bold text-xs flex items-center justify-center border shadow-xs"
          >
            {adminInitials}
          </div>
          <span class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-[#10B981] ring-2 ring-black/70"></span>
        </div>
        <div class="sidebar-user-details min-w-0 text-left">
          <p class="text-xs font-bold text-white truncate leading-tight">
            {adminName}
          </p>
          <p class="text-[11px] text-white/60 truncate mt-0.5" title={user?.email}>
            {adminRole} · {user?.email}
          </p>
        </div>
      </div>
      <form method="post" action="/logout" class="sidebar-signout-btn">
        <button 
          type="submit" 
          class="p-2 rounded-xl text-white/60 hover:text-[#FF8566] hover:bg-white/10 border border-transparent transition-all cursor-pointer" 
          aria-label="Sign out" 
          title="Sign out"
        >
          <LogOut class="w-4 h-4" />
        </button>
      </form>
    </div>
  </div>
</aside>

<!-- Backdrop overlay for mobile sidebar -->
<div 
  id="sidebar-backdrop" 
  transition:persist="sidebar-backdrop"
  class="fixed inset-0 z-30 bg-black/50 backdrop-blur-sm hidden lg:hidden transition-opacity duration-300"
></div>
