---
import { X, Download, Printer } from '@lucide/astro';
import { getPortfolio } from '../../data/portfolio';

// This company's data only (the signed-in user's).
const { company } = await getPortfolio(Astro.locals.user!.companyId, Astro.cookies);
---

<!-- Filled in when a receipt is opened; no sample data, so nothing from one
     company can sit in another company's page. -->
<div 
  id="receipt-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="receipt-modal-title"
>
  <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl border border-[#E7EAE4] overflow-hidden transform scale-95 transition-transform duration-200">
    <!-- Header -->
    <div class="p-6 bg-[#0D382B] text-white flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="h-8 w-8 rounded-full bg-[#C6EE58] text-[#0D382B] flex items-center justify-center font-bold">
          ✓
        </div>
        <div>
          <h3 id="receipt-modal-title" class="text-sm font-semibold tracking-wide">
            Official Receipt
          </h3>
          <p id="receipt-modal-id" class="text-xs text-[#93BDB0]">—</p>
        </div>
      </div>
      <button 
        type="button" 
        id="close-receipt-modal-btn"
        class="h-8 w-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors cursor-pointer"
        aria-label="Close modal"
      >
        <X class="w-4 h-4" />
      </button>
    </div>

    <!-- Body: same fields, labels and order as the tenant app's receipt -->
    <div class="p-6 space-y-5">
      <div class="text-center pb-4 border-b border-dashed border-[#E7EAE4]">
        <div class="mx-auto h-11 w-11 rounded-full bg-[#0D382B] text-white font-editorial text-xl flex items-center justify-center">
          {company.name.charAt(0)}
        </div>
        <p class="text-sm font-semibold text-[#17231E] mt-2">{company.name}</p>
        <p class="text-[11px] text-[#73827C] tracking-wide">KRA PIN {company.kraPin}</p>
      </div>

      <div class="text-center pb-4 border-b border-dashed border-[#E7EAE4]">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#73827C]">Amount paid</span>
        <h4 id="receipt-modal-amount" class="font-editorial text-4xl font-normal text-[#17231E] mt-1 tabular-nums">—</h4>
      </div>

      <dl class="space-y-3 text-xs sm:text-sm">
        {[
          ['Receipt', 'receipt-modal-number', 'font-mono'],
          ['Tenant', 'receipt-modal-tenant', ''],
          ['Unit', 'receipt-modal-unit-prop', ''],
          ['Date', 'receipt-modal-date', 'tabular-nums'],
          ['Method', 'receipt-modal-method', ''],
          ['Reference', 'receipt-modal-ref', 'font-mono'],
          ['For', 'receipt-modal-for', ''],
        ].map(([label, id, extra]) => (
          <div class="flex justify-between gap-4">
            <dt class="text-[#73827C]">{label}</dt>
            <dd id={id} class={`font-semibold text-[#17231E] text-right ${extra}`}>—</dd>
          </div>
        ))}
      </dl>

      <!-- Action Buttons -->
      <div class="pt-4 flex items-center justify-end gap-3 border-t border-[#F0F2EE]">
        <button 
          type="button" 
          onclick="window.print()"
          class="flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-medium border border-[#DCE0D7] text-[#17231E] hover:bg-[#F4F5F1] transition-colors cursor-pointer"
        >
          <Printer class="w-4 h-4" />
          <span>Print</span>
        </button>
        <button 
          type="button" 
          id="download-receipt-btn"
          class="flex items-center gap-2 px-5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-[#0D382B] text-white hover:bg-[#154637] transition-all cursor-pointer shadow-sm"
        >
          <Download class="w-4 h-4" />
          <span>Download PDF</span>
        </button>
      </div>
    </div>
  </div>
</div>
