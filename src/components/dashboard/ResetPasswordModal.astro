---
import { X, KeyRound } from '@lucide/astro';
import { getPortfolio } from '../../data/portfolio';

// This company's data only (the signed-in user's).
const { company } = await getPortfolio(Astro.locals.user!.companyId, Astro.cookies);
---

<div
  id="reset-password-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reset-password-title"
  data-company={company.name}
>
  <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl border border-[#E7EAE4] overflow-hidden transform scale-95 transition-transform duration-200 max-h-[92vh] flex flex-col">
    <div class="flex items-center justify-between p-6 border-b border-[#F0F2EE] shrink-0">
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-xl bg-[#0D382B] text-[#C6EE58] flex items-center justify-center">
          <KeyRound class="w-5 h-5" />
        </div>
        <div>
          <h3 id="reset-password-title" class="font-editorial text-2xl font-normal text-[#17231E]">
            Tenant login PIN
          </h3>
          <p class="text-xs text-[#73827C]" data-field="who"></p>
        </div>
      </div>
      <button type="button" data-close class="h-8 w-8 rounded-full bg-[#F4F5F1] text-[#73827C] hover:text-[#17231E] flex items-center justify-center transition-colors cursor-pointer" aria-label="Close">
        <X class="w-4 h-4" />
      </button>
    </div>

    <div class="p-6 space-y-5 flex-1 min-h-0 overflow-y-auto">
      <p class="text-sm text-[#5A6862] leading-relaxed">
        The tenant signs in to the Makazi mobile app using their phone number and this 4-digit PIN.
      </p>

      <div class="relative rounded-2xl bg-[#F8F9F7] border border-[#E7EAE4] p-4 text-center">
        <span class="block text-[10px] font-semibold uppercase tracking-wider text-[#69847A]">4-Digit PIN</span>
        <span data-field="password" class="block font-mono text-3xl font-bold tracking-widest text-[#0D382B] mt-1 select-all"></span>
        <button type="button" data-copy="pin" title="Copy PIN" aria-label="Copy PIN" class="absolute top-3 right-3 p-2 rounded-lg text-[#5A6862] hover:text-[#0D382B] hover:bg-white transition-colors cursor-pointer">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        </button>
      </div>

      <div>
        <span class="block text-xs font-semibold uppercase tracking-wider text-[#5A6862] mb-1.5">Message to send</span>
        <div class="relative">
          <p data-field="message" class="p-3.5 pr-12 bg-[#FAFBF9] rounded-xl border border-[#E2E5DF] text-xs text-[#2C3B34] leading-relaxed"></p>
          <button type="button" data-copy="message" title="Copy message" aria-label="Copy message" class="absolute top-2 right-2 p-2 rounded-lg text-[#5A6862] hover:text-[#0D382B] hover:bg-white transition-colors cursor-pointer">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          </button>
        </div>
        <p class="text-[11px] text-[#73827C] mt-1.5">Send it to the app, where it shows if the tenant is already signed in. Or copy it into WhatsApp or SMS from your own phone, or tell them in person.</p>
      </div>

      <div class="pt-4 flex items-center justify-end gap-3 border-t border-[#F0F2EE]">
        <button type="button" data-close class="px-5 py-2.5 rounded-xl text-sm font-medium text-[#5A6862] hover:bg-[#F4F5F1] transition-colors cursor-pointer">Done</button>
        <button type="button" id="send-pin-to-app" class="px-6 py-2.5 rounded-xl text-sm font-semibold bg-[#0D382B] text-white hover:bg-[#154637] transition-all shadow-md cursor-pointer disabled:opacity-50">Send to app</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { setBusy } from '../../lib/busy';

  function initResetPasswordModal() {
    const modal = document.getElementById('reset-password-modal');
    if (!modal) return;
    const setText = (field: string, text: string) => {
      const el = modal.querySelector(`[data-field="${field}"]`);
      if (el) el.textContent = text;
    };
    let message = '';
    let tenantName = '';
    let currentPin = '';
    let currentPhone = '';

    document.querySelectorAll<HTMLButtonElement>('.reset-password-btn').forEach((btn) => {
      btn.onclick = async () => {
        const { name = '', phone = '' } = btn.dataset;
        tenantName = name;
        const restoreBtn = setBusy(btn, 'Resetting…');

        try {
          const res = await fetch('/api/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone }),
          });

          const data = await res.json();
          if (!res.ok || data.error) {
            throw new Error(data.error || 'Failed to reset password');
          }

          const pin = data.pin || data.password;
          currentPin = String(pin);
          currentPhone = phone;
          const sendBtn = document.getElementById('send-pin-to-app') as HTMLButtonElement | null;
          if (sendBtn) {
            sendBtn.disabled = false;
            sendBtn.textContent = 'Send to app';
          }
          message =
            `${modal.dataset.company || 'Makazi'}: your Makazi login PIN is ${pin}. ` +
            `Sign in with ${phone} on the Makazi app using this 4-digit PIN.`;
          setText('who', `${name} · signs in with ${phone}`);
          setText('password', pin);
          setText('message', message);
          window.makaziUi?.showModal('reset-password-modal');
        } catch (e: unknown) {
          const msg = e instanceof Error ? e.message : String(e);
          console.error('Failed to reset PIN:', msg);
          window.makaziUi?.showToast('Error', msg);
        } finally {
          restoreBtn();
        }
      };
    });

    modal.querySelectorAll('[data-close]').forEach((el) => {
      (el as HTMLElement).onclick = () => {
        window.makaziUi?.hideModal('reset-password-modal');
        window.makaziUi?.showToast(
          'PIN updated',
          `${tenantName}'s 4-digit PIN is active and ready for login.`,
        );
      };
    });

    modal.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.onclick = async () => {
        const isPin = btn.dataset.copy === 'pin';
        try {
          await navigator.clipboard.writeText(isPin ? currentPin : message);
          window.makaziUi?.showToast(
            isPin ? 'PIN copied' : 'Message copied',
            isPin ? 'Share it with the tenant privately.' : 'Paste it into WhatsApp or SMS for the tenant.',
          );
        } catch {
          window.makaziUi?.showToast('Copy failed', 'Select the text and copy it manually.');
        }
      };
    });

    const sendBtn = document.getElementById('send-pin-to-app') as HTMLButtonElement | null;
    if (sendBtn) {
      sendBtn.onclick = async () => {
        const restore = setBusy(sendBtn, 'Sending…');
        try {
          const res = await fetch('/api/send-pin-notice', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone: currentPhone, pin: currentPin }),
          });
          const data = await res.json();
          if (!res.ok || data.error) throw new Error(data.error || "Couldn't send to the app. Try again.");
          restore();
          // Sent once: the button records it instead of inviting duplicates.
          sendBtn.disabled = true;
          sendBtn.textContent = 'Sent to app';
          window.makaziUi?.showToast('Sent to the app', `${tenantName} will see the PIN in their notifications.`);
        } catch (e: unknown) {
          restore();
          window.makaziUi?.showToast('Not sent', e instanceof Error ? e.message : String(e));
        }
      };
    }
  }

  document.addEventListener('astro:page-load', initResetPasswordModal);
</script>
