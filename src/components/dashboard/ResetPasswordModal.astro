---
import { X, KeyRound } from '@lucide/astro';
import { getPortfolio } from '../../data/portfolio';

// This company's data only (the signed-in user's).
const { company } = await getPortfolio(Astro.locals.user!.companyId, Astro.cookies);
---

<div
  id="reset-password-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reset-password-title"
  data-company={company.name}
>
  <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl border border-[#E7EAE4] overflow-hidden transform scale-95 transition-transform duration-200">
    <div class="flex items-center justify-between p-6 border-b border-[#F0F2EE]">
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-xl bg-[#0D382B] text-[#C6EE58] flex items-center justify-center">
          <KeyRound class="w-5 h-5" />
        </div>
        <div>
          <h3 id="reset-password-title" class="font-editorial text-2xl font-normal text-[#17231E]">
            One-time password
          </h3>
          <p class="text-xs text-[#73827C]" data-field="who"></p>
        </div>
      </div>
      <button type="button" data-close class="h-8 w-8 rounded-full bg-[#F4F5F1] text-[#73827C] hover:text-[#17231E] flex items-center justify-center transition-colors cursor-pointer" aria-label="Close">
        <X class="w-4 h-4" />
      </button>
    </div>

    <div class="p-6 space-y-5">
      <p class="text-sm text-[#5A6862] leading-relaxed">
        The tenant signs in with their phone number and this password, then must choose their own.
        It works once and expires after 72 hours. Their current password and any signed-in phones stop working.
      </p>

      <div class="rounded-2xl bg-[#F8F9F7] border border-[#E7EAE4] p-4 text-center">
        <span class="block text-[10px] font-semibold uppercase tracking-wider text-[#69847A]">Password</span>
        <span data-field="password" class="block font-mono text-2xl tracking-widest text-[#0D382B] mt-1 select-all"></span>
      </div>

      <div>
        <span class="block text-xs font-semibold uppercase tracking-wider text-[#5A6862] mb-1.5">Message to send</span>
        <p data-field="message" class="p-3.5 bg-[#FAFBF9] rounded-xl border border-[#E2E5DF] text-xs text-[#2C3B34] leading-relaxed"></p>
        <p class="text-[11px] text-[#73827C] mt-1.5">Paste it into WhatsApp or SMS from your own phone, or tell the tenant in person. No cost to the business.</p>
      </div>

      <div class="pt-4 flex items-center justify-end gap-3 border-t border-[#F0F2EE]">
        <button type="button" data-close class="px-5 py-2.5 rounded-xl text-sm font-medium text-[#5A6862] hover:bg-[#F4F5F1] transition-colors cursor-pointer">Done</button>
        <button type="button" id="copy-reset-message" class="px-6 py-2.5 rounded-xl text-sm font-semibold bg-[#0D382B] text-white hover:bg-[#154637] transition-all shadow-md cursor-pointer">Copy message</button>
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('reset-password-modal')!;
  const setText = (field: string, text: string) => {
    const el = modal.querySelector(`[data-field="${field}"]`);
    if (el) el.textContent = text;
  };
  let message = '';
  let tenantName = '';

  // Unambiguous characters (no 0/O, 1/I/L) so it can be read out over the phone.
  function oneTimePassword(): string {
    const alphabet = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';
    const bytes = crypto.getRandomValues(new Uint8Array(12));
    const chars = [...bytes].map((b) => alphabet[b % alphabet.length]).join('');
    return `${chars.slice(0, 4)}-${chars.slice(4, 8)}-${chars.slice(8, 12)}`;
  }

  document.querySelectorAll<HTMLButtonElement>('.reset-password-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const { name = '', phone = '' } = btn.dataset;
      tenantName = name;
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span class="animate-spin mr-1">⏳</span> Resetting...';

      try {
        const res = await fetch('/api/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone }),
        });

        const data = await res.json();
        if (!res.ok || data.error) {
          throw new Error(data.error || 'Failed to reset password');
        }

        const password = data.password;
        message =
          `${modal.dataset.company || 'Makazi'}: your Makazi one-time password is ${password}. ` +
          `Sign in with ${phone}, then choose your own password. It expires in 72 hours.`;
        setText('who', `${name} · signs in with ${phone}`);
        setText('password', password);
        setText('message', message);
        window.makaziUi?.showModal('reset-password-modal');
      } catch (e: unknown) {
        const msg = e instanceof Error ? e.message : String(e);
        console.error('Failed to reset password:', msg);
        window.makaziUi?.showToast('Error', msg);
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    });
  });

  modal.querySelectorAll('[data-close]').forEach((el) =>
    el.addEventListener('click', () => {
      window.makaziUi?.hideModal('reset-password-modal');
      window.makaziUi?.showToast(
        'Password updated',
        `${tenantName}'s one-time password is active and ready for login.`,
      );
    }),
  );

  document.getElementById('copy-reset-message')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(message);
      window.makaziUi?.showToast('Message copied', 'Paste it into WhatsApp or SMS for the tenant.');
    } catch {
      window.makaziUi?.showToast('Copy failed', 'Select the message text and copy it manually.');
    }
  });
</script>
