---
import { X, UserCheck, Shield } from '@lucide/astro';

const inputClass =
  'w-full px-4 py-2.5 rounded-xl border border-[#DCE0D7] focus:border-[#0D382B] focus:ring-2 focus:ring-[#0D382B]/10 outline-none text-sm text-[#17231E] bg-white';
const labelClass = 'block text-xs font-semibold uppercase tracking-wider text-[#5A6862] mb-1.5';
---

<div
  id="edit-tenant-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="edit-tenant-title"
>
  <div class="relative w-full max-w-lg bg-white rounded-3xl shadow-2xl border border-[#E7EAE4] overflow-hidden transform scale-95 transition-transform duration-200 max-h-[90vh] flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between p-6 border-b border-[#F0F2EE] shrink-0">
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-xl bg-[#0D382B] text-[#C6EE58] flex items-center justify-center">
          <UserCheck class="w-5 h-5" />
        </div>
        <div>
          <h3 id="edit-tenant-title" class="font-editorial text-2xl font-normal text-[#17231E]">Edit tenant & tenancy</h3>
          <p class="text-xs text-[#73827C]">Correct misspellings, update contact info, or adjust agreed rent and lease dates.</p>
        </div>
      </div>
      <button
        type="button"
        id="close-edit-tenant-btn"
        class="h-8 w-8 rounded-full bg-[#F4F5F1] text-[#73827C] hover:text-[#17231E] flex items-center justify-center transition-colors cursor-pointer"
        aria-label="Close"
      >
        <X class="w-4 h-4" />
      </button>
    </div>

    <!-- Form -->
    <form id="edit-tenant-form" class="p-6 space-y-4 flex-1 min-h-0 overflow-y-auto">
      <input type="hidden" id="edit-tenancy-id" />
      <input type="hidden" id="edit-tenant-id" />

      <!-- Full Name -->
      <div>
        <label for="edit-tenant-name" class={labelClass}>Tenant Full Name</label>
        <input type="text" id="edit-tenant-name" required placeholder="Official legal name" class={inputClass} />
      </div>

      <!-- Phone & Email -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="edit-tenant-phone" class={labelClass}>Phone Number <span class="normal-case font-normal">(app login)</span></label>
          <input type="tel" id="edit-tenant-phone" required placeholder="07XX XXX XXX" class={inputClass} />
        </div>
        <div>
          <label for="edit-tenant-email" class={labelClass}>Email Address <span class="normal-case font-normal">(receipts)</span></label>
          <input type="email" id="edit-tenant-email" placeholder="tenant@gmail.com" class={inputClass} />
        </div>
      </div>

      <!-- Rent & Deposit -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="edit-tenant-rent" class={labelClass}>Monthly Rent (KES)</label>
          <input type="number" id="edit-tenant-rent" required min="1" step="1" class={`${inputClass} tabular-nums`} />
        </div>
        <div>
          <label for="edit-tenant-deposit" class={labelClass}>Deposit Held (KES)</label>
          <input type="number" id="edit-tenant-deposit" min="0" step="1" class={`${inputClass} tabular-nums`} />
        </div>
      </div>

      <!-- Move-in & Lease End -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="edit-tenant-move-in" class={labelClass}>Move-in Date</label>
          <input type="date" id="edit-tenant-move-in" required class={inputClass} />
        </div>
        <div>
          <label for="edit-tenant-lease-end" class={labelClass}>Lease End Date</label>
          <input type="date" id="edit-tenant-lease-end" class={inputClass} />
        </div>
      </div>

      <div>
        <label for="edit-tenant-move-in-rent" class={labelClass}>Move-in Rent (KES)</label>
        <input type="number" id="edit-tenant-move-in-rent" required min="0" step="1" class={`${inputClass} tabular-nums`} />
        <p class="text-[11px] text-[#73827C] mt-1">Rent on the move-in bill, from move-in until the next billing cycle</p>
      </div>

      <p id="edit-tenant-error" class="hidden text-xs text-[#991B1B] bg-[#FEF2F2] border border-[#F8D7DA] p-3 rounded-xl font-medium"></p>

      <div class="pt-4 border-t border-[#F0F2EE] flex items-center justify-between">
        <button
          type="button"
          id="cancel-edit-tenant-btn"
          class="px-5 py-2.5 rounded-full border border-[#DCE0D7] text-xs font-semibold text-[#5A6862] hover:bg-[#F8F9F6] transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="submit"
          id="save-edit-tenant-btn"
          class="px-6 py-2.5 rounded-full bg-[#0D382B] text-white text-xs font-semibold hover:bg-[#08221A] transition-all shadow-xs cursor-pointer"
        >
          Save corrections
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function initEditTenantModal() {
    const modal = document.getElementById('edit-tenant-modal');
    const closeBtn = document.getElementById('close-edit-tenant-btn');
    const cancelBtn = document.getElementById('cancel-edit-tenant-btn');
    const form = document.getElementById('edit-tenant-form') as HTMLFormElement | null;
    const saveBtn = document.getElementById('save-edit-tenant-btn') as HTMLButtonElement | null;
    const errorText = document.getElementById('edit-tenant-error');

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      const inner = modal.querySelector('div.transform');
      inner?.classList.remove('scale-100');
      inner?.classList.add('scale-95');
      if (errorText) errorText.classList.add('hidden');
    }

    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Form submit
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!saveBtn) return;

      const tenancyId = (document.getElementById('edit-tenancy-id') as HTMLInputElement)?.value;
      const tenantId = (document.getElementById('edit-tenant-id') as HTMLInputElement)?.value;
      const name = (document.getElementById('edit-tenant-name') as HTMLInputElement)?.value;
      const phone = (document.getElementById('edit-tenant-phone') as HTMLInputElement)?.value;
      const email = (document.getElementById('edit-tenant-email') as HTMLInputElement)?.value;
      const rent = (document.getElementById('edit-tenant-rent') as HTMLInputElement)?.value;
      const deposit = (document.getElementById('edit-tenant-deposit') as HTMLInputElement)?.value;
      const moveIn = (document.getElementById('edit-tenant-move-in') as HTMLInputElement)?.value;
      const leaseEnd = (document.getElementById('edit-tenant-lease-end') as HTMLInputElement)?.value;
      const moveInRent = (document.getElementById('edit-tenant-move-in-rent') as HTMLInputElement)?.value;

      saveBtn.disabled = true;
      const originalText = saveBtn.textContent;
      saveBtn.textContent = 'Saving...';
      if (errorText) errorText.classList.add('hidden');

      try {
        const res = await fetch('/api/update-tenant', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tenancyId, tenantId, name, phone, email, rent, deposit, moveIn, moveInRent, leaseEnd }),
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to update tenant details');

        window.location.reload();
      } catch (err: any) {
        if (errorText) {
          errorText.textContent = err.message || 'Error updating tenant details';
          errorText.classList.remove('hidden');
        }
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
      }
    });
  }

  document.addEventListener('astro:page-load', initEditTenantModal);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initEditTenantModal();
  } else {
    document.addEventListener('DOMContentLoaded', initEditTenantModal);
  }
</script>

