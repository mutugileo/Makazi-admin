---
import { Check, CircleAlert } from '@lucide/astro';
// Tone ('success' | 'error' | 'progress') is set by showToast in DashboardLayout.
---

<div
  id="dashboard-toast"
  data-tone="success"
  style="background-color: var(--color-sidebar-bg);"
  class="group fixed bottom-6 right-6 z-[60] flex items-center gap-3 text-white px-5 py-4 rounded-2xl shadow-2xl border border-white/10 data-[tone=error]:border-[#F2A48E]/40 opacity-0 translate-y-4 pointer-events-none transition-all duration-300 max-w-[calc(100vw-3rem)]"
  role="status"
  aria-live="polite"
  aria-atomic="true"
>
  <div style="background-color: var(--color-brand-accent); color: var(--color-sidebar-bg);" class="toast-icon-success h-7 w-7 rounded-xl flex items-center justify-center font-bold text-sm flex-shrink-0 group-data-[tone=error]:hidden group-data-[tone=progress]:hidden">
    <Check class="w-4 h-4 stroke-[3]" />
  </div>
  <div class="toast-icon-error hidden group-data-[tone=error]:flex h-7 w-7 rounded-xl items-center justify-center flex-shrink-0 bg-[#C04A26] text-white">
    <CircleAlert class="w-4 h-4 stroke-[2.5]" />
  </div>
  <div class="toast-icon-progress hidden group-data-[tone=progress]:flex h-7 w-7 rounded-xl items-center justify-center flex-shrink-0 bg-white/10 text-[#F3F4F0]">
    <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
    </svg>
  </div>
  <div class="min-w-0">
    <p id="toast-title" class="text-sm font-semibold text-[#F3F4F0] group-data-[tone=error]:text-[#FFD9CC]"></p>
    <p id="toast-message" class="text-xs text-[#8EA89D] break-words"></p>
  </div>
</div>
