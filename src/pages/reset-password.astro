---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import ResetPasswordModal from '../components/dashboard/ResetPasswordModal.astro';
import { getPortfolio, bedLabel, formatDate, formatKes } from '../data/portfolio';
import { KeyRound, Search, ShieldCheck, ArrowLeft, Building2, Phone, Sparkles, Clock, CheckCircle2 } from '@lucide/astro';

// This company's data only (the signed-in user's).
const { activeTenancies, formerTenancies, portfolioSummary, propertyViews, currentPeriod } = await getPortfolio(
  Astro.locals.user!.companyId,
  Astro.cookies
);

// Collect all unique tenants across the company
const allTenants = [
  ...activeTenancies.map((t) => ({ ...t, isCurrent: true })),
  ...formerTenancies.map((t) => ({ ...t, isCurrent: false })),
];

const searchText = (parts: string[]) => parts.join(' ').toLowerCase();
---

<DashboardLayout title="Makazi — Reset Tenant PIN" currentPath="/reset-password">
  <!-- Top Navigation & Header -->
  <div class="mb-6">
    <a
      href="/tenants"
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#69847A] hover:text-[#0D382B] transition-colors mb-3"
    >
      <ArrowLeft class="w-3.5 h-3.5" />
      <span>Back to Tenants</span>
    </a>

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#EBF0EC] text-[#0D382B] text-xs font-semibold mb-2">
          <ShieldCheck class="w-3.5 h-3.5 text-[#0D382B]" />
          <span>Security & Access</span>
        </span>
        <h1 class="text-3xl sm:text-4xl font-normal font-editorial text-[#0D382B] tracking-tight">
          Tenant PIN & Password Reset
        </h1>
        <p class="text-sm text-[#69847A] mt-1.5 max-w-2xl">
          Search any tenant across your properties to issue or regenerate their 4-digit mobile app login PIN. PINs are valid for 72 hours and notify the tenant automatically.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/tenants"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white border border-[#E3E6DF] text-xs font-semibold text-[#0D382B] shadow-xs hover:border-[#0D382B] transition-colors"
        >
          <span>View All Tenants</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Key Information Highlights -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
    <div class="p-4 rounded-2xl bg-white border border-[#E3E6DF] shadow-xs">
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-xl bg-[#EBF0EC] text-[#0D382B] flex items-center justify-center shrink-0">
          <KeyRound class="w-5 h-5" />
        </div>
        <div>
          <span class="block text-xs font-medium text-[#69847A]">Access Protocol</span>
          <span class="block text-sm font-semibold text-[#0D382B]">4-Digit Numeric PIN</span>
        </div>
      </div>
    </div>

    <div class="p-4 rounded-2xl bg-white border border-[#E3E6DF] shadow-xs">
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-xl bg-[#FFF8E1] text-[#B78103] flex items-center justify-center shrink-0">
          <Clock class="w-5 h-5" />
        </div>
        <div>
          <span class="block text-xs font-medium text-[#69847A]">Temporary Validity</span>
          <span class="block text-sm font-semibold text-[#0D382B]">72 Hours Window</span>
        </div>
      </div>
    </div>

    <div class="p-4 rounded-2xl bg-white border border-[#E3E6DF] shadow-xs">
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-xl bg-[#E6F5ED] text-[#0A6B48] flex items-center justify-center shrink-0">
          <CheckCircle2 class="w-5 h-5" />
        </div>
        <div>
          <span class="block text-xs font-medium text-[#69847A]">Automatic Alerts</span>
          <span class="block text-sm font-semibold text-[#0D382B]">In-App Notice Sent</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter & Search Bar -->
  <div class="bg-white rounded-2xl border border-[#E3E6DF] p-4 mb-6 shadow-xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
    <div class="relative flex-1 min-w-0">
      <Search class="w-4 h-4 text-[#69847A] absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
      <input
        type="search"
        id="tenant-search-input"
        placeholder="Search tenant name, phone number (07XX...), unit, or property..."
        class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-[#E3E6DF] text-sm text-[#0D382B] placeholder:text-[#A8B3AE] focus:outline-none focus:border-[#0D382B] focus:ring-1 focus:ring-[#0D382B] transition-all bg-[#FAFBF9]"
      />
    </div>

    <div class="flex items-center gap-3">
      <select
        id="property-filter"
        class="px-3.5 py-2.5 rounded-xl border border-[#E3E6DF] text-xs font-semibold text-[#0D382B] bg-[#FAFBF9] focus:outline-none focus:border-[#0D382B] cursor-pointer"
      >
        <option value="">All properties ({propertyViews.length})</option>
        {propertyViews.map((p) => (
          <option value={p.property.id}>{p.property.name}</option>
        ))}
      </select>

      <span id="match-counter" class="text-xs font-medium text-[#69847A] whitespace-nowrap">
        {allTenants.length} tenants
      </span>
    </div>
  </div>

  <!-- Tenants List -->
  <div class="bg-white rounded-3xl border border-[#E3E6DF] shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse" id="reset-tenants-table">
        <thead>
          <tr class="border-b border-[#E3E6DF] bg-[#FAFBF9] text-[#69847A] uppercase font-semibold text-[10px] tracking-wider">
            <th class="py-3 px-4 lg:px-6">Tenant & Phone</th>
            <th class="py-3 px-3 lg:px-4">Property & Unit</th>
            <th class="py-3 px-3 lg:px-4">Monthly Rent</th>
            <th class="py-3 px-3 lg:px-4">Lease Status</th>
            <th class="py-3 px-4 lg:px-6 text-right sticky right-0 bg-[#FAFBF9] shadow-[-6px_0_12px_-4px_rgba(0,0,0,0.05)]">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#F0F2EE]">
          {allTenants.map((t) => (
            <tr
              class="tenant-row group hover:bg-[#F8F9F6] transition-colors"
              data-search={searchText([t.tenant.name, t.tenant.phone, t.unit.label, t.property.name])}
              data-property={t.property.id}
            >
              <td class="py-4 px-4 lg:px-6">
                <div class="flex items-center gap-3">
                  <span class="h-9 w-9 rounded-full bg-[#EBF0EC] border border-[#D5DFD8] flex items-center justify-center font-bold text-xs text-[#0D382B] shrink-0">
                    {t.tenant.name.split(' ').map((n) => n[0]).join('').slice(0, 2)}
                  </span>
                  <div class="min-w-0">
                    <span class="block font-semibold text-sm text-[#0D382B] truncate">{t.tenant.name}</span>
                    <span class="block text-xs text-[#69847A] font-mono mt-0.5">{t.tenant.phone}</span>
                  </div>
                </div>
              </td>

              <td class="py-4 px-3 lg:px-4 text-[#69847A]">
                <span class="font-semibold text-[#0D382B] text-xs">{t.unit.label}</span> · {t.property.name}
                <span class="block text-[11px] text-[#A8B3AE] mt-0.5">
                  {bedLabel(t.unit.bedrooms)} · Moved in {formatDate(t.tenancy.moveIn)}
                </span>
              </td>

              <td class="py-4 px-3 lg:px-4 font-semibold text-[#0D382B]">
                {formatKes(t.tenancy.rent)}
              </td>

              <td class="py-4 px-3 lg:px-4">
                {t.isCurrent ? (
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#F1F8E9] text-[#2E7D32] border border-[#C8E6C9]">
                    Active Lease
                  </span>
                ) : (
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#F4F5F1] text-[#73827C] border border-[#E3E6DF]">
                    Former Tenant
                  </span>
                )}
              </td>

              <td class="py-4 px-4 lg:px-6 text-right sticky right-0 bg-white/95 backdrop-blur-xs group-hover:bg-[#F8F9F6] shadow-[-6px_0_12px_-4px_rgba(0,0,0,0.05)] transition-colors">
                <div class="flex items-center justify-end">
                  <button
                    type="button"
                    class="reset-password-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#0D382B] hover:bg-[#134637] text-white text-xs font-semibold shadow-xs hover:shadow-md transition-all cursor-pointer"
                    data-name={t.tenant.name}
                    data-phone={t.tenant.phone}
                    title={`Generate 4-digit PIN for ${t.tenant.name}`}
                  >
                    <KeyRound class="w-3.5 h-3.5 text-[#C6EE58]" />
                    <span>Generate PIN</span>
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Empty Search State -->
    <div id="no-search-results" class="hidden p-12 text-center">
      <div class="h-12 w-12 rounded-full bg-[#F4F5F1] text-[#73827C] flex items-center justify-center mx-auto mb-3">
        <Search class="w-6 h-6" />
      </div>
      <h3 class="text-base font-semibold text-[#0D382B]">No tenants found</h3>
      <p class="text-xs text-[#69847A] mt-1 max-w-sm mx-auto">
        No tenants match your current search terms or property filter. Try searching with a different name or phone number.
      </p>
    </div>
  </div>

  <ResetPasswordModal />
</DashboardLayout>

<script>
  function initResetPasswordSearch() {
    const searchInput = document.getElementById('tenant-search-input') as HTMLInputElement | null;
    const propertyFilter = document.getElementById('property-filter') as HTMLSelectElement | null;
    const matchCounter = document.getElementById('match-counter');
    const noResults = document.getElementById('no-search-results');
    const table = document.getElementById('reset-tenants-table');
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.tenant-row'));

    function applyFilter() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      const prop = propertyFilter?.value || '';

      let visible = 0;
      rows.forEach((row) => {
        const rowSearch = row.dataset.search || '';
        const rowProp = row.dataset.property || '';

        const matchesQuery = !query || rowSearch.includes(query);
        const matchesProp = !prop || rowProp === prop;

        if (matchesQuery && matchesProp) {
          row.style.display = '';
          visible++;
        } else {
          row.style.display = 'none';
        }
      });

      if (matchCounter) {
        matchCounter.textContent = `${visible} tenant${visible === 1 ? '' : 's'}`;
      }

      if (noResults && table) {
        if (visible === 0) {
          noResults.classList.remove('hidden');
          table.classList.add('hidden');
        } else {
          noResults.classList.add('hidden');
          table.classList.remove('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', applyFilter);
    propertyFilter?.addEventListener('change', applyFilter);
  }

  document.addEventListener('DOMContentLoaded', initResetPasswordSearch);
  initResetPasswordSearch();
</script>
