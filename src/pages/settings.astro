---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { bedLabel, getPortfolio, monthLabel } from '../data/portfolio';
import { ChevronDown } from '@lucide/astro';

// This company's data only (the signed-in user's).
const { company, propertyViews, portfolioSummary } = await getPortfolio(Astro.locals.user!.companyId, Astro.cookies);
const { settings } = company;
const canEdit = Astro.locals.user!.role === 'owner';
const depositRows = Object.entries(settings.depositSchedule).sort(([a], [b]) => Number(a) - Number(b));

// The Makazi plan is managed by Codzure in the super-admin portal, not here.

const card = 'bg-white rounded-3xl border border-[#E3E6DF] p-6 shadow-xs';
const label = 'block text-[11px] font-semibold uppercase tracking-wider text-[#69847A] mb-1.5';
const input =
  'w-full px-3.5 py-2.5 rounded-xl border border-[#E2E5DF] bg-[#FAFBF9] text-sm font-semibold text-[#0D382B] focus:outline-none focus:border-[#0D382B] disabled:bg-[#F3F4F0] disabled:text-[#5A6862]';
const hint = 'text-[11px] text-[#73827C] mt-1';
const fixed = 'text-sm font-semibold text-[#0D382B] mt-0.5';

const currentTheme = settings.theme ?? {
  preset: 'forest',
  primary: '#0D382B',
  navBg: '#0A261F',
  accent: '#C6EE58',
};

const presets = [
  {
    id: 'cerulean',
    name: 'Cerulean & Amber',
    shortDesc: 'Vibrant blue & gold accent',
    primary: '#1E90DE',
    navBg: '#071A2C',
    accent: '#F5C555',
  },
  {
    id: 'blue',
    name: 'Sapphire Navy',
    shortDesc: 'Crisp banking & trust blue',
    primary: '#0A2540',
    navBg: '#081B2E',
    accent: '#38BDF8',
  },
  {
    id: 'forest',
    name: 'Makazi Forest',
    shortDesc: 'Signature emerald & lime',
    primary: '#0D382B',
    navBg: '#0A261F',
    accent: '#C6EE58',
  },
  {
    id: 'sky',
    name: 'Sky Blue & White',
    shortDesc: 'Bright sky blue & white',
    primary: '#37B5FF',
    navBg: '#37B5FF',
    accent: '#FFFFFF',
  },
  {
    id: 'midnight',
    name: 'Royal Slate',
    shortDesc: 'Modern charcoal & sky',
    primary: '#1E293B',
    navBg: '#0F172A',
    accent: '#60A5FA',
  },
  {
    id: 'espresso',
    name: 'Espresso & Gold',
    shortDesc: 'Warm luxury & gold',
    primary: '#2D1F17',
    navBg: '#1C130D',
    accent: '#E5C07B',
  },
];
---

<DashboardLayout title={`Makazi — Settings`} currentPath="/settings">
  <div class="mb-8">
    <span class="text-xs font-semibold tracking-wider text-[#69847A] uppercase">{portfolioSummary}</span>
    <h1 class="text-3xl sm:text-4xl font-normal font-editorial text-[#0D382B] tracking-tight mt-1">Settings</h1>
    <p class="text-xs text-[#69847A] mt-2">
      {canEdit
        ? 'Tenants see these in the Makazi app as soon as you save.'
        : 'Only the owner can change these.'}
    </p>
  </div>

  <form id="settings-form" novalidate>
    <fieldset disabled={!canEdit} class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <section class={card}>
        <h2 class="font-editorial text-2xl text-[#0D382B] mb-4">Company</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label for="s-name" class={label}>Name</label>
            <input id="s-name" name="name" class={input} value={company.name} maxlength="120" required />
            <p class={hint}>On every screen of the app, receipts and statements.</p>
          </div>
          <div>
            <label for="s-kra" class={label}>KRA PIN</label>
            <input id="s-kra" name="kraPin" class={`${input} uppercase font-mono`} value={company.kraPin} maxlength="11" required />
            <p class={hint}>Printed on receipts.</p>
          </div>
          <div>
            <span class={label}>Company ID</span>
            <p class={`${fixed} font-mono`}>{company.slug}</p>
            <p class={hint}>On Makazi since {monthLabel(settings.ledgerStartMonth)}.</p>
          </div>
        </div>
      </section>

      <section class={card}>
        <h2 class="font-editorial text-2xl text-[#0D382B] mb-4">Payments</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="s-paybill" class={label}>M-Pesa Paybill</label>
            <input id="s-paybill" name="mpesaPaybill" class={`${input} tabular-nums`} value={company.mpesaPaybill} inputmode="numeric" maxlength="7" required />
            <p class={hint}>Shown on Pay rent in the app.</p>
          </div>
          <div>
            <span class={label}>Account number</span>
            <p class={fixed}>Unit code (such as RC-5A)</p>
            <p class={hint}>Each tenant's own, set by their unit.</p>
          </div>
          <div>
            <label for="s-bank" class={label}>Bank</label>
            <input id="s-bank" name="bankName" class={input} value={company.bankName} maxlength="80" required />
          </div>
          <div>
            <label for="s-account" class={label}>Bank account</label>
            <input id="s-account" name="bankAccount" class={`${input} tabular-nums`} value={company.bankAccount} inputmode="numeric" maxlength="24" required />
            <p class={hint}>Shown for bank transfers in the app.</p>
          </div>
          <label for="s-mpesa-test" class="sm:col-span-2 flex items-start gap-3 rounded-2xl border border-[#FFE082] bg-[#FFF8E1]/60 p-3.5 cursor-pointer">
            <input id="s-mpesa-test" name="mpesaSimulation" type="checkbox" checked={settings.mpesaSimulation === true} class="mt-0.5 h-4 w-4 accent-[#0D382B] cursor-pointer" />
            <span>
              <span class="block text-sm font-semibold text-[#0D382B]">M-Pesa test mode</span>
              <span class="block text-[11px] text-[#5A6862] mt-0.5 leading-relaxed">
                Tenants' Pay now runs a simulated M-Pesa request and records a <strong>test payment</strong>
                that counts towards their balance, labelled "Test" everywhere. No money moves.
                Turn it off before tenants pay for real; real STK push needs M-Pesa Daraja.
              </span>
            </span>
          </label>
        </div>
      </section>

      <section class={`${card} lg:col-span-2`}>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="font-editorial text-2xl text-[#0D382B]">Brand theme & colors</h2>
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#EBF0EC] text-[#0D382B]">
                Live preview
              </span>
            </div>
            <p class="text-xs text-[#69847A] mt-1">
              Set by Codzure for your company. These colors apply to your admin side navigation and the tenant mobile app.
            </p>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-[#69847A]">Preset:</span>
            <span id="theme-active-preset-badge" class="text-xs font-bold px-2.5 py-1 rounded-lg bg-[#FAFBF9] border border-[#E3E6DF] text-[#0D382B] capitalize">
              {currentTheme.preset || 'custom'}
            </span>
          </div>
        </div>

        <input type="hidden" id="theme-preset-input" name="themePreset" value={currentTheme.preset || 'custom'} />

        <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">
          <!-- Left: Presets & Color inputs (7 cols) -->
          <div class="xl:col-span-7 space-y-5">
            <!-- Read-only here: the theme is set in the super-admin portal. -->
            <fieldset disabled class="space-y-5 min-w-0">
            <div>
              <span class={label}>Curated presets</span>
              <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-5 gap-3">
                {presets.map((p) => (
                  <button
                    type="button"
                    class={`p-3 rounded-[12px] border text-left transition-all cursor-pointer select-none theme-preset-btn ${currentTheme.preset === p.id ? 'border-[#1E90DE] bg-[#DCEBFB]/40 shadow-xs ring-2 ring-[#1E90DE]' : 'border-[#E3E6DF] bg-[#FAFBF9] hover:bg-white'}`}
                    data-preset-id={p.id}
                    data-primary={p.primary}
                    data-nav-bg={p.navBg}
                    data-accent={p.accent}
                  >
                    <div class="flex items-center gap-1.5 mb-2">
                      <div class="w-4 h-4 rounded-full border border-black/10" style={`background-color: ${p.primary};`}></div>
                      <div class="w-4 h-4 rounded-full border border-black/10" style={`background-color: ${p.navBg};`}></div>
                      <div class="w-4 h-4 rounded-full border border-black/10" style={`background-color: ${p.accent};`}></div>
                    </div>
                    <p class="text-xs font-semibold text-[#0D382B] leading-tight">{p.name}</p>
                    <p class="text-[10px] text-[#73827C] mt-0.5 leading-snug">{p.shortDesc}</p>
                  </button>
                ))}
              </div>
            </div>

            <!-- Custom Color Pickers -->
            <div class="border-t border-[#E8ECE5] pt-4">
              <span class={label}>Color tokens</span>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <!-- Primary Brand Color -->
                <div class="rounded-xl border border-[#E3E6DF] bg-[#FAFBF9] p-3">
                  <span class="block text-[11px] font-semibold text-[#0D382B] mb-0.5">Primary brand</span>
                  <span class="block text-[10px] text-[#73827C] mb-2">Cards, headers & text</span>
                  <div class="flex items-center gap-2">
                    <input 
                      type="color" 
                      id="theme-primary-picker" 
                      class="w-8 h-8 rounded-lg border border-black/10 cursor-pointer p-0 bg-transparent shrink-0"
                      value={currentTheme.primary} 
                    />
                    <input 
                      type="text" 
                      id="theme-primary-input" 
                      name="themePrimary" 
                      class="w-full font-mono text-xs uppercase px-2.5 py-1.5 rounded-lg border border-[#E2E5DF] bg-white font-semibold text-[#0D382B]" 
                      value={currentTheme.primary} 
                      maxlength="7" 
                      required 
                    />
                  </div>
                </div>

                <!-- Nav Background / Dark Chrome -->
                <div class="rounded-xl border border-[#E3E6DF] bg-[#FAFBF9] p-3">
                  <span class="block text-[11px] font-semibold text-[#0D382B] mb-0.5">Sidebar & dark</span>
                  <span class="block text-[10px] text-[#73827C] mb-2">Side nav, dark chrome</span>
                  <div class="flex items-center gap-2">
                    <input 
                      type="color" 
                      id="theme-navbg-picker" 
                      class="w-8 h-8 rounded-lg border border-black/10 cursor-pointer p-0 bg-transparent shrink-0"
                      value={currentTheme.navBg} 
                    />
                    <input 
                      type="text" 
                      id="theme-navbg-input" 
                      name="themeNavBg" 
                      class="w-full font-mono text-xs uppercase px-2.5 py-1.5 rounded-lg border border-[#E2E5DF] bg-white font-semibold text-[#0D382B]" 
                      value={currentTheme.navBg} 
                      maxlength="7" 
                      required 
                    />
                  </div>
                </div>

                <!-- Brand Accent -->
                <div class="rounded-xl border border-[#E3E6DF] bg-[#FAFBF9] p-3">
                  <span class="block text-[11px] font-semibold text-[#0D382B] mb-0.5">Brand accent</span>
                  <span class="block text-[10px] text-[#73827C] mb-2">Pills, active icons, glow</span>
                  <div class="flex items-center gap-2">
                    <input 
                      type="color" 
                      id="theme-accent-picker" 
                      class="w-8 h-8 rounded-lg border border-black/10 cursor-pointer p-0 bg-transparent shrink-0"
                      value={currentTheme.accent} 
                    />
                    <input 
                      type="text" 
                      id="theme-accent-input" 
                      name="themeAccent" 
                      class="w-full font-mono text-xs uppercase px-2.5 py-1.5 rounded-lg border border-[#E2E5DF] bg-white font-semibold text-[#0D382B]" 
                      value={currentTheme.accent} 
                      maxlength="7" 
                      required 
                    />
                  </div>
                </div>
              </div>
            </div>
          </fieldset>
          </div>

          <!-- Right: Live Dual Previews (5 cols) -->
          <div class="xl:col-span-5 flex flex-col gap-3">
            <span class={label}>Live experience preview</span>

            <!-- Mini Admin Sidebar Preview -->
            <div 
              id="preview-admin-sidebar" 
              class="rounded-2xl p-4 transition-all shadow-md border border-white/10"
              style={`background-color: ${currentTheme.navBg};`}
            >
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <div 
                    id="preview-sidebar-emblem"
                    class="w-7 h-7 rounded-lg font-black text-xs flex items-center justify-center border border-white/20"
                    style={`background: linear-gradient(135deg, ${currentTheme.accent}, ${currentTheme.primary}); color: #FFFFFF;`}
                  >
                    {company.name.charAt(0) || 'M'}
                  </div>
                  <div>
                    <div class="flex items-center gap-1.5">
                      <span class="text-sm font-bold text-white tracking-wide">Makazi</span>
                      <span 
                        id="preview-sidebar-pill"
                        class="text-[9px] font-bold uppercase px-1.5 py-0.2 rounded-full border"
                        style={`background-color: ${currentTheme.accent}26; border-color: ${currentTheme.accent}4D; color: ${currentTheme.accent};`}
                      >
                        Admin
                      </span>
                    </div>
                  </div>
                </div>
                <span class="text-[10px] font-semibold text-white/60">Side Nav</span>
              </div>

              <!-- Active Item Mock -->
              <div 
                id="preview-active-nav-item"
                class="rounded-xl px-3 py-2 flex items-center justify-between border"
                style={`background: linear-gradient(to right, ${currentTheme.primary}, ${currentTheme.navBg}); border-color: ${currentTheme.accent}80;`}
              >
                <div class="flex items-center gap-2">
                  <div class="w-2 h-2 rounded-full" id="preview-active-dot" style={`background-color: ${currentTheme.accent};`}></div>
                  <span class="text-xs font-semibold text-white">Overview</span>
                </div>
                <span 
                  id="preview-active-badge"
                  class="text-[10px] font-bold px-1.5 py-0.2 rounded-md"
                  style={`background-color: ${currentTheme.accent}; color: ${currentTheme.navBg};`}
                >
                  Active
                </span>
              </div>
            </div>

            <!-- Mini Tenant Mobile App Balance Card Preview -->
            <div 
              id="preview-tenant-card" 
              class="rounded-2xl p-4 text-white transition-all shadow-md relative overflow-hidden"
              style={`background-color: ${currentTheme.primary};`}
            >
              <div 
                id="preview-card-ring"
                class="absolute -right-6 -top-6 w-24 h-24 rounded-full pointer-events-none"
                style={`border: 2px solid ${currentTheme.accent}33;`}
              ></div>

              <div class="flex items-center justify-between mb-1.5">
                <span class="text-[11px] font-medium text-white/80">Balance due</span>
                <span 
                  id="preview-tenant-status-pill"
                  class="text-[10px] font-semibold px-2 py-0.5 rounded-full border"
                  style={`background-color: ${currentTheme.navBg}B3; border-color: ${currentTheme.accent}59; color: ${currentTheme.accent};`}
                >
                  October bill
                </span>
              </div>

              <div class="text-2xl font-normal font-editorial tracking-tight mb-2">KES 25,000</div>

              <!-- Progress bar -->
              <div 
                id="preview-progress-track"
                class="w-full h-1.5 rounded-full overflow-hidden mb-3"
                style={`background-color: ${currentTheme.navBg}80;`}
              >
                <div 
                  id="preview-progress-bar"
                  class="h-full w-3/4 rounded-full"
                  style={`background-color: ${currentTheme.accent};`}
                ></div>
              </div>

              <!-- Button -->
              <button 
                type="button"
                id="preview-tenant-btn"
                class="w-full py-1.5 rounded-xl font-semibold text-xs flex items-center justify-center transition-all cursor-default"
                style={`background-color: ${currentTheme.accent}; color: ${currentTheme.navBg};`}
              >
                Pay rent
              </button>
            </div>
          </div>
        </div>
      </section>

      <section class={`${card} lg:col-span-2`}>
        <div class="mb-4">
          <h2 class="font-editorial text-2xl text-[#0D382B]">Apartment payment details</h2>
          <p class="text-xs text-[#69847A] mt-1">
            Configure dedicated Paybill or bank accounts per property. Leave fields blank to inherit company defaults.
          </p>
        </div>

        <div class="space-y-3">
          {propertyViews.map((pv) => {
            const p = pv.property;
            const hasCustom = Boolean(p.mpesaPaybill || p.bankAccount || p.bankName);
            const isOpen = false;
            return (
              <div 
                class="rounded-2xl border border-[#E3E6DF] bg-[#FAFBF9] overflow-hidden transition-all shadow-2xs hover:border-[#69847A]/40" 
                data-property-payment={p.id}
              >
                <button
                  type="button"
                  class="w-full p-4 sm:p-4.5 flex items-center justify-between gap-3 text-left hover:bg-[#F2F4EF]/70 transition-colors cursor-pointer select-none"
                  data-toggle-property={p.id}
                  aria-expanded={isOpen ? "true" : "false"}
                >
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="text-sm font-semibold text-[#0D382B]">{p.name}</h3>
                      <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-md bg-[#EBF0EC] text-[#0D382B]">
                        {pv.typeLabel}
                      </span>
                    </div>
                    <p class="text-[11px] text-[#69847A] mt-0.5">
                      Account prefix {p.accountPrefix} · {hasCustom ? `Paybill ${p.mpesaPaybill || 'default'} · ${p.bankName || 'Bank default'}` : 'Inheriting company defaults'}
                    </p>
                  </div>

                  <div class="flex items-center gap-2.5 flex-shrink-0">
                    <span class={`text-[11px] font-medium px-2.5 py-1 rounded-full border ${hasCustom ? 'bg-[#EBF7EE] text-[#1E743A] border-[#C3E8CC]' : 'bg-white text-[#5A6862] border-[#E2E5DF]'}`}>
                      {hasCustom ? 'Custom active' : 'Company defaults'}
                    </span>
                    <div class={`w-7 h-7 rounded-full bg-white border border-[#E2E5DF] flex items-center justify-center text-[#5A6862] transition-transform duration-200 data-chevron ${isOpen ? 'rotate-180' : ''}`}>
                      <ChevronDown class="w-3.5 h-3.5" />
                    </div>
                  </div>
                </button>

                <!-- Collapsible body -->
                <div class={`${isOpen ? '' : 'hidden '}border-t border-[#E8ECE5] p-4.5 bg-white data-property-body`}>
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div>
                      <label for={`p-paybill-${p.id}`} class={label}>M-Pesa Paybill</label>
                      <input
                        id={`p-paybill-${p.id}`}
                        data-prop-id={p.id}
                        data-prop-field="mpesaPaybill"
                        class={`${input} bg-[#FAFBF9] tabular-nums`}
                        value={p.mpesaPaybill ?? ''}
                        placeholder={company.mpesaPaybill || 'Company default'}
                        inputmode="numeric"
                        maxlength="7"
                      />
                      <p class={hint}>Leave empty to use {company.mpesaPaybill || 'company default'}.</p>
                    </div>
                    <div>
                      <label for={`p-bank-${p.id}`} class={label}>Bank name & branch</label>
                      <input
                        id={`p-bank-${p.id}`}
                        data-prop-id={p.id}
                        data-prop-field="bankName"
                        class={`${input} bg-[#FAFBF9]`}
                        value={p.bankName ?? ''}
                        placeholder={company.bankName || 'Company default'}
                        maxlength="80"
                      />
                      <p class={hint}>Leave empty to use {company.bankName || 'company default'}.</p>
                    </div>
                    <div>
                      <label for={`p-account-${p.id}`} class={label}>Bank account</label>
                      <input
                        id={`p-account-${p.id}`}
                        data-prop-id={p.id}
                        data-prop-field="bankAccount"
                        class={`${input} bg-[#FAFBF9] tabular-nums`}
                        value={p.bankAccount ?? ''}
                        placeholder={company.bankAccount || 'Company default'}
                        inputmode="numeric"
                        maxlength="24"
                      />
                      <p class={hint}>Leave empty to use {company.bankAccount || 'company default'}.</p>
                    </div>
                    <div>
                      <label for={`p-pesalink-${p.id}`} class={label}>PesaLink phone / alias</label>
                      <input
                        id={`p-pesalink-${p.id}`}
                        data-prop-id={p.id}
                        data-prop-field="pesalinkPhone"
                        class={`${input} bg-[#FAFBF9] tabular-nums`}
                        value={company.settings?.propertyPayments?.[p.id]?.pesalinkPhone ?? ''}
                        placeholder={company.settings?.pesalinkPhone || 'Company default'}
                        inputmode="tel"
                        maxlength="15"
                      />
                      <p class={hint}>Leave empty to use {company.settings?.pesalinkPhone || 'company default'}.</p>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <section class={`${card} lg:col-span-2`}>
        <h2 class="font-editorial text-2xl text-[#0D382B] mb-4">Billing rules</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div>
            <label for="s-due" class={label}>Rent due (day of month)</label>
            <input id="s-due" name="dueDay" type="number" min="1" max="28" class={`${input} tabular-nums`} value={settings.dueDay} required />
          </div>
          <div>
            <label for="s-grace" class={label}>Grace period ends (day)</label>
            <input id="s-grace" name="graceDay" type="number" min="1" max="28" class={`${input} tabular-nums`} value={settings.graceDay} required />
            <p class={hint}>Overdue after this day.</p>
          </div>
          <div>
            <label for="s-retention" class={label}>Former tenants' records (months)</label>
            <input id="s-retention" name="recordRetentionMonths" type="number" min="1" max="24" class={`${input} tabular-nums`} value={settings.recordRetentionMonths} required />
            <p class={hint}>How long they can still see statements after move-out.</p>
          </div>
          <div>
            <span class={label}>Move-in rent</span>
            <p class={fixed}>Days left in the month</p>
          </div>
          {depositRows.map(([beds, amount]) => (
            <div>
              <label for={`s-deposit-${beds}`} class={label}>Deposit · {bedLabel(Number(beds))} (KES)</label>
              <input id={`s-deposit-${beds}`} name={`deposit-${beds}`} data-beds={beds} type="number" min="0" step="500" class={`${input} tabular-nums`} value={amount} required />
            </div>
          ))}
        </div>
        <p class={`${hint} mt-4`}>
          Due and grace days apply to every bill, including this month's. Deposits apply to tenants onboarded after you save.
        </p>
      </section>

      <section class={`${card} lg:col-span-2 bg-[#F8F9F6] border-[#DCE0D7]`}>
        <div class="flex items-center justify-between mb-4">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="font-editorial text-2xl text-[#0D382B]">Makazi Partnership Plan</h2>
              <span class="px-2.5 py-0.5 rounded-full bg-[#0D382B] text-[#C6EE58] text-[10px] font-bold uppercase tracking-wider">
                Founding Landlord Partner
              </span>
            </div>
            <p class="text-xs text-[#5A6862] mt-1">
              Active cohort program for property managers and landlords scaling with Makazi.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-2xl bg-white border border-[#E3E6DF]">
            <span class="text-[10px] uppercase font-bold text-[#69847A] block">Current Pilot Status</span>
            <span class="text-base font-semibold text-[#0A6B48] mt-1 block">100% Free Pilot Access</span>
            <p class="text-[11px] text-[#73827C] mt-1">Zero per-unit or onboarding fees during your cohort pilot.</p>
          </div>
          <div class="p-4 rounded-2xl bg-white border border-[#E3E6DF]">
            <span class="text-[10px] uppercase font-bold text-[#69847A] block">Concierge Onboarding</span>
            <span class="text-base font-semibold text-[#0D382B] mt-1 block">Full Excel / CSV Support</span>
            <p class="text-[11px] text-[#73827C] mt-1">Direct assistance importing 50–500 units with tenant history.</p>
          </div>
          <div class="p-4 rounded-2xl bg-white border border-[#E3E6DF]">
            <span class="text-[10px] uppercase font-bold text-[#69847A] block">Marketplace Verification</span>
            <span class="text-base font-semibold text-[#0D382B] mt-1 block">Ask Nyumbani Priority</span>
            <p class="text-[11px] text-[#73827C] mt-1">Free listing verification and priority tenant exposure.</p>
          </div>
        </div>
      </section>
    </fieldset>

    {canEdit && (
      <div class="mt-6 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-3">
        <p data-field="error" role="alert" class="hidden text-xs text-[#C04A26] sm:mr-auto"></p>
        <button type="reset" class="px-5 py-2.5 rounded-xl text-sm font-medium text-[#5A6862] hover:bg-[#F4F5F1] transition-colors cursor-pointer">
          Undo changes
        </button>
        <button type="submit" data-field="submit" class="px-6 py-2.5 rounded-xl text-sm font-semibold bg-[#0D382B] text-white hover:bg-[#154637] transition-all shadow-md cursor-pointer disabled:opacity-60">
          Save changes
        </button>
      </div>
    )}
  </form>
</DashboardLayout>

<script>
  import { setBusy } from '../lib/busy';

  function initSettingsPage() {
    const form = document.getElementById('settings-form') as HTMLFormElement | null;
    // Page loads come back through view transitions: bind once per form.
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';
    const error = form.querySelector<HTMLElement>('[data-field="error"]');
    const submit = form.querySelector<HTMLButtonElement>('[data-field="submit"]');
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? '';
    const showError = (message: string | null) => {
      if (!error) return;
      error.textContent = message ?? '';
      error.classList.toggle('hidden', !message);
    };
    form.addEventListener('reset', () => showError(null));

    // Property accordion toggle: strictly single open card at a time
    const propertyButtons = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-toggle-property]'));
    propertyButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const card = btn.closest<HTMLElement>('[data-property-payment]');
        if (!card) return;
        const body = card.querySelector<HTMLElement>('.data-property-body');
        const chevron = btn.querySelector<HTMLElement>('.data-chevron');
        if (!body) return;

        const wasExpanded = btn.getAttribute('aria-expanded') === 'true';

        // Collapse all other property cards
        propertyButtons.forEach((otherBtn) => {
          const otherCard = otherBtn.closest<HTMLElement>('[data-property-payment]');
          const otherBody = otherCard?.querySelector<HTMLElement>('.data-property-body');
          const otherChevron = otherBtn.querySelector<HTMLElement>('.data-chevron');
          otherBtn.setAttribute('aria-expanded', 'false');
          if (otherBody) otherBody.classList.add('hidden');
          if (otherChevron) otherChevron.classList.remove('rotate-180');
        });

        // Expand clicked card if it was closed
        if (!wasExpanded) {
          btn.setAttribute('aria-expanded', 'true');
          body.classList.remove('hidden');
          if (chevron) chevron.classList.add('rotate-180');
        }
      });
    });

    // Theme preset and live color synchronization
    const presetButtons = form.querySelectorAll<HTMLButtonElement>('.theme-preset-btn');
    const presetInput = form.querySelector<HTMLInputElement>('#theme-preset-input');
    const presetBadge = document.getElementById('theme-active-preset-badge');

    const primaryPicker = form.querySelector<HTMLInputElement>('#theme-primary-picker');
    const primaryInput = form.querySelector<HTMLInputElement>('#theme-primary-input');
    const navBgPicker = form.querySelector<HTMLInputElement>('#theme-navbg-picker');
    const navBgInput = form.querySelector<HTMLInputElement>('#theme-navbg-input');
    const accentPicker = form.querySelector<HTMLInputElement>('#theme-accent-picker');
    const accentInput = form.querySelector<HTMLInputElement>('#theme-accent-input');

    const previewSidebar = document.getElementById('preview-admin-sidebar');
    const previewSidebarEmblem = document.getElementById('preview-sidebar-emblem');
    const previewSidebarPill = document.getElementById('preview-sidebar-pill');
    const previewActiveNavItem = document.getElementById('preview-active-nav-item');
    const previewActiveDot = document.getElementById('preview-active-dot');
    const previewActiveBadge = document.getElementById('preview-active-badge');
    const previewTenantCard = document.getElementById('preview-tenant-card');
    const previewTenantStatusPill = document.getElementById('preview-tenant-status-pill');
    const previewProgressTrack = document.getElementById('preview-progress-track');
    const previewProgressBar = document.getElementById('preview-progress-bar');
    const previewTenantBtn = document.getElementById('preview-tenant-btn');

    const updateLivePreview = (primary: string, navBg: string, accent: string) => {
      if (previewSidebar) previewSidebar.style.backgroundColor = navBg;
      if (previewSidebarEmblem) previewSidebarEmblem.style.background = `linear-gradient(135deg, ${accent}, ${primary})`;
      if (previewSidebarPill) {
        previewSidebarPill.style.backgroundColor = `${accent}26`;
        previewSidebarPill.style.borderColor = `${accent}4D`;
        previewSidebarPill.style.color = accent;
      }
      if (previewActiveNavItem) {
        previewActiveNavItem.style.background = `linear-gradient(to right, ${primary}, ${navBg})`;
        previewActiveNavItem.style.borderColor = `${accent}80`;
      }
      if (previewActiveDot) previewActiveDot.style.backgroundColor = accent;
      if (previewActiveBadge) {
        previewActiveBadge.style.backgroundColor = accent;
        previewActiveBadge.style.color = navBg;
      }
      if (previewTenantCard) previewTenantCard.style.backgroundColor = primary;
      if (previewTenantStatusPill) {
        previewTenantStatusPill.style.backgroundColor = `${navBg}B3`;
        previewTenantStatusPill.style.borderColor = `${accent}59`;
        previewTenantStatusPill.style.color = accent;
      }
      if (previewProgressTrack) previewProgressTrack.style.backgroundColor = `${navBg}80`;
      if (previewProgressBar) previewProgressBar.style.backgroundColor = accent;
      if (previewTenantBtn) {
        previewTenantBtn.style.backgroundColor = accent;
        previewTenantBtn.style.color = navBg;
      }
    };

    presetButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const pId = btn.dataset.presetId!;
        const pPrimary = btn.dataset.primary!;
        const pNavBg = btn.dataset.navBg!;
        const pAccent = btn.dataset.accent!;

        if (presetInput) presetInput.value = pId;
        if (presetBadge) presetBadge.textContent = pId;

        if (primaryPicker) primaryPicker.value = pPrimary;
        if (primaryInput) primaryInput.value = pPrimary;
        if (navBgPicker) navBgPicker.value = pNavBg;
        if (navBgInput) navBgInput.value = pNavBg;
        if (accentPicker) accentPicker.value = pAccent;
        if (accentInput) accentInput.value = pAccent;

        presetButtons.forEach((b) => {
          b.classList.remove('border-[#0D382B]', 'bg-[#F7F9F6]', 'shadow-xs', 'ring-1', 'ring-[#0D382B]');
          b.classList.add('border-[#E3E6DF]', 'bg-[#FAFBF9]');
        });
        btn.classList.remove('border-[#E3E6DF]', 'bg-[#FAFBF9]');
        btn.classList.add('border-[#0D382B]', 'bg-[#F7F9F6]', 'shadow-xs', 'ring-1', 'ring-[#0D382B]');

        updateLivePreview(pPrimary, pNavBg, pAccent);
      });
    });

    const bindColorPair = (picker: HTMLInputElement | null, textIn: HTMLInputElement | null) => {
      if (!picker || !textIn) return;
      const onColorChange = () => {
        if (presetInput) presetInput.value = 'custom';
        if (presetBadge) presetBadge.textContent = 'custom';
        presetButtons.forEach((b) => {
          b.classList.remove('border-[#0D382B]', 'bg-[#F7F9F6]', 'shadow-xs', 'ring-1', 'ring-[#0D382B]');
          b.classList.add('border-[#E3E6DF]', 'bg-[#FAFBF9]');
        });
        updateLivePreview(primaryInput?.value || '#0A2540', navBgInput?.value || '#081B2E', accentInput?.value || '#38BDF8');
      };
      picker.addEventListener('input', () => {
        textIn.value = picker.value.toUpperCase();
        onColorChange();
      });
      textIn.addEventListener('input', () => {
        if (/^#[0-9A-Fa-f]{6}$/.test(textIn.value.trim())) {
          picker.value = textIn.value.trim();
        }
        onColorChange();
      });
    };

    bindColorPair(primaryPicker, primaryInput);
    bindColorPair(navBgPicker, navBgInput);
    bindColorPair(accentPicker, accentInput);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!submit) return;
      const depositSchedule: Record<string, string> = {};
      form.querySelectorAll<HTMLInputElement>('input[data-beds]').forEach((el) => {
        depositSchedule[el.dataset.beds!] = el.value;
      });

      const propertyPayments: Array<{ propertyId: string; mpesaPaybill: string; bankName: string; bankAccount: string; pesalinkPhone: string }> = [];
      form.querySelectorAll<HTMLElement>('[data-property-payment]').forEach((el) => {
        const propId = el.dataset.propertyPayment!;
        const paybill = (el.querySelector<HTMLInputElement>('[data-prop-field="mpesaPaybill"]'))?.value ?? '';
        const bankName = (el.querySelector<HTMLInputElement>('[data-prop-field="bankName"]'))?.value ?? '';
        const bankAccount = (el.querySelector<HTMLInputElement>('[data-prop-field="bankAccount"]'))?.value ?? '';
        const pesalinkPhone = (el.querySelector<HTMLInputElement>('[data-prop-field="pesalinkPhone"]'))?.value ?? '';
        propertyPayments.push({
          propertyId: propId,
          mpesaPaybill: paybill,
          bankName,
          bankAccount,
          pesalinkPhone,
        });
      });

      showError(null);
      const restoreSubmit = setBusy(submit, 'Saving…');
      try {
        // The server checks every field; nothing shows as saved until it has.
        const res = await fetch('/api/update-settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: value('name'),
            kraPin: value('kraPin'),
            mpesaPaybill: value('mpesaPaybill'),
            bankName: value('bankName'),
            bankAccount: value('bankAccount'),
            dueDay: value('dueDay'),
            graceDay: value('graceDay'),
            recordRetentionMonths: value('recordRetentionMonths'),
            mpesaSimulation: (form.elements.namedItem('mpesaSimulation') as HTMLInputElement | null)?.checked ?? false,
            depositSchedule,
            propertyPayments,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.error) throw new Error(data.error || 'Could not save settings');
        window.makaziUi?.showToast('Settings saved', 'Theme and details updated across dashboard and tenant app.');
        setTimeout(() => window.location.reload(), 800);
      } catch (err: unknown) {
        restoreSubmit();
        showError(err instanceof Error ? err.message : String(err));
      }
    });
  }

  document.addEventListener('astro:page-load', initSettingsPage);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initSettingsPage();
  } else {
    document.addEventListener('DOMContentLoaded', initSettingsPage);
  }
</script>
