---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { bedLabel, getPortfolio, monthLabel } from '../data/portfolio';
import { ChevronDown } from '@lucide/astro';

// This company's data only (the signed-in user's).
const { company, propertyViews, portfolioSummary } = await getPortfolio(Astro.locals.user!.companyId, Astro.cookies);
const { settings } = company;
const canEdit = Astro.locals.user!.role === 'owner';
const depositRows = Object.entries(settings.depositSchedule).sort(([a], [b]) => Number(a) - Number(b));

// The Makazi plan is managed by Codzure in the super-admin portal, not here.

const card = 'bg-white rounded-3xl border border-[#E3E6DF] p-6 shadow-xs';
const label = 'block text-[11px] font-semibold uppercase tracking-wider text-[#69847A] mb-1.5';
const input =
  'w-full px-3.5 py-2.5 rounded-xl border border-[#E2E5DF] bg-[#FAFBF9] text-sm font-semibold text-[#0D382B] focus:outline-none focus:border-[#0D382B] disabled:bg-[#F3F4F0] disabled:text-[#5A6862]';
const hint = 'text-[11px] text-[#73827C] mt-1';
const fixed = 'text-sm font-semibold text-[#0D382B] mt-0.5';
---

<DashboardLayout title={`Makazi — Settings`} currentPath="/settings">
  <div class="mb-8">
    <span class="text-xs font-semibold tracking-wider text-[#69847A] uppercase">{portfolioSummary}</span>
    <h1 class="text-3xl sm:text-4xl font-normal font-editorial text-[#0D382B] tracking-tight mt-1">Settings</h1>
    <p class="text-xs text-[#69847A] mt-2">
      {canEdit
        ? 'Tenants see these in the Makazi app as soon as you save.'
        : 'Only the owner can change these.'}
    </p>
  </div>

  <form id="settings-form" novalidate>
    <fieldset disabled={!canEdit} class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <section class={card}>
        <h2 class="font-editorial text-2xl text-[#0D382B] mb-4">Company</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label for="s-name" class={label}>Name</label>
            <input id="s-name" name="name" class={input} value={company.name} maxlength="120" required />
            <p class={hint}>On every screen of the app, receipts and statements.</p>
          </div>
          <div>
            <label for="s-kra" class={label}>KRA PIN</label>
            <input id="s-kra" name="kraPin" class={`${input} uppercase font-mono`} value={company.kraPin} maxlength="11" required />
            <p class={hint}>Printed on receipts.</p>
          </div>
          <div>
            <span class={label}>Company ID</span>
            <p class={`${fixed} font-mono`}>{company.slug}</p>
            <p class={hint}>On Makazi since {monthLabel(settings.ledgerStartMonth)}.</p>
          </div>
        </div>
      </section>

      <section class={card}>
        <h2 class="font-editorial text-2xl text-[#0D382B] mb-4">Payments</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="s-paybill" class={label}>M-Pesa Paybill</label>
            <input id="s-paybill" name="mpesaPaybill" class={`${input} tabular-nums`} value={company.mpesaPaybill} inputmode="numeric" maxlength="7" required />
            <p class={hint}>Shown on Pay rent in the app.</p>
          </div>
          <div>
            <span class={label}>Account number</span>
            <p class={fixed}>Unit code, e.g. RC-5A</p>
            <p class={hint}>Each tenant's own, set by their unit.</p>
          </div>
          <div>
            <label for="s-bank" class={label}>Bank</label>
            <input id="s-bank" name="bankName" class={input} value={company.bankName} maxlength="80" required />
          </div>
          <div>
            <label for="s-account" class={label}>Bank account</label>
            <input id="s-account" name="bankAccount" class={`${input} tabular-nums`} value={company.bankAccount} inputmode="numeric" maxlength="24" required />
            <p class={hint}>Shown for bank transfers in the app.</p>
          </div>
          <label for="s-mpesa-test" class="sm:col-span-2 flex items-start gap-3 rounded-2xl border border-[#FFE082] bg-[#FFF8E1]/60 p-3.5 cursor-pointer">
            <input id="s-mpesa-test" name="mpesaSimulation" type="checkbox" checked={settings.mpesaSimulation === true} class="mt-0.5 h-4 w-4 accent-[#0D382B] cursor-pointer" />
            <span>
              <span class="block text-sm font-semibold text-[#0D382B]">M-Pesa test mode</span>
              <span class="block text-[11px] text-[#5A6862] mt-0.5 leading-relaxed">
                Tenants' Pay now runs a simulated M-Pesa request and records a <strong>test payment</strong>
                that counts towards their balance, labelled "Test" everywhere. No money moves.
                Turn it off before tenants pay for real; real STK push needs M-Pesa Daraja.
              </span>
            </span>
          </label>
        </div>
      </section>

      <section class={`${card} lg:col-span-2`}>
        <div class="mb-4">
          <h2 class="font-editorial text-2xl text-[#0D382B]">Apartment payment details</h2>
          <p class="text-xs text-[#69847A] mt-1">
            Configure dedicated Paybill or bank accounts per property. Leave fields blank to inherit company defaults.
          </p>
        </div>

        <div class="space-y-3">
          {propertyViews.map((pv) => {
            const p = pv.property;
            const hasCustom = Boolean(p.mpesaPaybill || p.bankAccount || p.bankName);
            const isOpen = false;
            return (
              <div 
                class="rounded-2xl border border-[#E3E6DF] bg-[#FAFBF9] overflow-hidden transition-all shadow-2xs hover:border-[#69847A]/40" 
                data-property-payment={p.id}
              >
                <button
                  type="button"
                  class="w-full p-4 sm:p-4.5 flex items-center justify-between gap-3 text-left hover:bg-[#F2F4EF]/70 transition-colors cursor-pointer select-none"
                  data-toggle-property={p.id}
                  aria-expanded={isOpen ? "true" : "false"}
                >
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="text-sm font-semibold text-[#0D382B]">{p.name}</h3>
                      <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-md bg-[#EBF0EC] text-[#0D382B]">
                        {pv.typeLabel}
                      </span>
                    </div>
                    <p class="text-[11px] text-[#69847A] mt-0.5">
                      Account prefix {p.accountPrefix} · {hasCustom ? `Paybill ${p.mpesaPaybill || 'default'} · ${p.bankName || 'Bank default'}` : 'Inheriting company defaults'}
                    </p>
                  </div>

                  <div class="flex items-center gap-2.5 flex-shrink-0">
                    <span class={`text-[11px] font-medium px-2.5 py-1 rounded-full border ${hasCustom ? 'bg-[#EBF7EE] text-[#1E743A] border-[#C3E8CC]' : 'bg-white text-[#5A6862] border-[#E2E5DF]'}`}>
                      {hasCustom ? 'Custom active' : 'Company defaults'}
                    </span>
                    <div class={`w-7 h-7 rounded-full bg-white border border-[#E2E5DF] flex items-center justify-center text-[#5A6862] transition-transform duration-200 data-chevron ${isOpen ? 'rotate-180' : ''}`}>
                      <ChevronDown class="w-3.5 h-3.5" />
                    </div>
                  </div>
                </button>

                <!-- Collapsible body -->
                <div class={`${isOpen ? '' : 'hidden '}border-t border-[#E8ECE5] p-4.5 bg-white data-property-body`}>
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                      <label for={`p-paybill-${p.id}`} class={label}>M-Pesa Paybill</label>
                      <input
                        id={`p-paybill-${p.id}`}
                        data-prop-id={p.id}
                        data-prop-field="mpesaPaybill"
                        class={`${input} bg-[#FAFBF9] tabular-nums`}
                        value={p.mpesaPaybill ?? ''}
                        placeholder={company.mpesaPaybill || 'Company default'}
                        inputmode="numeric"
                        maxlength="7"
                      />
                      <p class={hint}>Leave empty to use {company.mpesaPaybill || 'company default'}.</p>
                    </div>
                    <div>
                      <label for={`p-bank-${p.id}`} class={label}>Bank name & branch</label>
                      <input
                        id={`p-bank-${p.id}`}
                        data-prop-id={p.id}
                        data-prop-field="bankName"
                        class={`${input} bg-[#FAFBF9]`}
                        value={p.bankName ?? ''}
                        placeholder={company.bankName || 'Company default'}
                        maxlength="80"
                      />
                      <p class={hint}>Leave empty to use {company.bankName || 'company default'}.</p>
                    </div>
                    <div>
                      <label for={`p-account-${p.id}`} class={label}>Bank account</label>
                      <input
                        id={`p-account-${p.id}`}
                        data-prop-id={p.id}
                        data-prop-field="bankAccount"
                        class={`${input} bg-[#FAFBF9] tabular-nums`}
                        value={p.bankAccount ?? ''}
                        placeholder={company.bankAccount || 'Company default'}
                        inputmode="numeric"
                        maxlength="24"
                      />
                      <p class={hint}>Leave empty to use {company.bankAccount || 'company default'}.</p>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <section class={`${card} lg:col-span-2`}>
        <h2 class="font-editorial text-2xl text-[#0D382B] mb-4">Billing rules</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div>
            <label for="s-due" class={label}>Rent due (day of month)</label>
            <input id="s-due" name="dueDay" type="number" min="1" max="28" class={`${input} tabular-nums`} value={settings.dueDay} required />
          </div>
          <div>
            <label for="s-grace" class={label}>Grace period ends (day)</label>
            <input id="s-grace" name="graceDay" type="number" min="1" max="28" class={`${input} tabular-nums`} value={settings.graceDay} required />
            <p class={hint}>Overdue after this day.</p>
          </div>
          <div>
            <label for="s-retention" class={label}>Former tenants' records (months)</label>
            <input id="s-retention" name="recordRetentionMonths" type="number" min="1" max="24" class={`${input} tabular-nums`} value={settings.recordRetentionMonths} required />
            <p class={hint}>How long they can still see statements after move-out.</p>
          </div>
          <div>
            <span class={label}>Move-in rent</span>
            <p class={fixed}>Days left in the month</p>
          </div>
          {depositRows.map(([beds, amount]) => (
            <div>
              <label for={`s-deposit-${beds}`} class={label}>Deposit · {bedLabel(Number(beds))} (KES)</label>
              <input id={`s-deposit-${beds}`} name={`deposit-${beds}`} data-beds={beds} type="number" min="0" step="500" class={`${input} tabular-nums`} value={amount} required />
            </div>
          ))}
        </div>
        <p class={`${hint} mt-4`}>
          Due and grace days apply to every bill, including this month's. Deposits apply to tenants onboarded after you save.
        </p>
      </section>
    </fieldset>

    {canEdit && (
      <div class="mt-6 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-3">
        <p data-field="error" role="alert" class="hidden text-xs text-[#C04A26] sm:mr-auto"></p>
        <button type="reset" class="px-5 py-2.5 rounded-xl text-sm font-medium text-[#5A6862] hover:bg-[#F4F5F1] transition-colors cursor-pointer">
          Undo changes
        </button>
        <button type="submit" data-field="submit" class="px-6 py-2.5 rounded-xl text-sm font-semibold bg-[#0D382B] text-white hover:bg-[#154637] transition-all shadow-md cursor-pointer disabled:opacity-60">
          Save changes
        </button>
      </div>
    )}
  </form>
</DashboardLayout>

<script>
  import { setBusy } from '../lib/busy';

  function initSettingsPage() {
    const form = document.getElementById('settings-form') as HTMLFormElement | null;
    // Page loads come back through view transitions: bind once per form.
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';
    const error = form.querySelector<HTMLElement>('[data-field="error"]');
    const submit = form.querySelector<HTMLButtonElement>('[data-field="submit"]');
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? '';
    const showError = (message: string | null) => {
      if (!error) return;
      error.textContent = message ?? '';
      error.classList.toggle('hidden', !message);
    };
    form.addEventListener('reset', () => showError(null));

    // Property accordion toggle: strictly single open card at a time
    const propertyButtons = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-toggle-property]'));
    propertyButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const card = btn.closest<HTMLElement>('[data-property-payment]');
        if (!card) return;
        const body = card.querySelector<HTMLElement>('.data-property-body');
        const chevron = btn.querySelector<HTMLElement>('.data-chevron');
        if (!body) return;

        const wasExpanded = btn.getAttribute('aria-expanded') === 'true';

        // Collapse all other property cards
        propertyButtons.forEach((otherBtn) => {
          const otherCard = otherBtn.closest<HTMLElement>('[data-property-payment]');
          const otherBody = otherCard?.querySelector<HTMLElement>('.data-property-body');
          const otherChevron = otherBtn.querySelector<HTMLElement>('.data-chevron');
          otherBtn.setAttribute('aria-expanded', 'false');
          if (otherBody) otherBody.classList.add('hidden');
          if (otherChevron) otherChevron.classList.remove('rotate-180');
        });

        // Expand clicked card if it was closed
        if (!wasExpanded) {
          btn.setAttribute('aria-expanded', 'true');
          body.classList.remove('hidden');
          if (chevron) chevron.classList.add('rotate-180');
        }
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!submit) return;
      const depositSchedule: Record<string, string> = {};
      form.querySelectorAll<HTMLInputElement>('input[data-beds]').forEach((el) => {
        depositSchedule[el.dataset.beds!] = el.value;
      });

      const propertyPayments: Array<{ propertyId: string; mpesaPaybill: string; bankName: string; bankAccount: string }> = [];
      form.querySelectorAll<HTMLElement>('[data-property-payment]').forEach((el) => {
        const propId = el.dataset.propertyPayment!;
        const paybill = (el.querySelector<HTMLInputElement>('[data-prop-field="mpesaPaybill"]'))?.value ?? '';
        const bankName = (el.querySelector<HTMLInputElement>('[data-prop-field="bankName"]'))?.value ?? '';
        const bankAccount = (el.querySelector<HTMLInputElement>('[data-prop-field="bankAccount"]'))?.value ?? '';
        propertyPayments.push({
          propertyId: propId,
          mpesaPaybill: paybill,
          bankName,
          bankAccount,
        });
      });

      showError(null);
      const restoreSubmit = setBusy(submit, 'Saving…');
      try {
        // The server checks every field; nothing shows as saved until it has.
        const res = await fetch('/api/update-settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: value('name'),
            kraPin: value('kraPin'),
            mpesaPaybill: value('mpesaPaybill'),
            bankName: value('bankName'),
            bankAccount: value('bankAccount'),
            dueDay: value('dueDay'),
            graceDay: value('graceDay'),
            recordRetentionMonths: value('recordRetentionMonths'),
            mpesaSimulation: (form.elements.namedItem('mpesaSimulation') as HTMLInputElement | null)?.checked ?? false,
            depositSchedule,
            propertyPayments,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.error) throw new Error(data.error || 'Could not save settings');
        window.makaziUi?.showToast('Settings saved', 'Tenants see the new details in the app.');
        setTimeout(() => window.location.reload(), 800);
      } catch (err: unknown) {
        restoreSubmit();
        showError(err instanceof Error ? err.message : String(err));
      }
    });
  }

  document.addEventListener('astro:page-load', initSettingsPage);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initSettingsPage();
  } else {
    document.addEventListener('DOMContentLoaded', initSettingsPage);
  }
</script>
