---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import HeroMetricsCard from '../components/dashboard/HeroMetricsCard.astro';
import KpiStack from '../components/dashboard/KpiStack.astro';
import PropertyCollectionsCard from '../components/dashboard/PropertyCollectionsCard.astro';
import RecentPaymentsCard from '../components/dashboard/RecentPaymentsCard.astro';
import ArrearsCard from '../components/dashboard/ArrearsCard.astro';
import LeasesActionCard from '../components/dashboard/LeasesActionCard.astro';
import { FEATURES } from '../config/features';
import GetStartedCard from '../components/dashboard/GetStartedCard.astro';
import { getPortfolio, monthLabel, selectableMonths, viewMonthFrom } from '../data/portfolio';
import { ChevronDown, Plus, Building2, ExternalLink } from '@lucide/astro';

// This company's data only (the signed-in user's).
const companyId = Astro.locals.user!.companyId;
const current = await getPortfolio(companyId, Astro.cookies);
// ?month=YYYY-MM shows the company as it stood at the end of that month.
const viewing = await getPortfolio(companyId, Astro.cookies, viewMonthFrom(Astro.url));
const months = selectableMonths(current);
const showGetStarted = !viewing.isPastMonth && !current.gettingStarted.hasBills;

const firstName = (Astro.locals.user?.name ?? 'there').split(' ')[0];
// Same greeting as the tenant app ("Habari, David").
const greeting = 'Habari';
---

<DashboardLayout title="Makazi — Portfolio Overview" currentPath="/">
  <!-- Top Greeting & Action Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-7">
    <div>
      <span class="text-xs font-semibold tracking-widest text-[#5A6862] uppercase">
        {greeting.toUpperCase()}, {firstName.toUpperCase()}
      </span>
      <h1 class="font-editorial text-4xl sm:text-5xl font-normal text-[#17231E] tracking-tight mt-1">
        Portfolio overview
      </h1>
    </div>

    <!-- Date selector & Primary Action -->
    <div class="flex items-center gap-3 self-start md:self-auto">
      <!-- Month filter: every card below follows it -->
      <label class="relative inline-flex items-center">
        <span class="sr-only">Show month</span>
        <select
          id="period-select"
          class="appearance-none pl-4 pr-9 py-2.5 rounded-2xl bg-white border border-[#E2E5DF] text-xs sm:text-sm font-medium text-[#17231E] shadow-sm hover:border-[#17231E] focus:outline-none focus:border-[#0D382B] transition-all cursor-pointer"
        >
          {months.map((m, i) => (
            <option value={i === 0 ? '' : m} selected={m === viewing.currentMonth}>
              {monthLabel(m)}{i === 0 ? ' (this month)' : ''}
            </option>
          ))}
        </select>
        <ChevronDown class="pointer-events-none absolute right-3 w-3.5 h-3.5 text-[#5A6862]" />
      </label>

      <!-- Onboard Tenant Action Button -->
      <button 
        type="button" 
        id="onboard-tenant-btn" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-[#0D382B] text-white text-xs sm:text-sm font-semibold hover:bg-[#154637] transition-all duration-200 shadow-md hover:shadow-lg cursor-pointer transform hover:-translate-y-0.5"
      >
        <Plus class="w-4 h-4 text-[#C6EE58]" />
        <span>Onboard tenant</span>
      </button>
    </div>
  </div>

  {viewing.isPastMonth && (
    <p class="mb-5 text-xs text-[#5A6862] bg-white border border-[#E2E5DF] rounded-2xl px-4 py-3">
      Showing {viewing.currentPeriod}: bills, payments and arrears as they stood on the last day of the month.
      <a href="/" class="font-semibold text-[#0D382B] underline ml-1">Back to this month</a>
    </p>
  )}

  {showGetStarted && <GetStartedCard />}

  {current.vacancies.total > 0 && (
    <div class="mb-6 p-4 sm:p-5 rounded-3xl bg-gradient-to-r from-[#0C3227] via-[#0E3D2F] to-[#124B3A] text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border border-[#235848] shadow-sm">
      <div class="flex items-center gap-3.5">
        <div class="h-10 w-10 rounded-2xl bg-[#C6EE58] text-[#0A261F] flex items-center justify-center font-bold text-lg flex-shrink-0 shadow-md">
          <Building2 class="w-5 h-5 text-[#0A261F]" />
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-sm font-semibold tracking-tight text-white">
              {current.vacancies.total} Vacant {current.vacancies.total === 1 ? 'Unit' : 'Units'} across portfolio
            </span>
            <span class="px-2 py-0.5 rounded-full bg-[#C6EE58]/20 text-[#C6EE58] text-[10px] font-bold uppercase tracking-wider border border-[#C6EE58]/30">
              Ask Nyumbani Marketplace
            </span>
          </div>
          <p class="text-xs text-[#A1B8AD] mt-0.5">
            Fill your empty units with verified tenants on Ask Nyumbani. Reaching 50,000+ active home seekers.
          </p>
        </div>
      </div>
      <a
        href="https://play.google.com/store/apps/details?id=com.codzure.ask_nyumbani&pcampaignid=web_share"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-[#C6EE58] text-[#0A261F] hover:bg-[#D4F772] transition-colors shadow-sm flex-shrink-0"
      >
        <span>List on Google Play</span>
        <ExternalLink class="w-3.5 h-3.5" />
      </a>
    </div>
  )}

  <!-- Primary Metrics: full-width hero card, then the 3 KPIs in a row -->
  <div class="flex flex-col gap-6 mb-7">
    <HeroMetricsCard />
    <KpiStack />
  </div>

  <!-- Detailed Property & Operations Grid (2 Columns x 2 Rows) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Collection By Property -->
    <PropertyCollectionsCard />

    <!-- Recent Payments -->
    <RecentPaymentsCard />

    <!-- Largest Arrears (full width when leases are hidden) -->
    <div class={FEATURES.leases ? '' : 'lg:col-span-2'}>
      <ArrearsCard />
    </div>

    {FEATURES.leases && <LeasesActionCard />}
  </div>
</DashboardLayout>

<script>
  import { navigate } from 'astro:transitions/client';

  function initPeriodSelect() {
    const select = document.getElementById('period-select') as HTMLSelectElement | null;
    if (!select || select.dataset.bound) return;
    select.dataset.bound = 'true';
    select.addEventListener('change', () => navigate(select.value ? `/?month=${select.value}` : '/'));
  }

  document.addEventListener('astro:page-load', initPeriodSelect);
</script>
