---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import HeroMetricsCard from '../components/dashboard/HeroMetricsCard.astro';
import KpiStack from '../components/dashboard/KpiStack.astro';
import PropertyCollectionsCard from '../components/dashboard/PropertyCollectionsCard.astro';
import RecentPaymentsCard from '../components/dashboard/RecentPaymentsCard.astro';
import ArrearsCard from '../components/dashboard/ArrearsCard.astro';
import LeasesActionCard from '../components/dashboard/LeasesActionCard.astro';
import { FEATURES } from '../config/features';
import GetStartedCard from '../components/dashboard/GetStartedCard.astro';
import { getPortfolio, monthLabel, selectableMonths, viewMonthFrom } from '../data/portfolio';
import { ChevronDown, Plus, Sparkles, FileSpreadsheet, X } from '@lucide/astro';

// This company's data only (the signed-in user's).
const companyId = Astro.locals.user!.companyId;
const current = await getPortfolio(companyId, Astro.cookies);
// ?month=YYYY-MM shows the company as it stood at the end of that month.
const viewing = await getPortfolio(companyId, Astro.cookies, viewMonthFrom(Astro.url));
const months = selectableMonths(current);
const showGetStarted = !viewing.isPastMonth && !current.gettingStarted.hasBills;

const firstName = (Astro.locals.user?.name ?? 'there').split(' ')[0];
// Same greeting as the tenant app ("Habari, David").
const greeting = 'Habari';
---

<DashboardLayout title="Makazi — Portfolio Overview" currentPath="/">
  <!-- Top Greeting & Action Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-7">
    <div>
      <span class="text-xs font-semibold tracking-widest text-[#5A6862] uppercase">
        {greeting.toUpperCase()}, {firstName.toUpperCase()}
      </span>
      <h1 class="font-editorial text-4xl sm:text-5xl font-normal text-[#17231E] tracking-tight mt-1">
        Portfolio overview
      </h1>
    </div>

    <!-- Date selector & Primary Action -->
    <div class="flex items-center gap-3 self-start md:self-auto">
      <!-- Month filter: every card below follows it -->
      <label class="relative inline-flex items-center">
        <span class="sr-only">Show month</span>
        <select
          id="period-select"
          class="appearance-none pl-4 pr-9 py-2.5 rounded-2xl bg-white border border-[#E2E5DF] text-xs sm:text-sm font-medium text-[#17231E] shadow-sm hover:border-[#17231E] focus:outline-none focus:border-[#0D382B] transition-all cursor-pointer"
        >
          {months.map((m, i) => (
            <option value={i === 0 ? '' : m} selected={m === viewing.currentMonth}>
              {monthLabel(m)}{i === 0 ? ' (this month)' : ''}
            </option>
          ))}
        </select>
        <ChevronDown class="pointer-events-none absolute right-3 w-3.5 h-3.5 text-[#5A6862]" />
      </label>

      <!-- Onboard Tenant Action Button -->
      <button 
        type="button" 
        id="onboard-tenant-btn" 
        style="background-color: var(--color-brand-primary);"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl text-white text-xs sm:text-sm font-semibold hover:opacity-90 transition-all duration-200 shadow-md hover:shadow-lg cursor-pointer transform hover:-translate-y-0.5"
      >
        <Plus class="w-4 h-4" style="color: var(--color-brand-accent);" />
        <span>Onboard tenant</span>
      </button>
    </div>
  </div>

  <!-- Founding Landlord Programme Banner (slim & dismissible) -->
  <div id="pilot-banner" class="mb-5 px-4 py-3 rounded-2xl bg-gradient-to-r from-[#0D382B] via-[#0A261F] to-[#124233] text-white shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-3 border border-[#1b4b3b]">
    <div class="flex items-center gap-3 min-w-0">
      <div class="h-8 w-8 rounded-xl bg-[#C6EE58] text-[#0A261F] flex items-center justify-center shrink-0 font-bold">
        <Sparkles class="w-4 h-4 text-[#0A261F]" />
      </div>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="text-xs font-semibold text-white tracking-wide">Founding Landlord Partner</h2>
          <span class="px-2 py-0.5 rounded-full bg-[#C6EE58]/20 border border-[#C6EE58]/40 text-[#C6EE58] text-[10px] font-bold uppercase tracking-wider">
            Active Pilot
          </span>
          <span class="text-xs text-[#D1DCD6] hidden sm:inline">· Zero fees during pilot · Free bulk import & Ask Nyumbani listings</span>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-2 shrink-0 self-start md:self-auto">
      <a
        href="/properties?action=bulk-import"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#C6EE58] text-[#0A261F] text-xs font-semibold hover:bg-[#b8e248] transition-all cursor-pointer shadow-xs"
      >
        <FileSpreadsheet class="w-3.5 h-3.5 text-[#0A261F]" />
        <span>Bulk import</span>
      </a>
      <a
        href="/enquiries"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/15 text-white border border-white/20 text-xs font-semibold transition-all cursor-pointer"
      >
        <span>Leads</span>
      </a>
      <button
        type="button"
        id="dismiss-pilot-banner"
        aria-label="Dismiss pilot banner"
        title="Dismiss"
        class="p-1.5 rounded-lg text-[#D1DCD6] hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
      >
        <X class="w-4 h-4" />
      </button>
    </div>
  </div>
  <script is:inline>
    if (localStorage.getItem('makazi:pilot-banner-dismissed') === '1') {
      document.getElementById('pilot-banner')?.classList.add('hidden');
    }
  </script>

  {viewing.isPastMonth && (
    <p class="mb-5 text-xs text-[#5A6862] bg-white border border-[#E2E5DF] rounded-2xl px-4 py-3">
      Showing {viewing.currentPeriod}: bills, payments and arrears as they stood on the last day of the month.
      <a href="/" class="font-semibold text-[#0D382B] underline ml-1">Back to this month</a>
    </p>
  )}

  {showGetStarted && <GetStartedCard />}

  <!-- Primary Metrics: full-width hero card, then the 3 KPIs in a row -->
  <div class="flex flex-col gap-6 mb-7">
    <HeroMetricsCard />
    <KpiStack />
  </div>

  <!-- Detailed Property & Operations Grid (2 Columns x 2 Rows) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Collection By Property -->
    <PropertyCollectionsCard />

    <!-- Recent Payments -->
    <RecentPaymentsCard />

    <!-- Largest Arrears (full width when leases are hidden) -->
    <div class={FEATURES.leases ? '' : 'lg:col-span-2'}>
      <ArrearsCard />
    </div>

    {FEATURES.leases && <LeasesActionCard />}
  </div>
</DashboardLayout>

<script>
  import { navigate } from 'astro:transitions/client';

  function initOverviewPage() {
    const select = document.getElementById('period-select') as HTMLSelectElement | null;
    if (select && !select.dataset.bound) {
      select.dataset.bound = 'true';
      select.addEventListener('change', () => navigate(select.value ? `/?month=${select.value}` : '/'));
    }

    const banner = document.getElementById('pilot-banner');
    const dismissBtn = document.getElementById('dismiss-pilot-banner');
    if (banner && localStorage.getItem('makazi:pilot-banner-dismissed') === '1') {
      banner.classList.add('hidden');
    }
    if (dismissBtn && !dismissBtn.dataset.bound) {
      dismissBtn.dataset.bound = 'true';
      dismissBtn.addEventListener('click', () => {
        localStorage.setItem('makazi:pilot-banner-dismissed', '1');
        banner?.classList.add('hidden');
      });
    }
  }

  document.addEventListener('astro:page-load', initOverviewPage);
</script>
