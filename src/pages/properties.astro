---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import AddPropertyModal from '../components/dashboard/AddPropertyModal.astro';
import EditRatesModal from '../components/dashboard/EditRatesModal.astro';
import { getPortfolio, bedLabel, formatDate, formatKes, monthLabel } from '../data/portfolio';

const shortMonth = (m: string) => monthLabel(m).replace(/^(\w{3})\w*/, '$1');
import { Plus, ChevronDown, Image, ExternalLink } from '@lucide/astro';

// This company's data only (the signed-in user's).
const { portfolioSummary, propertyViews, currentPeriod } = await getPortfolio(Astro.locals.user!.companyId, Astro.cookies);
---

<DashboardLayout title="Makazi — Properties" currentPath="/properties">
  <!-- Header & Actions -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <span class="text-xs font-semibold tracking-wider text-[#69847A] uppercase">
        {portfolioSummary}
      </span>
      <h1 class="text-3xl sm:text-4xl font-normal font-editorial text-[#0D382B] tracking-tight mt-1">
        Properties
      </h1>
    </div>

    <div class="flex items-center gap-3 self-start md:self-auto">
      <!-- Period Selector -->
      <div class="relative inline-block">
        <button 
          type="button" 
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white border border-[#E3E6DF] text-xs font-semibold text-[#0D382B] shadow-xs hover:border-[#0D382B] transition-colors cursor-pointer"
        >
          <span>{currentPeriod}</span>
          <ChevronDown class="w-4 h-4 text-[#69847A]" />
        </button>
      </div>

      <!-- Add Property (Primary Action) -->
      <button 
        type="button" 
        id="add-property-btn"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#0D382B] text-white text-xs font-semibold hover:bg-[#08221A] transition-all shadow-xs cursor-pointer"
      >
        <div class="h-4 w-4 rounded-full bg-[#C6EE58] text-[#0A261F] flex items-center justify-center font-bold text-xs">
          <Plus class="w-3 h-3 stroke-[3]" />
        </div>
        <span>Add property</span>
      </button>
    </div>
  </div>

  <!-- Properties Grid -->
  {propertyViews.length === 0 ? (
    <div class="p-12 text-center bg-white rounded-3xl border border-[#E3E6DF] text-xs font-medium text-[#69847A] shadow-xs">
      No properties recorded in portfolio.
    </div>
  ) : (
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {propertyViews.map((p) => (
        <div class="bg-white rounded-3xl border border-[#E3E6DF] overflow-hidden flex flex-col shadow-xs hover:border-[#69847A]/50 transition-all">
          <div class="p-5 sm:p-6 flex gap-4 items-start">
            {p.property.imageUrl ? (
              <img src={p.property.imageUrl} alt={p.property.name} class="h-16 w-16 rounded-2xl object-cover flex-shrink-0 border border-[#E3E6DF] shadow-xs" />
            ) : (
              <div class="h-16 w-16 rounded-2xl bg-[#F8F9F6] border border-dashed border-[#D5DFD8] flex items-center justify-center text-[#69847A] flex-shrink-0" title={`Add a photo of ${p.property.name}`}>
                <Image class="w-5 h-5" />
              </div>
            )}
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-base font-semibold text-[#0D382B]">{p.property.name}</h2>
                <span class="px-2 py-0.5 rounded-md bg-[#EBF0EC] text-[10px] font-semibold uppercase tracking-wider text-[#0D382B]">{p.typeLabel}</span>
              </div>
              <p class="text-xs text-[#69847A] mt-0.5">{p.property.address}</p>
              <p class="text-[11px] text-[#69847A] mt-1.5 tabular-nums">
                Water {formatKes(p.property.waterRate)} / unit · Garbage {formatKes(p.property.garbageFee)} / month · Paybill account {p.property.accountPrefix}-[unit]
              </p>
              {p.rateHistory.length > 0 && (
                <p class="text-[11px] text-[#69847A] mt-0.5">
                  Billed at these rates since {shortMonth(p.rateHistory[p.rateHistory.length - 1].fromMonth)}
                  {p.rateHistory.length > 1 && ` · ${p.rateHistory.length - 1} earlier rate${p.rateHistory.length > 2 ? 's' : ''}`}
                </p>
              )}
              <button
                type="button"
                class="edit-rates-btn mt-2 text-[11px] font-semibold text-[#0D382B] hover:underline cursor-pointer"
                data-id={p.property.id}
                data-name={p.property.name}
                data-water={p.property.waterRate}
                data-garbage={p.property.garbageFee}
                data-history={JSON.stringify(p.rateHistory.map((r) => ({ ...r, label: r.fromMonth === r.toMonth ? monthLabel(r.fromMonth) : `${shortMonth(r.fromMonth)} – ${shortMonth(r.toMonth)}` })))}
              >
                Edit water & garbage rates
              </button>
            </div>
          </div>

          <!-- Metrics -->
          <div class="grid grid-cols-4 gap-2 px-5 sm:px-6 py-3 border-y border-[#E3E6DF] bg-[#F8F9F6]/60 tabular-nums">
            <div>
              <span class="text-[10px] uppercase font-semibold text-[#69847A] block">Units</span>
              <span class="text-sm font-semibold text-[#0D382B]">{p.units.length}</span>
            </div>
            <div>
              <span class="text-[10px] uppercase font-semibold text-[#69847A] block">Vacant</span>
              <span class={`text-sm font-semibold ${p.vacant ? 'text-[#C04A26]' : 'text-[#0D382B]'}`}>{p.vacant}</span>
            </div>
            <div>
              <span class="text-[10px] uppercase font-semibold text-[#69847A] block">Occupancy</span>
              <span class="text-sm font-semibold text-[#0D382B]">{p.occupancyRate}%</span>
            </div>
            <div>
              <span class="text-[10px] uppercase font-semibold text-[#69847A] block">{currentPeriod.split(' ')[0]} collected</span>
              <span class="text-sm font-semibold text-[#0D382B]">{p.collectionRate}%</span>
            </div>
          </div>

          <!-- Units Accordion Toggle -->
          <div class="border-b border-[#E3E6DF] flex-1 flex flex-col">
            <button
              type="button"
              class="w-full px-5 sm:px-6 py-2.5 bg-[#FBFDFB] hover:bg-[#F2F5EF] flex items-center justify-between text-xs font-semibold text-[#0D382B] transition-colors cursor-pointer select-none toggle-units-btn"
              data-prop-id={p.property.id}
              aria-expanded="false"
            >
              <span class="flex items-center gap-1.5">
                <span>Units breakdown</span>
                <span class="px-1.5 py-0.5 rounded-full bg-[#EBF0EC] text-[10px] font-semibold text-[#0D382B]">{p.units.length}</span>
              </span>
              <div class="flex items-center gap-1 text-[#69847A] text-[11px] font-medium">
                <span class="units-toggle-label">Show units</span>
                <ChevronDown class="w-3.5 h-3.5 transition-transform duration-200 units-chevron" />
              </div>
            </button>

            <!-- Units list -->
            <ul class="divide-y divide-[#EEF0EB] hidden units-list" data-units-for={p.property.id}>
              {p.units.length === 0 ? (
                <li class="px-5 sm:px-6 py-3 text-xs text-[#69847A] bg-white">
                  No units recorded for this property yet.
                </li>
              ) : (
                p.units.map((u) => (
                  <li class="px-5 sm:px-6 py-3 flex items-center justify-between gap-3 text-xs bg-white">
                    <div class="min-w-0">
                      <span class="font-semibold text-[#0D382B]">{u.unit.label}</span>
                      <span class="text-[10px] uppercase tracking-wider text-[#69847A]"> {bedLabel(u.unit.bedrooms)}</span>
                      {u.occupant ? (
                        <span class="text-[#69847A]"> · {u.occupant.tenant.name}</span>
                      ) : u.lastTenancy ? (
                        <span class="text-[#69847A]"> · last tenant {u.lastTenancy.tenant.name}, left {formatDate(u.lastTenancy.tenancy.moveOut!)}</span>
                      ) : null}
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0">
                      <StatusBadge status={u.occupant ? 'Occupied' : 'Vacant'} />
                      {!u.occupant && (
                        <a
                          href="https://play.google.com/store/apps/details?id=com.codzure.ask_nyumbani&pcampaignid=web_share"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-[#E6F5ED] text-[#0A6B48] hover:bg-[#D5EFE2] border border-[#BCE4D0] transition-colors"
                          title="List vacant unit on Ask Nyumbani marketplace"
                        >
                          <ExternalLink class="w-3 h-3" />
                          <span>List on Ask Nyumbani</span>
                        </a>
                      )}
                    </div>
                  </li>
                ))
              )}
            </ul>
          </div>

          <div class="p-4 flex gap-2">
            <a href={`/tenants?property=${p.property.id}`} class="flex-1 text-center py-2.5 px-4 rounded-full border border-[#E3E6DF] hover:border-[#0D382B] text-xs font-semibold text-[#0D382B] bg-[#F8F9F6] hover:bg-white transition-colors shadow-xs">
              Tenants
            </a>
            <a href={`/bills?property=${p.property.id}`} class="flex-1 text-center py-2.5 px-4 rounded-full border border-[#E3E6DF] hover:border-[#0D382B] text-xs font-semibold text-[#0D382B] bg-[#F8F9F6] hover:bg-white transition-colors shadow-xs">
              Bills
            </a>
          </div>
        </div>
      ))}
    </div>
  )}
  <AddPropertyModal />
  <EditRatesModal />
</DashboardLayout>

<script>
  function initPropertiesPage() {
    const allButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.toggle-units-btn'));

    allButtons.forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';

      btn.addEventListener('click', () => {
        const propId = btn.dataset.propId;
        const targetList = document.querySelector<HTMLElement>(`[data-units-for="${propId}"]`);
        const targetLabel = btn.querySelector<HTMLElement>('.units-toggle-label');
        const targetChevron = btn.querySelector<HTMLElement>('.units-chevron');
        if (!targetList) return;

        const wasExpanded = btn.getAttribute('aria-expanded') === 'true';

        // Collapse all cards so multiple cards are never open simultaneously
        const currentButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.toggle-units-btn'));
        currentButtons.forEach((otherBtn) => {
          const otherId = otherBtn.dataset.propId;
          const otherList = document.querySelector<HTMLElement>(`[data-units-for="${otherId}"]`);
          const otherLabel = otherBtn.querySelector<HTMLElement>('.units-toggle-label');
          const otherChevron = otherBtn.querySelector<HTMLElement>('.units-chevron');

          otherBtn.setAttribute('aria-expanded', 'false');
          if (otherList) otherList.classList.add('hidden');
          if (otherLabel) otherLabel.textContent = 'Show units';
          if (otherChevron) otherChevron.classList.remove('rotate-180');
        });

        // If the clicked card was not already open, expand it
        if (!wasExpanded) {
          btn.setAttribute('aria-expanded', 'true');
          targetList.classList.remove('hidden');
          if (targetLabel) targetLabel.textContent = 'Hide units';
          if (targetChevron) targetChevron.classList.add('rotate-180');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initPropertiesPage);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initPropertiesPage();
  } else {
    document.addEventListener('DOMContentLoaded', initPropertiesPage);
  }
</script>
