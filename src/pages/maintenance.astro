---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { getPortfolio, type TicketView } from '../data/portfolio';
import {
  ChevronDown,
  Wrench,
  X,
  Search,
  ChevronLeft,
  ChevronRight,
  Share2,
  Copy,
  Ban,
  Image as ImageIcon,
  Download,
  Plus,
  Eye,
  Upload,
} from '@lucide/astro';

// This company's data only (the signed-in user's).
const { portfolioSummary, repairBoard, currentPeriod } = await getPortfolio(Astro.locals.user!.companyId, Astro.cookies);
const voidedTickets = repairBoard.voided;

const columns: Array<{ title: string; items: TicketView[]; empty: string; action: string | null }> = [
  { title: 'Open', items: repairBoard.open, empty: 'No open tickets.', action: 'Assign & start' },
  { title: 'In progress', items: repairBoard.inProgress, empty: 'No tickets in progress.', action: 'Mark resolved' },
  { title: 'Resolved', items: repairBoard.resolved, empty: 'Nothing resolved yet.', action: null },
];

const totalTicketsCount = repairBoard.open.length + repairBoard.inProgress.length + repairBoard.resolved.length;

// "Thu 9 Oct, 2:00 pm" in Nairobi time, the way the app shows it.
const visitFormat = new Intl.DateTimeFormat('en-GB', {
  timeZone: 'Africa/Nairobi', weekday: 'short', day: 'numeric', month: 'short',
  hour: 'numeric', minute: '2-digit', hour12: true,
});
const visitLabel = (iso: string) => visitFormat.format(new Date(iso)).replace(' at ', ', ');
// 0712 345 678
const localPhone = (intl: string) => {
  const local = `0${intl.replace(/\D/g, '').slice(3)}`;
  return `${local.slice(0, 4)} ${local.slice(4, 7)} ${local.slice(7)}`;
};
// Earliest pickable visit: today 00:00 in Nairobi, as a datetime-local value.
const minVisit = `${new Date(Date.now() + 3 * 3600_000).toISOString().slice(0, 10)}T00:00`;

const priorityTone = {
  high: { box: 'bg-[#FDEEE9] text-[#C04A26] border-[#F6C6B8]', dot: 'bg-[#C04A26]' },
  medium: { box: 'bg-[#FFF8E1] text-[#B78103] border-[#FFE082]', dot: 'bg-[#B78103]' },
  low: { box: 'bg-[#F3F4F0] text-[#5A6862] border-[#DCE0D7]', dot: 'bg-[#8FA69C]' },
} as const;
---

<DashboardLayout title="Makazi — Maintenance" currentPath="/maintenance">
  <!-- Header & Actions -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <span class="text-xs font-semibold tracking-wider text-[#69847A] uppercase">
        {portfolioSummary}
      </span>
      <h1 class="text-3xl sm:text-4xl font-normal font-editorial text-[#0D382B] tracking-tight mt-1">
        Maintenance
      </h1>
    </div>

    <div class="flex items-center gap-3 self-start md:self-auto">
      <!-- Period Selector -->
      <div class="relative inline-block">
        <button 
          type="button" 
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white border border-[#E3E6DF] text-xs font-semibold text-[#0D382B] shadow-xs hover:border-[#0D382B] transition-colors cursor-pointer"
        >
          <span>{currentPeriod}</span>
          <ChevronDown class="w-4 h-4 text-[#69847A]" />
        </button>
      </div>
    </div>
  </div>

  <!-- Search & Priority Filter Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-3">
      <!-- Search -->
      <div class="relative min-w-56 sm:min-w-64">
        <Search class="w-4 h-4 text-[#69847A] absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
        <input
          id="maintenance-search"
          type="search"
          placeholder="Search issue, tenant, staff, ID…"
          class="w-full pl-10 pr-4 py-2 rounded-full border border-[#E3E6DF] bg-white text-xs text-[#0D382B] placeholder:text-[#8FA69C] focus:outline-hidden focus:border-[#0D382B] transition-colors shadow-xs"
        />
      </div>
      <!-- Priority buttons -->
      <div class="flex items-center gap-1.5" role="group" aria-label="Priority filter">
        {['all', 'high', 'medium', 'low'].map((p) => (
          <button
            type="button"
            data-priority-btn={p}
            class="priority-btn px-4 py-2 rounded-full border text-xs font-semibold cursor-pointer transition-colors shadow-xs capitalize"
          >
            {p}
          </button>
        ))}
      </div>
      <button
        type="button"
        id="toggle-voided-btn"
        aria-pressed="false"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-[#E3E6DF] bg-white text-xs font-semibold text-[#5A6862] hover:text-[#C04A26] hover:border-[#F6C6B8] transition-colors cursor-pointer shadow-xs"
      >
        <Ban class="w-3.5 h-3.5" /> Voided ({voidedTickets.length})
      </button>
    </div>
    <span class="text-xs font-medium text-[#69847A] tabular-nums whitespace-nowrap">
      <span id="maintenance-total-count">{totalTicketsCount}</span> tickets total
    </span>
  </div>

  <!-- Board: same tickets and statuses the tenant app shows -->
  <div id="active-board" class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
    {columns.map((column, colIdx) => (
      <div class="maintenance-column bg-[#F8F9F6] rounded-3xl border border-[#E3E6DF] p-5 flex flex-col justify-between shadow-xs" data-col-index={colIdx}>
        <div>
          <div class="flex items-center justify-between pb-3 border-b border-[#E3E6DF]">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-[#0D382B]">{column.title}</h2>
            <span class="column-count text-xs font-bold text-[#0D382B] bg-white px-2.5 py-0.5 rounded-full border border-[#E3E6DF] shadow-xs">
              {column.items.length}
            </span>
          </div>
          <div class="tickets-container space-y-4 pr-1 my-3">
            {column.items.length === 0 ? (
              <p class="empty-state text-xs text-[#69847A] py-8 text-center">{column.empty}</p>
            ) : (
              <>
                {column.items.map((t) => {
                  const tone = priorityTone[t.ticket.priority];
                  return (
                    <div
                      class="ticket-card bg-white rounded-2xl border border-[#E3E6DF] p-5 flex flex-col justify-between shadow-xs hover:border-[#69847A]/50 transition-colors"
                      data-priority={t.ticket.priority}
                      data-search={`${t.ticket.id} ${t.ticket.title} ${t.categoryLabel} ${t.reporter} ${t.ticket.assignedTo ?? ''} ${t.ticket.resolutionNote ?? ''}`.toLowerCase()}
                    >
                      <div>
                        <div class="flex items-center justify-between gap-2">
                          <span class="font-mono text-xs text-[#69847A]">{t.ticket.id} · {t.categoryLabel}</span>
                          <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold border ${tone.box}`}>
                            <span class={`h-1.5 w-1.5 rounded-full ${tone.dot}`}></span>
                            {t.priorityLabel}
                          </span>
                        </div>
                        <h3 class="text-sm font-semibold text-[#0D382B] mt-2.5">{t.ticket.title}</h3>
                        <p class="text-xs text-[#69847A] mt-1">{t.reporter} · {t.when}</p>
                        {t.ticket.assignedTo && (
                          <div class="mt-3 rounded-xl bg-[#F8F9F6] border border-[#E3E6DF] px-3 py-2.5 text-[11px] text-[#5A6862] space-y-0.5">
                            <p>
                              <span class="font-semibold text-[#0D382B]">{t.ticket.status === 'resolved' ? 'Fixed by' : 'With'} {t.ticket.assignedTo}</span>
                              {t.ticket.assignedPhone && (
                                <> · <a href={`tel:${t.ticket.assignedPhone}`} class="underline decoration-[#C9D2CC] hover:text-[#0D382B]">{localPhone(t.ticket.assignedPhone)}</a></>
                              )}
                            </p>
                            {t.ticket.visitAt && t.ticket.status !== 'resolved' && <p>Visit: {visitLabel(t.ticket.visitAt)}</p>}
                            {t.ticket.resolutionNote && <p class="text-[#69847A]">{t.ticket.resolutionNote}</p>}
                          </div>
                        )}
                        {t.ticket.photoUrl ? (
                          <div class="mt-3 rounded-2xl overflow-hidden border border-[#E3E6DF] bg-[#F8F9F6] shadow-xs">
                            <button
                              type="button"
                              class="view-photo-btn group block w-full relative aspect-video bg-[#17231E]/5 overflow-hidden cursor-pointer"
                              data-photo={t.ticket.photoUrl}
                              data-ticket={t.ticket.id}
                              data-title={t.ticket.title}
                              data-reporter={t.reporter}
                              data-description={t.ticket.description}
                              data-fundi={t.ticket.assignedTo ?? ''}
                              data-phone={t.ticket.assignedPhone ?? ''}
                              title="Click to view full photo"
                            >
                              <img src={t.ticket.photoUrl} alt={`Photo for ${t.ticket.id}`} loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
                              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-2.5">
                                <span class="text-white text-xs font-medium inline-flex items-center gap-1.5"><Eye class="w-3.5 h-3.5" /> Enlarge photo</span>
                              </div>
                            </button>
                            <div class="p-2 flex items-center justify-between gap-2 bg-white border-t border-[#E3E6DF]">
                              <button
                                type="button"
                                class="view-photo-btn inline-flex items-center gap-1 text-xs font-semibold text-[#0D382B] hover:text-[#154637] transition-colors cursor-pointer"
                                data-photo={t.ticket.photoUrl}
                                data-ticket={t.ticket.id}
                                data-title={t.ticket.title}
                                data-reporter={t.reporter}
                                data-description={t.ticket.description}
                                data-fundi={t.ticket.assignedTo ?? ''}
                                data-phone={t.ticket.assignedPhone ?? ''}
                              >
                                <Eye class="w-3.5 h-3.5" /> Inspect
                              </button>
                              <button
                                type="button"
                                class="share-attached-direct-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold bg-[#0D382B] text-white hover:bg-[#154637] transition-colors cursor-pointer shadow-xs"
                                data-photo={t.ticket.photoUrl}
                                data-ticket={t.ticket.id}
                                data-title={t.ticket.title}
                                data-reporter={t.reporter}
                                data-description={t.ticket.description}
                                data-fundi={t.ticket.assignedTo ?? ''}
                                data-phone={t.ticket.assignedPhone ?? ''}
                              >
                                <Share2 class="w-3 h-3 text-[#C6EE58]" /> Share image
                              </button>
                            </div>
                          </div>
                        ) : (
                          <div class="mt-3 pt-2.5 border-t border-dashed border-[#E3E6DF] flex items-center justify-between">
                            <span class="text-[11px] text-[#73827C]">
                              {t.ticket.hasPhoto ? 'Photo pending upload' : 'No photo attached'}
                            </span>
                            <label class="inline-flex items-center gap-1 text-[11px] font-semibold text-[#0D382B] hover:text-[#154637] bg-[#F4F5F1] hover:bg-[#E7EAE4] px-2.5 py-1 rounded-lg cursor-pointer transition-colors">
                              <Upload class="w-3 h-3" /> Attach photo
                              <input type="file" accept="image/*" class="admin-photo-upload-input hidden" data-ticket={t.ticket.id} />
                            </label>
                          </div>
                        )}
                      </div>
                      {column.action && (
                        <div class="mt-4 pt-3 border-t border-[#E3E6DF] flex flex-wrap items-center gap-2">
                          {t.ticket.status === 'open' ? (
                            <button
                              type="button"
                              class="assign-repair-btn px-4 py-1.5 rounded-full border border-[#0D382B] text-xs font-semibold text-white bg-[#0D382B] hover:bg-[#154637] transition-colors cursor-pointer shadow-xs"
                              data-ticket={t.ticket.id}
                              data-title={t.ticket.title}
                              data-reporter={t.reporter}
                            >
                              Assign & start
                            </button>
                          ) : (
                            <>
                              <button
                                type="button"
                                class="repair-resolve-btn px-4 py-1.5 rounded-full border border-[#E3E6DF] hover:border-[#0D382B] text-xs font-semibold text-[#0D382B] bg-[#F8F9F6] hover:bg-white transition-colors cursor-pointer shadow-xs"
                                data-ticket={t.ticket.id}
                              >
                                Mark resolved
                              </button>
                              <button
                                type="button"
                                class="assign-repair-btn px-3 py-1.5 rounded-full text-xs font-semibold text-[#5A6862] hover:text-[#0D382B] hover:bg-[#F4F5F1] transition-colors cursor-pointer"
                                data-ticket={t.ticket.id}
                                data-title={t.ticket.title}
                                data-reporter={t.reporter}
                                data-editing="true"
                                data-name={t.ticket.assignedTo ?? ''}
                                data-phone={t.ticket.assignedPhone ? localPhone(t.ticket.assignedPhone) : ''}
                                data-visit={t.ticket.visitAt ? t.ticket.visitAt.slice(0, 16) : ''}
                              >
                                Edit visit
                              </button>
                            </>
                          )}
                          <button
                            type="button"
                            class="void-ticket-btn ml-auto px-3 py-1.5 rounded-full text-xs font-semibold text-[#C04A26] hover:bg-[#FDEEE9] transition-colors cursor-pointer"
                            data-ticket={t.ticket.id}
                            data-title={t.ticket.title}
                            data-reporter={t.reporter}
                          >
                            Void
                          </button>
                        </div>
                      )}
                    </div>
                  );
                })}
                <p class="empty-state hidden text-xs text-[#69847A] py-8 text-center">No matching tickets</p>
              </>
            )}
          </div>
        </div>

        <!-- Column pagination -->
        <div class="col-pagination pt-3 border-t border-[#E3E6DF] flex items-center justify-between text-xs text-[#5A6862]">
          <span class="col-page-indicator font-medium">Page 1 of 1</span>
          <div class="flex items-center gap-1.5">
            <button type="button" class="col-prev-btn px-2.5 py-1 rounded-lg border border-[#DCE0D7] bg-white text-xs font-semibold text-[#0D382B] hover:bg-[#F4F5F1] disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer transition-colors">
              Prev
            </button>
            <button type="button" class="col-next-btn px-2.5 py-1 rounded-lg border border-[#DCE0D7] bg-white text-xs font-semibold text-[#0D382B] hover:bg-[#F4F5F1] disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer transition-colors">
              Next
            </button>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Assign: who is going, their mobile and when. The tenant sees this in the app. -->
  <div
    id="assign-repair-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="assign-repair-title"
  >
    <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl border border-[#E7EAE4] overflow-hidden transform scale-95 transition-transform duration-200 max-h-[92vh] flex flex-col">
      <div class="flex items-center justify-between p-6 border-b border-[#F0F2EE] shrink-0">
        <div class="flex items-center gap-3 min-w-0">
          <div class="h-10 w-10 shrink-0 rounded-xl bg-[#0D382B] text-[#C6EE58] flex items-center justify-center">
            <Wrench class="w-5 h-5" />
          </div>
          <div class="min-w-0">
            <h3 id="assign-repair-title" class="font-editorial text-2xl font-normal text-[#17231E]">Assign repair</h3>
            <p class="text-xs text-[#73827C] truncate" data-field="who"></p>
          </div>
        </div>
        <button type="button" data-close class="h-8 w-8 rounded-full bg-[#F4F5F1] text-[#73827C] hover:text-[#17231E] flex items-center justify-center transition-colors cursor-pointer" aria-label="Close">
          <X class="w-4 h-4" />
        </button>
      </div>

      <form id="assign-repair-form" class="p-6 space-y-4 flex-1 min-h-0 overflow-y-auto" novalidate>
        <div>
          <label for="assign-name" class="block text-xs font-semibold uppercase tracking-wider text-[#5A6862] mb-1.5">Who's going</label>
          <input id="assign-name" name="name" type="text" required maxlength="80" autocomplete="off" placeholder="Contractor or fundi name"
            class="w-full px-3.5 py-2.5 rounded-xl border border-[#E2E5DF] bg-[#FAFBF9] text-sm text-[#17231E] focus:outline-none focus:border-[#0D382B]" />
        </div>
        <div>
          <label for="assign-phone" class="block text-xs font-semibold uppercase tracking-wider text-[#5A6862] mb-1.5">Mobile number</label>
          <input id="assign-phone" name="phone" type="tel" required inputmode="tel" autocomplete="off" placeholder="07XX XXX XXX"
            class="w-full px-3.5 py-2.5 rounded-xl border border-[#E2E5DF] bg-[#FAFBF9] text-sm text-[#17231E] focus:outline-none focus:border-[#0D382B]" />
        </div>
        <div>
          <label for="assign-visit" class="block text-xs font-semibold uppercase tracking-wider text-[#5A6862] mb-1.5">Visit time <span class="normal-case font-normal tracking-normal text-[#73827C]">(optional)</span></label>
          <input id="assign-visit" name="visitAt" type="datetime-local" min={minVisit}
            class="w-full px-3.5 py-2.5 rounded-xl border border-[#E2E5DF] bg-[#FAFBF9] text-sm text-[#17231E] focus:outline-none focus:border-[#0D382B]" />
          <p class="text-[11px] text-[#73827C] mt-1.5">Nairobi time. The tenant sees the name, number and visit time inside their request.</p>
        </div>
        <p data-field="error" class="hidden text-xs text-[#C04A26]" role="alert"></p>
        <div class="pt-4 flex items-center justify-end gap-3 border-t border-[#F0F2EE]">
          <button type="button" data-close class="px-5 py-2.5 rounded-xl text-sm font-medium text-[#5A6862] hover:bg-[#F4F5F1] transition-colors cursor-pointer">Cancel</button>
          <button type="submit" data-field="submit" class="px-6 py-2.5 rounded-xl text-sm font-semibold bg-[#0D382B] text-white hover:bg-[#154637] transition-all shadow-md cursor-pointer disabled:opacity-60">Assign & start</button>
        </div>
      </form>
    </div>
  </div>

  <section id="voided-board" class="hidden bg-[#F8F9F6] rounded-3xl border border-[#E3E6DF] p-5 shadow-xs" aria-label="Voided tickets">
    <div class="pb-3 mb-4 border-b border-[#E3E6DF]">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-[#0D382B]">Voided</h2>
      <p class="text-xs text-[#69847A] mt-1">Requests closed as irrelevant. Kept here for the record; the tenant sees them as Voided.</p>
    </div>
    {voidedTickets.length === 0 ? (
      <p class="text-xs text-[#69847A] py-8 text-center">No voided tickets.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {voidedTickets.map((t) => (
          <div class="bg-white rounded-2xl border border-[#E3E6DF] p-5 shadow-xs">
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-xs text-[#69847A]">{t.ticket.id} · {t.categoryLabel}</span>
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold border bg-[#FDEEE9] text-[#C04A26] border-[#F6C6B8]">Voided</span>
            </div>
            <h3 class="text-sm font-semibold text-[#5A6862] mt-2.5 line-through">{t.ticket.title}</h3>
            <p class="text-xs text-[#69847A] mt-1">{t.reporter} · {t.when}</p>
            {t.ticket.resolutionNote && <p class="mt-3 text-[11px] text-[#5A6862] rounded-xl bg-[#F8F9F6] border border-[#E3E6DF] px-3 py-2">Reason: {t.ticket.resolutionNote}</p>}
          </div>
        ))}
      </div>
    )}
  </section>

  <div
    id="repair-photo-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="repair-photo-title"
  >
    <div class="relative w-full max-w-2xl bg-white rounded-3xl shadow-2xl border border-[#E7EAE4] overflow-hidden transform scale-95 transition-transform duration-200 max-h-[92vh] flex flex-col">
      <div class="flex items-center justify-between p-6 border-b border-[#F0F2EE] shrink-0">
        <div class="min-w-0">
          <h3 id="repair-photo-title" class="font-editorial text-2xl font-normal text-[#17231E]">Damage photo</h3>
          <p class="text-xs text-[#73827C] truncate" data-photo-field="who"></p>
        </div>
        <button type="button" data-close class="h-8 w-8 shrink-0 rounded-full bg-[#F4F5F1] text-[#73827C] hover:text-[#17231E] flex items-center justify-center transition-colors cursor-pointer" aria-label="Close">
          <X class="w-4 h-4" />
        </button>
      </div>
      <div class="p-6 space-y-4 flex-1 min-h-0 overflow-y-auto">
        <a data-photo-field="open" href="#" target="_blank" rel="noopener noreferrer" title="Click to view raw file in new tab" class="block rounded-2xl overflow-hidden border border-[#E3E6DF] bg-[#0A261F]/5 group cursor-zoom-in">
          <img data-photo-field="img" src="" alt="Damage photo" class="w-full max-h-[50vh] object-contain transition-transform duration-200 group-hover:scale-[1.01]" />
        </a>
        <div class="rounded-xl bg-[#F8F9F6] border border-[#E3E6DF] p-3.5 space-y-1">
          <p class="text-xs font-semibold uppercase tracking-wider text-[#5A6862]">Issue details</p>
          <p class="text-sm font-medium text-[#17231E]" data-photo-field="desc"></p>
          <p class="text-xs text-[#69847A]" data-photo-field="fundi"></p>
        </div>
      </div>
      <div class="px-6 py-4 border-t border-[#F0F2EE] flex flex-wrap items-center justify-between gap-3 shrink-0 bg-[#FAFBF9]">
        <div class="flex items-center gap-2">
          <label class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-[#5A6862] hover:text-[#0D382B] border border-[#E3E6DF] bg-white hover:bg-[#F4F5F1] transition-colors cursor-pointer">
            <Upload class="w-3.5 h-3.5" /> Replace photo
            <input type="file" accept="image/*" id="modal-photo-replace-input" class="hidden" />
          </label>
          <a data-photo-field="download" href="#" download="damage-photo.jpg" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-[#5A6862] hover:text-[#0D382B] border border-[#E3E6DF] bg-white hover:bg-[#F4F5F1] transition-colors cursor-pointer">
            <Download class="w-3.5 h-3.5" /> Save file
          </a>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" data-photo-field="copy-img" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold text-[#0D382B] border border-[#E3E6DF] bg-white hover:bg-[#F4F5F1] transition-colors cursor-pointer">
            <Copy class="w-3.5 h-3.5" /> Copy image
          </button>
          <button type="button" data-photo-field="share-attached" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-[#0D382B] text-white hover:bg-[#154637] transition-all shadow-md cursor-pointer">
            <Share2 class="w-3.5 h-3.5 text-[#C6EE58]" /> <span data-photo-field="share-label">Share attached image</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div
    id="void-ticket-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="void-ticket-title"
  >
    <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl border border-[#E7EAE4] overflow-hidden transform scale-95 transition-transform duration-200 max-h-[92vh] flex flex-col">
      <div class="flex items-center justify-between p-6 border-b border-[#F0F2EE] shrink-0">
        <div class="min-w-0">
          <h3 id="void-ticket-title" class="font-editorial text-2xl font-normal text-[#17231E]">Void ticket</h3>
          <p class="text-xs text-[#73827C] truncate" data-void-field="who"></p>
        </div>
        <button type="button" data-close class="h-8 w-8 shrink-0 rounded-full bg-[#F4F5F1] text-[#73827C] hover:text-[#17231E] flex items-center justify-center transition-colors cursor-pointer" aria-label="Close">
          <X class="w-4 h-4" />
        </button>
      </div>
      <form id="void-ticket-form" class="p-6 space-y-4 flex-1 min-h-0 overflow-y-auto" novalidate>
        <p class="text-xs text-[#5A6862]">The ticket leaves the board and the tenant sees it as Voided with your reason.</p>
        <div class="flex flex-wrap gap-1.5">
          {['Not a repair issue', 'Duplicate request', 'Tenant fixed it', 'Tenant responsibility'].map((r) => (
            <button type="button" class="void-reason-chip text-[11px] px-2.5 py-1 rounded-full bg-[#F4F5F1] text-[#0D382B] hover:bg-[#E7EAE4] transition-colors cursor-pointer" data-reason={r}>{r}</button>
          ))}
        </div>
        <div>
          <label for="void-reason" class="block text-xs font-semibold uppercase tracking-wider text-[#5A6862] mb-1.5">Reason</label>
          <input id="void-reason" name="reason" type="text" required maxlength="300" autocomplete="off" placeholder="Shown to the tenant"
            class="w-full px-3.5 py-2.5 rounded-xl border border-[#E2E5DF] bg-[#FAFBF9] text-sm text-[#17231E] focus:outline-none focus:border-[#0D382B]" />
        </div>
        <p data-void-field="error" class="hidden text-xs text-[#C04A26]" role="alert"></p>
        <div class="pt-4 flex items-center justify-end gap-3 border-t border-[#F0F2EE]">
          <button type="button" data-close class="px-5 py-2.5 rounded-xl text-sm font-medium text-[#5A6862] hover:bg-[#F4F5F1] transition-colors cursor-pointer">Keep ticket</button>
          <button type="submit" data-void-field="submit" class="px-6 py-2.5 rounded-xl text-sm font-semibold bg-[#C04A26] text-white hover:bg-[#A83D1D] transition-all shadow-md cursor-pointer disabled:opacity-60">Void ticket</button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script>
  import { setBusy } from '../lib/busy';
  type UpdateBody = {
    ticketId: string;
    status: 'in_progress' | 'resolved' | 'voided';
    assignee?: { name: string; phone: string; visitAt: string };
    resolutionNote?: string;
  };

  async function updateTicket(body: UpdateBody) {
    const res = await fetch('/api/update-ticket', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || data.error) throw new Error(data.error || 'Could not update the ticket');
  }

  async function fetchImageAsFile(photoUrl: string, filename: string): Promise<File> {
    const res = await fetch(photoUrl);
    if (!res.ok) throw new Error('Could not download image file');
    const blob = await res.blob();
    const mimeType = blob.type && blob.type.startsWith('image/') ? blob.type : 'image/jpeg';
    return new File([blob], filename, { type: mimeType });
  }

  async function convertBlobToPng(blob: Blob): Promise<Blob> {
    if (blob.type === 'image/png') return blob;
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = img.naturalWidth || img.width;
        canvas.height = img.naturalHeight || img.height;
        const ctx = canvas.getContext('2d');
        if (!ctx) return reject(new Error('Canvas context unavailable'));
        ctx.drawImage(img, 0, 0);
        canvas.toBlob((b) => {
          if (b) resolve(b);
          else reject(new Error('Failed to convert image to PNG'));
        }, 'image/png');
      };
      img.onerror = () => reject(new Error('Failed to load image for clipboard conversion'));
      img.src = URL.createObjectURL(blob);
    });
  }

  async function copyImageToClipboard(photoUrl: string): Promise<boolean> {
    try {
      const res = await fetch(photoUrl);
      if (!res.ok) throw new Error('Fetch failed');
      const blob = await res.blob();
      const pngBlob = await convertBlobToPng(blob);
      await navigator.clipboard.write([
        new ClipboardItem({ 'image/png': pngBlob }),
      ]);
      return true;
    } catch (e) {
      console.warn('Clipboard write failed:', e);
      return false;
    }
  }

  async function shareAttachedImage({
    photoUrl,
    ticketId,
    title,
    reporter,
    phone,
    fundi,
  }: {
    photoUrl: string;
    ticketId: string;
    title: string;
    reporter: string;
    phone?: string;
    fundi?: string;
  }) {
    const filename = `${ticketId.toLowerCase()}-damage.jpg`;
    const shareText = [
      `Repair job ${ticketId}: ${title}`,
      reporter ? `Reported by: ${reporter}` : '',
      fundi ? `Assigned to: ${fundi}` : '',
    ].filter(Boolean).join('\n');

    // 1. Try Web Share API with attached File (works on Safari iOS/macOS, Chrome Android)
    if (navigator.share) {
      try {
        const file = await fetchImageAsFile(photoUrl, filename);
        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          await navigator.share({
            title: `Repair Job ${ticketId}: ${title}`,
            text: shareText,
            files: [file],
          });
          window.makaziUi?.showToast('Shared', 'Photo and job details shared.');
          return;
        }
      } catch (err: unknown) {
        if ((err as Error)?.name === 'AbortError') return;
        console.warn('Native share failed, falling back to WhatsApp/clipboard:', err);
      }
    }

    // 2. Fallback: Copy image to clipboard and open WhatsApp chat
    const copied = await copyImageToClipboard(photoUrl);
    const digits = (phone || '').replace(/\D/g, '');
    const waMessage = `${shareText}\nPhoto link: ${photoUrl}\n(Image copied to clipboard - paste into chat)`;
    const waUrl = digits
      ? `https://wa.me/${digits}?text=${encodeURIComponent(waMessage)}`
      : `https://wa.me/?text=${encodeURIComponent(waMessage)}`;

    if (copied) {
      window.makaziUi?.showToast(
        'Image copied to clipboard!',
        'Opening WhatsApp. Simply press Paste (Cmd+V / Ctrl+V) to attach the photo.',
      );
    } else {
      window.makaziUi?.showToast(
        'Opening WhatsApp',
        'Photo link and repair details prefilled.',
      );
    }

    window.open(waUrl, '_blank', 'noopener,noreferrer');
  }

  async function uploadAdminPhoto(ticketId: string, file: File) {
    const formData = new FormData();
    formData.append('ticketId', ticketId);
    formData.append('file', file);
    const res = await fetch('/api/upload-repair-photo', {
      method: 'POST',
      body: formData,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || data.error) throw new Error(data.error || 'Upload failed');
    return data.photoUrl as string;
  }

  function initMaintenancePage() {
    const searchInput = document.getElementById('maintenance-search') as HTMLInputElement | null;
    const priorityBtns = document.querySelectorAll<HTMLElement>('[data-priority-btn]');
    const totalCountEl = document.getElementById('maintenance-total-count');
    const columns = document.querySelectorAll<HTMLElement>('.maintenance-column');

    const PRIORITY_ACTIVE = ['bg-[#0D382B]', 'text-white', 'border-[#0D382B]'];
    const PRIORITY_IDLE = ['bg-white', 'text-[#0D382B]', 'border-[#E3E6DF]'];
    const PAGE_SIZE = 3;

    let selectedPriority = 'all';
    let searchQuery = '';
    const colPages: number[] = Array.from({ length: columns.length }, () => 1);

    function renderFilters() {
      let totalMatchingAll = 0;

      // Update priority buttons
      priorityBtns.forEach((btn) => {
        const on = btn.dataset.priorityBtn === selectedPriority;
        btn.classList.remove(...(on ? PRIORITY_IDLE : PRIORITY_ACTIVE));
        btn.classList.add(...(on ? PRIORITY_ACTIVE : PRIORITY_IDLE));
      });

      columns.forEach((col, colIdx) => {
        const matchingCards: HTMLElement[] = [];
        col.querySelectorAll<HTMLElement>('.ticket-card').forEach((card) => {
          const matchesPriority = selectedPriority === 'all' || card.dataset.priority === selectedPriority;
          const matchesSearch = !searchQuery || (card.dataset.search ?? '').includes(searchQuery);
          const matches = matchesPriority && matchesSearch;

          if (matches) {
            matchingCards.push(card);
          } else {
            card.classList.add('hidden');
          }
        });

        const totalMatching = matchingCards.length;
        totalMatchingAll += totalMatching;

        // Update column count badge
        const countBadge = col.querySelector<HTMLElement>('.column-count');
        if (countBadge) countBadge.textContent = String(totalMatching);

        // Update empty state
        const emptyState = col.querySelector<HTMLElement>('.empty-state');
        if (emptyState) emptyState.classList.toggle('hidden', totalMatching > 0);

        // Calculate pages
        const totalPages = Math.max(1, Math.ceil(totalMatching / PAGE_SIZE));
        if (colPages[colIdx] > totalPages) colPages[colIdx] = totalPages;
        if (colPages[colIdx] < 1) colPages[colIdx] = 1;
        const curPage = colPages[colIdx];

        matchingCards.forEach((card, idx) => {
          const isVisible = idx >= (curPage - 1) * PAGE_SIZE && idx < curPage * PAGE_SIZE;
          card.classList.toggle('hidden', !isVisible);
        });

        // Update pagination bar
        const paginationBar = col.querySelector<HTMLElement>('.col-pagination');
        const indicator = col.querySelector<HTMLElement>('.col-page-indicator');
        const prevBtn = col.querySelector<HTMLButtonElement>('.col-prev-btn');
        const nextBtn = col.querySelector<HTMLButtonElement>('.col-next-btn');

        if (paginationBar) {
          paginationBar.classList.toggle('hidden', totalMatching <= PAGE_SIZE);
        }
        if (indicator) {
          indicator.textContent = `Page ${curPage} of ${totalPages}`;
        }
        if (prevBtn) {
          prevBtn.disabled = curPage <= 1;
          prevBtn.onclick = () => {
            if (colPages[colIdx] > 1) {
              colPages[colIdx]--;
              renderFilters();
            }
          };
        }
        if (nextBtn) {
          nextBtn.disabled = curPage >= totalPages;
          nextBtn.onclick = () => {
            if (colPages[colIdx] < totalPages) {
              colPages[colIdx]++;
              renderFilters();
            }
          };
        }
      });

      if (totalCountEl) {
        totalCountEl.textContent = String(totalMatchingAll);
      }
    }

    priorityBtns.forEach((btn) => {
      btn.onclick = () => {
        selectedPriority = btn.dataset.priorityBtn ?? 'all';
        colPages.fill(1);
        renderFilters();
      };
    });

    if (searchInput) {
      searchInput.oninput = (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        colPages.fill(1);
        renderFilters();
      };
    }

    renderFilters();

    const activeBoard = document.getElementById('active-board');
    const voidedBoard = document.getElementById('voided-board');
    const toggleVoided = document.getElementById('toggle-voided-btn');
    if (toggleVoided && activeBoard && voidedBoard) {
      toggleVoided.onclick = () => {
        const showVoided = voidedBoard.classList.contains('hidden');
        voidedBoard.classList.toggle('hidden', !showVoided);
        activeBoard.classList.toggle('hidden', showVoided);
        toggleVoided.setAttribute('aria-pressed', String(showVoided));
        toggleVoided.classList.toggle('border-[#C04A26]', showVoided);
        toggleVoided.classList.toggle('text-[#C04A26]', showVoided);
      };
    }

    // Direct share buttons on cards
    document.querySelectorAll<HTMLButtonElement>('.share-attached-direct-btn').forEach((btn) => {
      btn.onclick = async (e) => {
        e.stopPropagation();
        const { photo = '', ticket = '', title = '', reporter = '', fundi = '', phone = '' } = btn.dataset;
        if (!photo) return;
        const restore = setBusy(btn, 'Sharing…');
        try {
          await shareAttachedImage({ photoUrl: photo, ticketId: ticket, title, reporter, phone, fundi });
        } catch (err) {
          window.makaziUi?.showToast('Share failed', err instanceof Error ? err.message : String(err));
        } finally {
          restore();
        }
      };
    });

    // Admin photo upload inputs on cards
    document.querySelectorAll<HTMLInputElement>('.admin-photo-upload-input').forEach((input) => {
      input.onchange = async () => {
        const file = input.files?.[0];
        const ticketId = input.dataset.ticket;
        if (!file || !ticketId) return;
        window.makaziUi?.showToast('Uploading photo…', 'Attaching image to ticket.');
        try {
          await uploadAdminPhoto(ticketId, file);
          window.makaziUi?.showToast('Photo attached', 'The image is now visible on this ticket.');
          setTimeout(() => window.location.reload(), 600);
        } catch (err) {
          window.makaziUi?.showToast('Upload error', err instanceof Error ? err.message : String(err));
        }
      };
    });

    const photoModal = document.getElementById('repair-photo-modal');
    if (photoModal) {
      const photoField = (name: string) => photoModal.querySelector<HTMLElement>(`[data-photo-field="${name}"]`)!;
      let currentTicket = {
        photo: '',
        ticket: '',
        title: '',
        reporter: '',
        description: '',
        fundi: '',
        phone: '',
      };

      document.querySelectorAll<HTMLButtonElement>('.view-photo-btn').forEach((btn) => {
        btn.onclick = (e) => {
          e.stopPropagation();
          const { photo = '', ticket = '', title = '', reporter = '', description = '', fundi = '', phone = '' } = btn.dataset;
          currentTicket = { photo, ticket, title, reporter, description, fundi, phone };
          (photoField('img') as HTMLImageElement).src = photo;
          (photoField('open') as HTMLAnchorElement).href = photo;
          (photoField('download') as HTMLAnchorElement).href = photo;
          (photoField('download') as HTMLAnchorElement).download = `${ticket.toLowerCase()}-damage.jpg`;
          photoField('who').textContent = `${ticket} · ${title} · ${reporter}`;
          photoField('desc').textContent = description || title;
          photoField('fundi').textContent = fundi
            ? `Assigned to ${fundi} (${phone || 'no phone'}). Sharing attaches the photo or copies it to paste directly.`
            : 'No one assigned yet. Sharing lets you pick who or which app to send the photo to.';
          photoField('share-label').textContent = fundi ? `Share with ${fundi}` : 'Share attached image';
          window.makaziUi?.showModal('repair-photo-modal');
        };
      });

      const shareAttachedBtn = photoField('share-attached') as HTMLButtonElement | null;
      if (shareAttachedBtn) {
        shareAttachedBtn.onclick = async () => {
          if (!currentTicket.photo) return;
          const restore = setBusy(shareAttachedBtn, 'Sharing…');
          try {
            await shareAttachedImage({
              photoUrl: currentTicket.photo,
              ticketId: currentTicket.ticket,
              title: currentTicket.title,
              reporter: currentTicket.reporter,
              phone: currentTicket.phone,
              fundi: currentTicket.fundi,
            });
          } catch (err) {
            window.makaziUi?.showToast('Share failed', err instanceof Error ? err.message : String(err));
          } finally {
            restore();
          }
        };
      }

      const copyImgBtn = photoField('copy-img') as HTMLButtonElement | null;
      if (copyImgBtn) {
        copyImgBtn.onclick = async () => {
          if (!currentTicket.photo) return;
          const restore = setBusy(copyImgBtn, 'Copying…');
          try {
            const copied = await copyImageToClipboard(currentTicket.photo);
            if (copied) {
              window.makaziUi?.showToast('Image copied!', 'Paste (Cmd+V / Ctrl+V) directly into WhatsApp or email.');
            } else {
              await navigator.clipboard.writeText(currentTicket.photo);
              window.makaziUi?.showToast('Photo link copied', 'Pasted as image link.');
            }
          } catch {
            await navigator.clipboard.writeText(currentTicket.photo);
            window.makaziUi?.showToast('Photo link copied', 'Pasted as image link.');
          } finally {
            restore();
          }
        };
      }

      const modalReplaceInput = document.getElementById('modal-photo-replace-input') as HTMLInputElement | null;
      if (modalReplaceInput) {
        modalReplaceInput.onchange = async () => {
          const file = modalReplaceInput.files?.[0];
          if (!file || !currentTicket.ticket) return;
          window.makaziUi?.showToast('Uploading new photo…', 'Updating ticket image.');
          try {
            const newUrl = await uploadAdminPhoto(currentTicket.ticket, file);
            currentTicket.photo = newUrl;
            (photoField('img') as HTMLImageElement).src = newUrl;
            (photoField('open') as HTMLAnchorElement).href = newUrl;
            (photoField('download') as HTMLAnchorElement).href = newUrl;
            window.makaziUi?.showToast('Photo updated', 'New damage image saved.');
            setTimeout(() => window.location.reload(), 600);
          } catch (err) {
            window.makaziUi?.showToast('Update failed', err instanceof Error ? err.message : String(err));
          }
        };
      }

      photoModal.querySelectorAll('[data-close]').forEach((el) => {
        (el as HTMLElement).onclick = () => window.makaziUi?.hideModal('repair-photo-modal');
      });
    }

    const voidModal = document.getElementById('void-ticket-modal');
    const voidForm = document.getElementById('void-ticket-form') as HTMLFormElement | null;
    if (voidModal && voidForm) {
      const voidField = (name: string) => voidModal.querySelector<HTMLElement>(`[data-void-field="${name}"]`)!;
      const reasonInput = voidForm.elements.namedItem('reason') as HTMLInputElement;
      let voidId = '';
      const showVoidError = (message: string | null) => {
        voidField('error').textContent = message ?? '';
        voidField('error').classList.toggle('hidden', !message);
      };
      document.querySelectorAll<HTMLButtonElement>('.void-ticket-btn').forEach((btn) => {
        btn.onclick = () => {
          const { ticket = '', title = '', reporter = '' } = btn.dataset;
          voidId = ticket;
          voidField('who').textContent = `${ticket} · ${title} · ${reporter}`;
          reasonInput.value = '';
          showVoidError(null);
          window.makaziUi?.showModal('void-ticket-modal');
          setTimeout(() => reasonInput.focus(), 50);
        };
      });
      voidModal.querySelectorAll<HTMLButtonElement>('.void-reason-chip').forEach((chip) => {
        chip.onclick = () => {
          reasonInput.value = chip.dataset.reason ?? '';
        };
      });
      voidModal.querySelectorAll('[data-close]').forEach((el) => {
        (el as HTMLElement).onclick = () => window.makaziUi?.hideModal('void-ticket-modal');
      });
      voidForm.onsubmit = async (event) => {
        event.preventDefault();
        const reason = reasonInput.value.trim();
        if (reason.length < 3) return showVoidError('Add a short reason so the tenant knows why.');
        showVoidError(null);
        const restore = setBusy(voidField('submit') as HTMLButtonElement, 'Voiding…');
        try {
          await updateTicket({ ticketId: voidId, status: 'voided', resolutionNote: reason });
          window.makaziUi?.hideModal('void-ticket-modal');
          window.makaziUi?.showToast('Ticket voided', `${voidId} moved to Voided.`);
          setTimeout(() => window.location.reload(), 800);
        } catch (err: unknown) {
          restore();
          showVoidError(err instanceof Error ? err.message : String(err));
        }
      };
    }

    const modal = document.getElementById('assign-repair-modal');
    const form = document.getElementById('assign-repair-form') as HTMLFormElement | null;
    const assignBtns = document.querySelectorAll<HTMLButtonElement>('.assign-repair-btn');
    const resolveBtns = document.querySelectorAll<HTMLButtonElement>('.repair-resolve-btn');

    if (!modal || !form) return;

    const field = (name: string) => modal.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
    const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    let ticketId = '';
    let editing = false;

    const showError = (message: string | null) => {
      const el = field('error');
      if (el) {
        el.textContent = message ?? '';
        el.classList.toggle('hidden', !message);
      }
    };

    assignBtns.forEach((btn) => {
      btn.onclick = () => {
        const { ticket = '', title = '', reporter = '', name = '', phone = '', visit = '' } = btn.dataset;
        ticketId = ticket;
        editing = btn.dataset.editing === 'true';
        field('who').textContent = `${ticket} · ${title} · ${reporter}`;
        field('submit').textContent = editing ? 'Save visit' : 'Assign & start';
        input('name').value = name;
        input('phone').value = phone;
        input('visitAt').value = visit;
        showError(null);
        window.makaziUi?.showModal('assign-repair-modal');
        setTimeout(() => input('name').focus(), 50);
      };
    });

    modal.querySelectorAll('[data-close]').forEach((el) => {
      (el as HTMLElement).onclick = () => window.makaziUi?.hideModal('assign-repair-modal');
    });

    form.onsubmit = async (event) => {
      event.preventDefault();
      const name = input('name').value.trim();
      const phone = input('phone').value.trim();
      if (name.length < 2) return showError('Enter the name of who is going to fix it.');
      if (!phone) return showError('Enter their mobile number.');
      showError(null);

      const submit = field('submit') as HTMLButtonElement;
      const restoreSubmit = setBusy(submit, 'Saving…');
      try {
        await updateTicket({
          ticketId,
          status: 'in_progress',
          assignee: { name, phone, visitAt: input('visitAt').value },
        });
        window.makaziUi?.hideModal('assign-repair-modal');
        window.makaziUi?.showToast(
          editing ? 'Visit updated' : 'Repair assigned',
          `${ticketId}: ${name} is on it. The tenant can see the details in the app.`,
        );
        setTimeout(() => window.location.reload(), 800);
      } catch (err: unknown) {
        restoreSubmit();
        showError(err instanceof Error ? err.message : String(err));
      }
    };

    resolveBtns.forEach((btn) => {
      btn.onclick = async () => {
        const id = btn.dataset.ticket ?? '';
        const restoreResolve = setBusy(btn, 'Resolving…');
        try {
          await updateTicket({ ticketId: id, status: 'resolved' });
          window.makaziUi?.showToast('Ticket resolved', `${id} moved to Resolved.`);
          setTimeout(() => window.location.reload(), 800);
        } catch (err: unknown) {
          restoreResolve();
          window.makaziUi?.showToast('Error', err instanceof Error ? err.message : String(err));
        }
      };
    });
  }

  document.addEventListener('astro:page-load', initMaintenancePage);
</script>
