---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { getPortfolio, formatDate, formatKes } from '../data/portfolio';
import { paymentMethodLabel } from '../lib/billing';
import { fetchPendingClaims, type PaymentClaim } from '../lib/payment-claims';
import { makeSupabaseClient } from '../lib/supabase';
import { ChevronDown, Plus, X, CreditCard, Check, AlertCircle, Search, MessageSquareText } from '@lucide/astro';

// This company's data only (the signed-in user's).
const companyId = Astro.locals.user!.companyId;
const { payments, portfolioSummary, currentPeriod, activeTenancies } = await getPortfolio(companyId, Astro.cookies);

// Nairobi date & time defaults
const nairobiNow = new Date(Date.now() + 3 * 60 * 60 * 1000).toISOString();
const defaultDate = nairobiNow.slice(0, 10);
const defaultTime = nairobiNow.slice(11, 16);

// Payment messages tenants pasted in the app, waiting for review.
const supabase = makeSupabaseClient(Astro.cookies);
let claims: PaymentClaim[] = [];
let claimsFailed = false;
if (supabase) {
  try {
    claims = await fetchPendingClaims(supabase, companyId);
  } catch (err) {
    console.error('[payments] payment messages not loaded:', err);
    claimsFailed = true;
  }
}
const tenancyById = new Map(activeTenancies.map((t) => [t.tenancy.id, t]));
const nairobiStamp = (iso: string) => {
  const local = new Date(Date.parse(iso) + 3 * 60 * 60 * 1000).toISOString();
  return `${formatDate(local.slice(0, 10))}, ${local.slice(11, 16)}`;
};
---

<DashboardLayout title="Makazi — Payments & Receipts" currentPath="/payments">
  <!-- Header & Actions -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <span class="text-xs font-semibold tracking-wider text-[#69847A] uppercase">
        {portfolioSummary}
      </span>
      <h1 class="text-3xl sm:text-4xl font-normal font-editorial text-[#0D382B] tracking-tight mt-1">
        Payments & receipts
      </h1>
    </div>

    <div class="flex items-center gap-3 self-start md:self-auto">
      <!-- Record Payment Button (Manual Intervention) -->
      <button 
        type="button" 
        id="open-record-payment-btn"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-[#0D382B] text-white hover:bg-[#08221A] text-xs font-semibold shadow-xs transition-colors cursor-pointer"
      >
        <Plus class="w-4 h-4" />
        <span>Record Payment</span>
      </button>

      <!-- Period Selector -->
      <div class="relative inline-block">
        <button 
          type="button" 
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white border border-[#E3E6DF] text-xs font-semibold text-[#0D382B] shadow-xs hover:border-[#0D382B] transition-colors cursor-pointer"
        >
          <span>{currentPeriod}</span>
          <ChevronDown class="w-4 h-4 text-[#69847A]" />
        </button>
      </div>
    </div>
  </div>

  <!-- Payment messages from the tenant app -->
  {supabase && (
    <section id="payment-claims" class="mb-8 bg-white rounded-3xl border border-[#E3E6DF] overflow-hidden shadow-xs">
      <div class="px-4 lg:px-6 py-4 border-b border-[#E3E6DF] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-xl bg-[#0D382B] text-[#C6EE58] flex items-center justify-center shrink-0">
            <MessageSquareText class="w-4 h-4" />
          </div>
          <div>
            <h2 class="text-sm font-semibold text-[#0D382B]">Payment messages to confirm</h2>
            <p class="text-[11px] text-[#69847A] mt-0.5 max-w-2xl">
              Tenants paste the confirmation they got from M-Pesa or the bank. Match the reference and amount on your
              Paybill or bank statement, then confirm to issue a receipt. Nothing counts until you confirm.
            </p>
          </div>
        </div>
        {claims.length > 0 && (
          <span class="self-start sm:self-auto px-2.5 py-1 rounded-full bg-[#FFF8E1] text-[#B78103] text-[11px] font-semibold border border-[#FFE082] whitespace-nowrap">
            {claims.length} waiting
          </span>
        )}
      </div>
      {claimsFailed ? (
        <p class="px-6 py-5 text-xs font-medium text-[#991B1B]">Payment messages couldn't load. Refresh the page to try again.</p>
      ) : claims.length === 0 ? (
        <p class="px-6 py-5 text-xs font-medium text-[#69847A]">No payment messages waiting. New ones appear here as tenants send them from the app.</p>
      ) : (
        <div class="overflow-x-auto relative">
          <table class="w-full text-left text-xs tabular-nums">
            <thead class="bg-[#F8F9F6] border-b border-[#E3E6DF] text-[#69847A] uppercase text-[10px] font-semibold tracking-wider">
              <tr>
                <th scope="col" class="py-3 px-4 lg:px-6">Tenant</th>
                <th scope="col" class="py-3 px-3 lg:px-4">Read from message</th>
                <th scope="col" class="py-3 px-3 lg:px-4">Message</th>
                <th scope="col" class="py-3 px-3 lg:px-4 text-right">Balance</th>
                <th scope="col" class="py-3 px-4 lg:px-6 text-right sticky right-0 bg-[#F8F9F6] z-10">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#E3E6DF]">
              {claims.map((claim) => {
                const view = tenancyById.get(claim.tenancyId);
                const tenantLabel = view ? `${view.tenant.name} · ${view.unit.label} (${view.property.name})` : 'Former tenancy';
                return (
                  <tr class="group hover:bg-[#F8F9F6]/60 transition-colors">
                    <td class="py-3.5 px-4 lg:px-6 align-top">
                      <span class="block font-semibold text-[#0D382B]">{view?.tenant.name ?? 'Former tenancy'}</span>
                      {view && <span class="block text-[11px] text-[#69847A]">{view.unit.label} · Ref {view.accountNumber}</span>}
                      <span class="block text-[11px] text-[#8FA69C] mt-0.5">Sent {nairobiStamp(claim.createdAt)}</span>
                    </td>
                    <td class="py-3.5 px-3 lg:px-4 align-top whitespace-nowrap">
                      {claim.reference ? (
                        <span class="block font-mono font-semibold text-[#0D382B]">{claim.reference}</span>
                      ) : (
                        <span class="block font-semibold text-[#B78103]">No reference found</span>
                      )}
                      <span class="block text-[#0D382B]">{claim.amount !== null ? formatKes(claim.amount) : 'No amount found'}</span>
                      {claim.paidDate && (
                        <span class="block text-[11px] text-[#69847A]">{formatDate(claim.paidDate)}{claim.paidTime ? `, ${claim.paidTime}` : ''}</span>
                      )}
                      {claim.payer && <span class="block text-[11px] text-[#69847A]">From {claim.payer}</span>}
                    </td>
                    <td class="py-3.5 px-3 lg:px-4 align-top max-w-[320px]">
                      <p class="line-clamp-3 text-[11px] text-[#5A6862] break-words" title={claim.message}>{claim.message}</p>
                    </td>
                    <td class="py-3.5 px-3 lg:px-4 align-top text-right font-semibold text-[#0D382B] whitespace-nowrap">
                      {view ? formatKes(view.balance) : '—'}
                    </td>
                    <td class="py-3.5 px-4 lg:px-6 align-top text-right sticky right-0 bg-white/95 backdrop-blur-xs group-hover:bg-[#F8F9F6] shadow-[-6px_0_12px_-4px_rgba(0,0,0,0.05)] transition-colors">
                      <button
                        type="button"
                        class="review-claim-btn px-3.5 py-1.5 rounded-full bg-[#0D382B] text-white hover:bg-[#08221A] text-xs font-semibold transition-colors cursor-pointer shadow-xs whitespace-nowrap"
                        data-claim-id={claim.id}
                        data-tenant={tenantLabel}
                        data-balance={view ? formatKes(view.balance) : ''}
                        data-message={claim.message}
                        data-reference={claim.reference ?? ''}
                        data-amount={claim.amount ?? ''}
                        data-date={claim.paidDate ?? defaultDate}
                        data-time={claim.paidTime ?? defaultTime}
                      >
                        Review
                      </button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </section>
  )}

  <!-- Filter & Summary Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div class="flex flex-wrap items-center gap-3">
      <!-- Search -->
      <div class="relative min-w-56 sm:min-w-64">
        <Search class="w-4 h-4 text-[#69847A] absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
        <input
          id="payment-search"
          type="search"
          placeholder="Search receipt, tenant, unit, ref…"
          class="w-full pl-10 pr-4 py-2 rounded-full border border-[#E3E6DF] bg-white text-xs text-[#0D382B] placeholder:text-[#8FA69C] focus:outline-hidden focus:border-[#0D382B] transition-colors shadow-xs"
        />
      </div>
      <div class="flex items-center gap-1.5" role="group" aria-label="Payment method">
        {['All', 'M-Pesa', 'Bank'].map((m) => (
          <button type="button" data-method-btn={m}
            class="method-btn px-4 py-2 rounded-full border text-xs font-semibold cursor-pointer transition-colors shadow-xs">
            {m}
          </button>
        ))}
      </div>
    </div>
    <span class="text-xs font-medium text-[#69847A] tabular-nums whitespace-nowrap">
      <span id="payments-count">{payments.length}</span> payments · <span id="payments-total" class="font-semibold text-[#0D382B]">{formatKes(payments.reduce((a, p) => a + p.payment.amount, 0))}</span>
    </span>
  </div>

  <!-- Payments Table -->
  <div id="payments-panel" class="bg-white rounded-3xl border border-[#E3E6DF] overflow-hidden shadow-xs">
    {payments.length === 0 ? (
      <div class="p-12 text-center text-xs font-medium text-[#69847A]">
        No payment transactions recorded.
      </div>
    ) : (
      <>
        <div class="overflow-x-auto relative">
          <table class="w-full text-left text-xs tabular-nums">
            <thead class="bg-[#F8F9F6] border-b border-[#E3E6DF] text-[#69847A] uppercase text-[10px] font-semibold tracking-wider">
              <tr>
                <th scope="col" class="py-3.5 px-4 lg:px-6">Receipt</th>
                <th scope="col" class="py-3.5 px-3 lg:px-4">Tenant</th>
                <th scope="col" class="py-3.5 px-3 lg:px-4">Date</th>
                <th scope="col" class="py-3.5 px-3 lg:px-4">Method · Ref</th>
                <th scope="col" class="py-3.5 px-3 lg:px-4">For</th>
                <th scope="col" class="py-3.5 px-3 lg:px-4 text-right">Amount</th>
                <th scope="col" class="py-3.5 px-4 lg:px-6 text-right sticky right-0 bg-[#F8F9F6] z-10">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#E3E6DF]">
              {payments.map(({ payment, view, forDescription, dateLabel }) => (
                <tr
                  class="payment-tx group hover:bg-[#F8F9F6]/60 transition-colors"
                  data-method={payment.method}
                  data-amount={payment.amount}
                  data-search={`${payment.receiptNumber} ${view.tenant.name} ${view.unit.label} ${payment.reference} ${forDescription}`.toLowerCase()}
                >
                  <td class="py-3.5 px-4 lg:px-6 font-mono font-medium text-[#0D382B] whitespace-nowrap">
                    {payment.receiptNumber}
                  </td>
                  <td class="py-3.5 px-3 lg:px-4">
                    <span class="block font-semibold text-[#0D382B] truncate max-w-[140px] sm:max-w-none">{view.tenant.name}</span>
                    <span class="block text-[11px] text-[#69847A]">{view.unitLabel}</span>
                  </td>
                  <td class="py-3.5 px-3 lg:px-4 text-[#69847A] whitespace-nowrap">
                    {dateLabel}, {payment.time}
                  </td>
                  <td class="py-3.5 px-3 lg:px-4 whitespace-nowrap">
                    <span class="font-semibold text-[#0D382B]">{payment.method}</span>
                    {payment.simulated && (
                      <span class="ml-1 px-1.5 py-0.5 rounded-full text-[10px] font-semibold bg-[#FFF8E1] text-[#B78103] border border-[#FFE082]" title="M-Pesa test mode: no money moved">Test</span>
                    )}
                    <span class="ml-1 text-[#69847A] font-mono text-[11px]">{payment.reference}</span>
                  </td>
                  <td class="py-3.5 px-3 lg:px-4 text-[#69847A] max-w-[200px] truncate" title={forDescription}>{forDescription}</td>
                  <td class="py-3.5 px-3 lg:px-4 font-semibold text-[#0D382B] text-right whitespace-nowrap">
                    {formatKes(payment.amount)}
                  </td>
                  <td class="py-3.5 px-4 lg:px-6 text-right sticky right-0 bg-white/95 backdrop-blur-xs group-hover:bg-[#F8F9F6] shadow-[-6px_0_12px_-4px_rgba(0,0,0,0.05)] transition-colors">
                    <button 
                      type="button"
                      class="payment-row px-3.5 py-1.5 rounded-full border border-[#E3E6DF] hover:border-[#0D382B] text-xs font-semibold text-[#0D382B] bg-[#F8F9F6] hover:bg-white transition-colors cursor-pointer shadow-xs whitespace-nowrap"
                      data-id={payment.receiptNumber}
                      data-tenant={view.tenant.name}
                      data-unit={view.unit.label}
                      data-property={view.property.name}
                      data-method={paymentMethodLabel(payment)}
                      data-amount={payment.amount}
                      data-date={dateLabel}
                      data-time={payment.time}
                      data-ref={payment.reference}
                      data-for={forDescription}
                    >
                      Receipt
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="pagination-bar px-6 py-3.5 border-t border-[#E3E6DF] flex flex-col sm:flex-row items-center justify-between gap-3 bg-[#FAFBF9] text-xs text-[#5A6862]">
          <div class="pagination-info">
            Showing <span class="font-semibold text-[#0D382B] page-start">0</span>–<span class="font-semibold text-[#0D382B] page-end">0</span> of <span class="font-semibold text-[#0D382B] page-total">0</span> payments
          </div>
          <div class="flex items-center gap-1.5 pagination-controls">
            <button type="button" class="prev-page-btn px-3 py-1.5 rounded-xl border border-[#DCE0D7] bg-white text-xs font-semibold text-[#0D382B] hover:bg-[#F4F5F1] disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer transition-colors">
              Previous
            </button>
            <div class="page-pills flex items-center gap-1"></div>
            <button type="button" class="next-page-btn px-3 py-1.5 rounded-xl border border-[#DCE0D7] bg-white text-xs font-semibold text-[#0D382B] hover:bg-[#F4F5F1] disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer transition-colors">
              Next
            </button>
          </div>
        </div>
        <p class="empty-state hidden p-12 text-center text-xs font-medium text-[#69847A]">No payments match this search.</p>
      </>
    )}
  </div>

  <!-- Manual Record Payment Modal -->
  <div id="record-payment-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">
    <div class="bg-white rounded-3xl max-w-lg w-full max-h-[90vh] overflow-y-auto p-6 shadow-2xl border border-[#E3E6DF] space-y-5 animate-in fade-in zoom-in-95 duration-150">
      <div class="flex items-center justify-between pb-3 border-b border-[#E3E6DF]">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-[#0D382B] text-[#C6EE58] flex items-center justify-center">
            <CreditCard class="w-5 h-5" />
          </div>
          <div>
            <h3 class="font-bold text-base text-[#0D382B]">Record Manual Payment</h3>
            <p class="text-xs text-[#5A6862]">Cash, Cheque, Bank Transfer, or Manual M-Pesa</p>
          </div>
        </div>
        <button
          type="button"
          id="close-record-payment-modal-btn"
          class="p-1.5 text-[#5A6862] hover:text-[#0D382B] rounded-lg transition-colors cursor-pointer"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <form id="record-payment-form" class="space-y-4">
        <div id="record-payment-error" class="hidden p-3 rounded-xl bg-red-50 border border-red-200 text-xs text-red-700 flex items-center gap-2">
          <AlertCircle class="w-4 h-4 shrink-0" />
          <span id="record-payment-error-msg"></span>
        </div>

        <div>
          <label for="record-tenancy-select" class="block text-xs font-semibold text-[#0D382B] mb-1">
            Tenant & Unit *
          </label>
          <select
            id="record-tenancy-select"
            required
            class="w-full px-3 py-2 text-xs rounded-xl border border-[#CCD2C7] focus:outline-none focus:border-[#0D382B] bg-white text-[#0D382B]"
          >
            <option value="">Select a tenancy...</option>
            {activeTenancies.map((t) => (
              <option 
                value={t.tenancy.id}
                data-balance={t.balance}
              >
                {t.tenant.name} · Unit {t.unit.label} ({t.property.name}) [Ref: {t.accountNumber}]
              </option>
            ))}
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="record-amount-input" class="block text-xs font-semibold text-[#0D382B] mb-1">
              Amount (KES) *
            </label>
            <input
              type="number"
              id="record-amount-input"
              required
              min="1"
              step="1"
              placeholder="Enter amount paid"
              class="w-full px-3 py-2 text-xs rounded-xl border border-[#CCD2C7] focus:outline-none focus:border-[#0D382B] font-semibold"
            />
            <div id="record-amount-due-container" class="mt-1.5 flex flex-wrap items-center justify-between gap-1 text-[11px] min-h-[18px]">
              <span id="record-amount-due-hint" class="text-[#69847A]">Select a tenancy to view due amount</span>
              <button 
                type="button" 
                id="record-amount-due-fill-btn" 
                class="hidden text-[#0D382B] hover:text-[#08221A] font-bold underline cursor-pointer transition-colors"
              >
                Apply full balance
              </button>
            </div>
          </div>

          <div>
            <label for="record-method-select" class="block text-xs font-semibold text-[#0D382B] mb-1">
              Payment Method *
            </label>
            <select
              id="record-method-select"
              required
              class="w-full px-3 py-2 text-xs rounded-xl border border-[#CCD2C7] focus:outline-none focus:border-[#0D382B] bg-white text-[#0D382B]"
            >
              <option value="M-Pesa">M-Pesa</option>
              <option value="Bank">Bank Transfer / Cheque / Cash</option>
            </select>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="record-ref-input" class="block text-xs font-semibold text-[#0D382B]">
              Transaction Reference *
            </label>
            <span class="text-[10px] text-[#69847A]">M-Pesa code or Slip/Cheque ref</span>
          </div>
          <input
            type="text"
            id="record-ref-input"
            required
            placeholder="QJD92881X or EFT-10293 or CASH-OCT"
            class="w-full px-3 py-2 text-xs rounded-xl border border-[#CCD2C7] focus:outline-none focus:border-[#0D382B] font-mono uppercase"
          />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="record-date-input" class="block text-xs font-semibold text-[#0D382B] mb-1">
              Date
            </label>
            <input
              type="date"
              id="record-date-input"
              value={defaultDate}
              class="w-full px-3 py-2 text-xs rounded-xl border border-[#CCD2C7] focus:outline-none focus:border-[#0D382B]"
            />
          </div>

          <div>
            <label for="record-time-input" class="block text-xs font-semibold text-[#0D382B] mb-1">
              Time
            </label>
            <input
              type="time"
              id="record-time-input"
              value={defaultTime}
              class="w-full px-3 py-2 text-xs rounded-xl border border-[#CCD2C7] focus:outline-none focus:border-[#0D382B]"
            />
          </div>
        </div>

        <div class="p-3 rounded-2xl bg-[#F8F9F6] border border-[#E3E6DF] text-[11px] text-[#5A6862] space-y-1">
          <p class="font-semibold text-[#0D382B]">Immediate Ledger Reconciliation</p>
          <p>
            An official receipt (RCT-YYMM-NNNN) will be automatically generated. The tenant ledger will be credited and real-time in-app confirmation dispatched immediately.
          </p>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            id="cancel-record-payment-btn"
            class="px-4 py-2 text-xs font-semibold text-[#5A6862] hover:text-[#0D382B] transition-colors cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="submit-record-payment-btn"
            class="px-5 py-2.5 text-xs font-bold bg-[#0D382B] text-white hover:bg-[#08221A] rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer"
          >
            <Check class="w-3.5 h-3.5" />
            <span>Record & Issue Receipt</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Review a tenant's payment message -->
  <div id="review-claim-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs" role="dialog" aria-modal="true" aria-labelledby="review-claim-title">
    <div class="bg-white rounded-3xl max-w-lg w-full max-h-[90vh] flex flex-col shadow-2xl border border-[#E3E6DF]">
      <div class="flex items-center justify-between p-6 pb-3 border-b border-[#E3E6DF] shrink-0">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 rounded-2xl bg-[#0D382B] text-[#C6EE58] flex items-center justify-center shrink-0">
            <MessageSquareText class="w-5 h-5" />
          </div>
          <div class="min-w-0">
            <h3 id="review-claim-title" class="font-bold text-base text-[#0D382B]">Confirm payment</h3>
            <p id="review-claim-tenant" class="text-xs text-[#5A6862] truncate"></p>
          </div>
        </div>
        <button type="button" id="close-review-claim-btn" class="p-1.5 text-[#5A6862] hover:text-[#0D382B] rounded-lg transition-colors cursor-pointer" aria-label="Close">
          <X class="w-5 h-5" />
        </button>
      </div>

      <form id="review-claim-form" class="flex-1 min-h-0 overflow-y-auto p-6 space-y-4">
        <div id="review-claim-error" class="hidden p-3 rounded-xl bg-red-50 border border-red-200 text-xs text-red-700 flex items-center gap-2">
          <AlertCircle class="w-4 h-4 shrink-0" />
          <span id="review-claim-error-msg"></span>
        </div>

        <div>
          <p class="text-xs font-semibold text-[#0D382B] mb-1">What the tenant pasted</p>
          <p id="review-claim-message" class="p-3 rounded-2xl bg-[#F8F9F6] border border-[#E3E6DF] text-[11px] text-[#5A6862] whitespace-pre-wrap break-words"></p>
          <p class="mt-1.5 text-[11px] text-[#69847A]">Balance due: <span id="review-claim-balance" class="font-semibold text-[#0D382B]"></span></p>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="review-claim-ref" class="block text-xs font-semibold text-[#0D382B] mb-1">Transaction reference *</label>
            <input type="text" id="review-claim-ref" required minlength="6" maxlength="20" class="w-full px-3 py-2 text-xs rounded-xl border border-[#CCD2C7] focus:outline-none focus:border-[#0D382B] font-mono uppercase" />
          </div>
          <div>
            <label for="review-claim-amount" class="block text-xs font-semibold text-[#0D382B] mb-1">Amount received (KES) *</label>
            <input type="number" id="review-claim-amount" required min="1" step="1" class="w-full px-3 py-2 text-xs rounded-xl border border-[#CCD2C7] focus:outline-none focus:border-[#0D382B] font-semibold" />
          </div>
          <div>
            <label for="review-claim-date" class="block text-xs font-semibold text-[#0D382B] mb-1">Date received *</label>
            <input type="date" id="review-claim-date" required max={defaultDate} class="w-full px-3 py-2 text-xs rounded-xl border border-[#CCD2C7] focus:outline-none focus:border-[#0D382B]" />
          </div>
          <div>
            <label for="review-claim-time" class="block text-xs font-semibold text-[#0D382B] mb-1">Time *</label>
            <input type="time" id="review-claim-time" required class="w-full px-3 py-2 text-xs rounded-xl border border-[#CCD2C7] focus:outline-none focus:border-[#0D382B]" />
          </div>
        </div>

        <div>
          <label for="review-claim-method" class="block text-xs font-semibold text-[#0D382B] mb-1">Received by *</label>
          <select id="review-claim-method" required class="w-full px-3 py-2 text-xs rounded-xl border border-[#CCD2C7] focus:outline-none focus:border-[#0D382B] bg-white text-[#0D382B]">
            <option value="M-Pesa">M-Pesa</option>
            <option value="Bank">Bank</option>
          </select>
        </div>

        <div>
          <label for="review-claim-note" class="block text-xs font-semibold text-[#0D382B] mb-1">Note to the tenant</label>
          <textarea id="review-claim-note" rows="2" maxlength="300" placeholder="Why it can't be confirmed, or a short note" class="w-full px-3 py-2 text-xs rounded-xl border border-[#CCD2C7] focus:outline-none focus:border-[#0D382B]"></textarea>
          <p class="mt-1 text-[11px] text-[#69847A]">Required to reject. The tenant sees it in the app.</p>
        </div>
      </form>

      <div class="flex items-center justify-end gap-2 p-6 pt-4 border-t border-[#E3E6DF] shrink-0">
        <button type="button" id="reject-claim-btn" class="px-4 py-2.5 text-xs font-semibold text-[#991B1B] hover:bg-red-50 rounded-xl transition-colors cursor-pointer">
          Reject & Tell Tenant
        </button>
        <button type="submit" form="review-claim-form" id="confirm-claim-btn" class="px-5 py-2.5 text-xs font-bold bg-[#0D382B] text-white hover:bg-[#08221A] rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer">
          <Check class="w-3.5 h-3.5" />
          <span>Confirm & Issue Receipt</span>
        </button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import { setBusy } from '../lib/busy';
  function initPaymentsPage() {
    const methodBtns = document.querySelectorAll<HTMLElement>('[data-method-btn]');
    const searchInput = document.getElementById('payment-search') as HTMLInputElement | null;
    const countEl = document.getElementById('payments-count');
    const totalEl = document.getElementById('payments-total');
    const panel = document.getElementById('payments-panel');

    const ON = ['bg-[#0D382B]', 'text-white', 'border-[#0D382B]'];
    const OFF = ['bg-white', 'text-[#0D382B]', 'border-[#E3E6DF]'];
    const PAGE_SIZE = 5;
    let method = 'All';
    let query = '';
    let currentPage = 1;

    function render() {
      if (!panel) return;
      let count = 0;
      let total = 0;
      const matchingRows: HTMLElement[] = [];

      panel.querySelectorAll<HTMLElement>('.payment-tx').forEach((row) => {
        const matchesMethod = method === 'All' || row.dataset.method === method;
        const matchesQuery = !query || (row.dataset.search ?? '').includes(query);
        const matches = matchesMethod && matchesQuery;

        if (matches) {
          matchingRows.push(row);
          count++;
          total += Number(row.dataset.amount);
        } else {
          row.classList.add('hidden');
        }
      });

      if (countEl) countEl.textContent = String(count);
      if (totalEl) totalEl.textContent = `KES ${total.toLocaleString('en-KE')}`;

      methodBtns.forEach((b) => {
        const on = b.dataset.methodBtn === method;
        b.classList.remove(...(on ? OFF : ON));
        b.classList.add(...(on ? ON : OFF));
      });

      const totalMatching = matchingRows.length;
      const totalPages = Math.max(1, Math.ceil(totalMatching / PAGE_SIZE));
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      matchingRows.forEach((row, index) => {
        const isVisible = index >= (currentPage - 1) * PAGE_SIZE && index < currentPage * PAGE_SIZE;
        row.classList.toggle('hidden', !isVisible);
      });

      panel.querySelector('.empty-state')?.classList.toggle('hidden', totalMatching > 0);

      const paginationBar = panel.querySelector<HTMLElement>('.pagination-bar');
      if (paginationBar) {
        paginationBar.classList.toggle('hidden', totalMatching === 0);
      }

      const pageStartEl = panel.querySelector<HTMLElement>('.page-start');
      const pageEndEl = panel.querySelector<HTMLElement>('.page-end');
      const pageTotalEl = panel.querySelector<HTMLElement>('.page-total');
      const prevBtn = panel.querySelector<HTMLButtonElement>('.prev-page-btn');
      const nextBtn = panel.querySelector<HTMLButtonElement>('.next-page-btn');
      const pillsContainer = panel.querySelector<HTMLElement>('.page-pills');

      if (pageStartEl) pageStartEl.textContent = totalMatching === 0 ? '0' : String((currentPage - 1) * PAGE_SIZE + 1);
      if (pageEndEl) pageEndEl.textContent = String(Math.min(totalMatching, currentPage * PAGE_SIZE));
      if (pageTotalEl) pageTotalEl.textContent = String(totalMatching);

      if (prevBtn) {
        prevBtn.disabled = currentPage <= 1;
        prevBtn.onclick = () => {
          if (currentPage > 1) {
            currentPage--;
            render();
          }
        };
      }

      if (nextBtn) {
        nextBtn.disabled = currentPage >= totalPages;
        nextBtn.onclick = () => {
          if (currentPage < totalPages) {
            currentPage++;
            render();
          }
        };
      }

      if (pillsContainer) {
        pillsContainer.innerHTML = '';
        if (totalPages > 1) {
          for (let p = 1; p <= totalPages; p++) {
            const pill = document.createElement('button');
            pill.type = 'button';
            pill.textContent = String(p);
            pill.className = `w-7 h-7 rounded-lg text-xs font-semibold flex items-center justify-center transition-colors cursor-pointer ${
              p === currentPage
                ? 'bg-[#0D382B] text-white'
                : 'text-[#5A6862] hover:bg-[#EAECE6] bg-transparent'
            }`;
            pill.onclick = () => {
              currentPage = p;
              render();
            };
            pillsContainer.appendChild(pill);
          }
        }
      }
    }

    methodBtns.forEach((b) => {
      b.onclick = () => {
        method = b.dataset.methodBtn ?? 'All';
        currentPage = 1;
        render();
      };
    });

    if (searchInput) {
      searchInput.oninput = (e) => {
        query = (e.target as HTMLInputElement).value.trim().toLowerCase();
        currentPage = 1;
        render();
      };
    }

    render();

    // Record Payment Modal logic
    const openRecordBtn = document.getElementById('open-record-payment-btn');
    const recordModal = document.getElementById('record-payment-modal');
    const closeRecordBtn = document.getElementById('close-record-payment-modal-btn');
    const cancelRecordBtn = document.getElementById('cancel-record-payment-btn');
    const recordForm = document.getElementById('record-payment-form') as HTMLFormElement | null;
    const submitRecordBtn = document.getElementById('submit-record-payment-btn') as HTMLButtonElement | null;
    const errorBox = document.getElementById('record-payment-error');
    const errorMsg = document.getElementById('record-payment-error-msg');
    const recordTenancySelect = document.getElementById('record-tenancy-select') as HTMLSelectElement | null;
    const recordAmountInput = document.getElementById('record-amount-input') as HTMLInputElement | null;
    const amountDueHint = document.getElementById('record-amount-due-hint');
    const amountDueFillBtn = document.getElementById('record-amount-due-fill-btn') as HTMLButtonElement | null;

    let currentSelectedBalance: number | null = null;

    function updateAmountDue() {
      if (!recordTenancySelect || !amountDueHint || !amountDueFillBtn) return;
      const selectedOption = recordTenancySelect.selectedOptions[0];
      if (!selectedOption || !selectedOption.value) {
        currentSelectedBalance = null;
        amountDueHint.className = 'text-[#69847A]';
        amountDueHint.textContent = 'Select a tenancy to view due amount';
        amountDueFillBtn.classList.add('hidden');
        return;
      }

      const balStr = selectedOption.dataset.balance;
      const balance = balStr !== undefined ? Number(balStr) : 0;
      currentSelectedBalance = balance;

      if (balance > 0) {
        amountDueHint.className = 'text-[#854D0E] font-medium';
        amountDueHint.innerHTML = `Amount due: <strong class="text-[#0D382B] font-bold">KES ${balance.toLocaleString('en-KE')}</strong>`;
        amountDueFillBtn.classList.remove('hidden');
        amountDueFillBtn.textContent = 'Apply full balance';
      } else if (balance === 0) {
        amountDueHint.className = 'text-[#2F6B4F] font-semibold';
        amountDueHint.textContent = 'Account settled (KES 0 due)';
        amountDueFillBtn.classList.add('hidden');
      } else {
        const credit = Math.abs(balance);
        amountDueHint.className = 'text-[#2F6B4F] font-semibold';
        amountDueHint.textContent = `Credit balance: KES ${credit.toLocaleString('en-KE')}`;
        amountDueFillBtn.classList.add('hidden');
      }
    }

    if (recordTenancySelect) {
      recordTenancySelect.onchange = () => {
        updateAmountDue();
      };
    }

    if (amountDueFillBtn && recordAmountInput) {
      amountDueFillBtn.onclick = () => {
        if (currentSelectedBalance !== null && currentSelectedBalance > 0) {
          recordAmountInput.value = String(currentSelectedBalance);
          recordAmountInput.dispatchEvent(new Event('input', { bubbles: true }));
          recordAmountInput.focus();
        }
      };
    }

    function openRecordModal() {
      if (recordModal) {
        recordModal.classList.remove('hidden');
        if (errorBox) errorBox.classList.add('hidden');
        updateAmountDue();
      }
    }

    function closeRecordModal() {
      if (recordModal) recordModal.classList.add('hidden');
    }

    if (openRecordBtn) openRecordBtn.onclick = openRecordModal;
    if (closeRecordBtn) closeRecordBtn.onclick = closeRecordModal;
    if (cancelRecordBtn) cancelRecordBtn.onclick = closeRecordModal;

    if (recordForm) {
      recordForm.onsubmit = async (e) => {
        e.preventDefault();
        const tenancyId = (document.getElementById('record-tenancy-select') as HTMLSelectElement).value;
        const amount = Number((document.getElementById('record-amount-input') as HTMLInputElement).value);
        const methodVal = (document.getElementById('record-method-select') as HTMLSelectElement).value;
        const reference = (document.getElementById('record-ref-input') as HTMLInputElement).value.trim();
        const date = (document.getElementById('record-date-input') as HTMLInputElement).value;
        const time = (document.getElementById('record-time-input') as HTMLInputElement).value;

        if (!tenancyId || !amount || !reference) {
          if (errorBox && errorMsg) {
            errorMsg.textContent = 'Please select a tenancy and enter both amount and reference.';
            errorBox.classList.remove('hidden');
          }
          return;
        }

        const restoreRecord = setBusy(submitRecordBtn, 'Recording…');

        try {
          const res = await fetch('/api/record-payment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              tenancyId,
              amount,
              method: methodVal,
              reference,
              date,
              time,
            }),
          });

          const data = await res.json();
          if (!res.ok || data.error) {
            throw new Error(data.error || 'Failed to record payment');
          }

          // Success! Show toast and reload page to reflect new ledger state
          closeRecordModal();
          window.location.reload();
        } catch (err: unknown) {
          if (errorBox && errorMsg) {
            errorMsg.textContent = err instanceof Error ? err.message : 'Error recording payment';
            errorBox.classList.remove('hidden');
          }
        } finally {
          restoreRecord();
        }
      };
    }

    // Review a tenant's payment message
    const reviewModal = document.getElementById('review-claim-modal');
    const reviewForm = document.getElementById('review-claim-form') as HTMLFormElement | null;
    const reviewErrorBox = document.getElementById('review-claim-error');
    const reviewErrorMsg = document.getElementById('review-claim-error-msg');
    const confirmClaimBtn = document.getElementById('confirm-claim-btn') as HTMLButtonElement | null;
    const rejectClaimBtn = document.getElementById('reject-claim-btn') as HTMLButtonElement | null;
    const reviewInput = (id: string) => document.getElementById(id) as HTMLInputElement;
    let reviewClaimId = '';

    function showReviewError(message: string) {
      if (reviewErrorMsg) reviewErrorMsg.textContent = message;
      reviewErrorBox?.classList.remove('hidden');
    }

    function closeReviewModal() {
      reviewModal?.classList.add('hidden');
    }

    document.querySelectorAll<HTMLButtonElement>('.review-claim-btn').forEach((btn) => {
      btn.onclick = () => {
        reviewClaimId = btn.dataset.claimId ?? '';
        const setText = (id: string, text: string) => {
          const el = document.getElementById(id);
          if (el) el.textContent = text;
        };
        setText('review-claim-tenant', btn.dataset.tenant ?? '');
        setText('review-claim-message', btn.dataset.message ?? '');
        setText('review-claim-balance', btn.dataset.balance || '—');
        reviewInput('review-claim-ref').value = btn.dataset.reference ?? '';
        reviewInput('review-claim-amount').value = btn.dataset.amount ?? '';
        reviewInput('review-claim-date').value = btn.dataset.date ?? '';
        reviewInput('review-claim-time').value = btn.dataset.time ?? '';
        reviewInput('review-claim-method').value = 'M-Pesa';
        reviewInput('review-claim-note').value = '';
        reviewErrorBox?.classList.add('hidden');
        reviewModal?.classList.remove('hidden');
      };
    });

    async function submitReview(action: 'confirm' | 'reject', button: HTMLButtonElement | null) {
      const restore = setBusy(button, action === 'confirm' ? 'Confirming…' : 'Rejecting…');
      try {
        const res = await fetch('/api/review-claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            claimId: reviewClaimId,
            action,
            reference: reviewInput('review-claim-ref').value.trim(),
            amount: reviewInput('review-claim-amount').value,
            date: reviewInput('review-claim-date').value,
            time: reviewInput('review-claim-time').value,
            method: reviewInput('review-claim-method').value,
            note: reviewInput('review-claim-note').value.trim(),
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Could not review the payment message. Try again.');
        closeReviewModal();
        window.location.reload();
      } catch (err: unknown) {
        showReviewError(err instanceof Error ? err.message : 'Could not review the payment message. Try again.');
      } finally {
        restore();
      }
    }

    if (reviewForm) {
      reviewForm.onsubmit = (e) => {
        e.preventDefault();
        void submitReview('confirm', confirmClaimBtn);
      };
    }
    if (rejectClaimBtn) {
      rejectClaimBtn.onclick = () => {
        const note = reviewInput('review-claim-note');
        if (!note.value.trim()) {
          showReviewError('Write the reason for the tenant, then reject.');
          note.focus();
          return;
        }
        void submitReview('reject', rejectClaimBtn);
      };
    }
    const closeReviewBtn = document.getElementById('close-review-claim-btn');
    if (closeReviewBtn) closeReviewBtn.onclick = closeReviewModal;
  }

  document.addEventListener('astro:page-load', initPaymentsPage);
</script>
